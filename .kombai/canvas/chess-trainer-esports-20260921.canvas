      },
      "html": "<style>\n    :root {\n    --bg-obsidian: #0B0C10;\n    --surface: #111720;\n    --surface-slate: #1F2833;\n    --surface-soft: #151d27;\n    --line: rgba(255,255,255,.11);\n    --line-cyan: rgba(102,252,241,.28);\n    --ink: #F7FBFF;\n    --muted: #9BA8B8;\n    --muted-dim: #667385;\n    --accent-cyan: #66FCF1;\n    --accent-purple: #8A2BE2;\n    --tier-bronze: #C2793A;\n    --tier-silver: #B6C2D1;\n    --tier-gold: #EAB308;\n    --quality-brilliant: #4DA3FF;\n    --quality-best: #53F28A;\n    --quality-inaccuracy: #FF9A3D;\n    --quality-blunder: #FF4565;\n    --motion-tab-duration: 260ms;\n    --motion-hover-duration: 300ms;\n    --motion-panel-ease: cubic-bezier(.22, 1, .36, 1);\n    --piece-glow: 0 0 15px rgba(102,252,241,.6);\n  }\n\n  .learn-page,\n  .learn-page * { box-sizing: border-box; }\n\n  .learn-page {\n    min-height: 100vh;\n    overflow-x: clip;\n    overflow-y: visible;\n    color: var(--ink);\n    background:\n      radial-gradient(circle at 82% 5%, rgba(138,43,226,.12), transparent 24rem),\n      radial-gradient(circle at 7% 36%, rgba(102,252,241,.055), transparent 22rem),\n      var(--bg-obsidian);\n    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    letter-spacing: -.01em;\n    position: relative;\n  }\n\n  .learn-page::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .22;\n    background-image: linear-gradient(rgba(255,255,255,.024) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.024) 1px, transparent 1px);\n    background-size: 48px 48px;\n    mask-image: linear-gradient(to bottom, black, transparent 72%);\n  }\n\n  .ambient-line { position: absolute; height: 1px; background: linear-gradient(90deg, transparent, rgba(102,252,241,.42), transparent); opacity: .55; pointer-events: none; }\n  .ambient-line.one { width: 31vw; top: 154px; right: 1vw; transform: rotate(-14deg); }\n  .ambient-line.two { width: 20vw; top: 520px; left: -3vw; transform: rotate(26deg); opacity: .22; }\n  .spark { position: absolute; width: 5px; height: 5px; background: var(--accent-cyan); transform: rotate(45deg); box-shadow: 0 0 12px rgba(102,252,241,.8); pointer-events: none; }\n  .spark.purple { background: var(--accent-purple); box-shadow: 0 0 13px rgba(138,43,226,.75); }\n  .spark.s1 { top: 128px; right: 14%; }\n  .spark.s2 { top: 342px; right: 6%; width: 3px; height: 3px; }\n  .spark.s3 { top: 726px; left: 7%; width: 4px; height: 4px; }\n  .spark.s4 { top: 1018px; right: 16%; width: 4px; height: 4px; }\n  .spark.s5 { top: 236px; left: 4%; width: 3px; height: 3px; }\n  .page-inner { width: min(1360px, calc(100% - 64px)); margin: 0 auto; position: relative; z-index: 1; }\n\n  .topbar {\n    min-height: 76px;\n    display: grid;\n    grid-template-columns: 230px minmax(0, 1fr) 190px;\n    align-items: center;\n    gap: 16px;\n    border-bottom: 1px solid rgba(255,255,255,.09);\n  }\n  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }\n  .brand-mark { width: 31px; height: 31px; display: grid; place-items: center; color: var(--bg-obsidian); background: var(--accent-cyan); font-size: 18px; font-weight: 900; clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 100%, 0 100%); box-shadow: 0 0 20px rgba(102,252,241,.24); }\n  .brand-copy { line-height: 1; min-width: 0; }\n  .brand-name { font-size: 13px; letter-spacing: .16em; font-weight: 850; text-transform: uppercase; white-space: nowrap; }\n  .brand-sub { color: var(--muted); font-size: 9px; letter-spacing: .18em; text-transform: uppercase; margin-top: 5px; white-space: nowrap; }\n\n  .primary-nav {\n    align-self: stretch;\n    display: grid;\n    grid-template-columns: repeat(5, minmax(116px, 1fr));\n    justify-self: center;\n    width: min(790px, 100%);\n    min-width: 0;\n  }\n  .nav-link {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-width: 0;\n    color: var(--muted);\n    text-decoration: none;\n    font-size: 11px;\n    font-weight: 760;\n    white-space: nowrap;\n    transition: all .3s ease-in-out;\n  }\n  .nav-link:hover,\n  .nav-link:focus-visible { color: var(--ink); outline: none; }\n  .nav-link:hover .nav-icon,\n  .nav-link:focus-visible .nav-icon { color: var(--accent-cyan); box-shadow: 0 0 12px rgba(102,252,241,.62); transform: translateY(-1px); }\n  .nav-link.active { color: var(--accent-cyan); }\n  .nav-link.active::after {\n    content: \"\";\n    position: absolute;\n    left: 15%;\n    right: 15%;\n    bottom: -1px;\n    height: 2px;\n    background: var(--accent-cyan);\n    box-shadow: 0 0 13px rgba(102,252,241,.9);\n    transform-origin: center;\n    animation: rail-in var(--motion-tab-duration) var(--motion-panel-ease) both;\n  }\n  .nav-icon {\n    width: 22px;\n    height: 22px;\n    display: grid;\n    place-items: center;\n    flex: 0 0 22px;\n    border: 1px solid currentColor;\n    color: var(--muted-dim);\n    font-size: 13px;\n    line-height: 1;\n    transition: all .3s ease-in-out;\n  }\n  .nav-label { overflow: hidden; text-overflow: ellipsis; }\n  .nav-index { color: var(--muted-dim); font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; margin-right: 1px; }\n  @keyframes rail-in { from { transform: scaleX(.25); opacity: .2; } to { transform: scaleX(1); opacity: 1; } }\n\n  .top-status { display: flex; align-items: center; gap: 12px; min-width: 0; justify-content: flex-end; }\n  .season { font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }\n  .profile-level { border-left: 1px solid rgba(255,255,255,.14); padding-left: 12px; display: flex; align-items: center; gap: 8px; }\n  .level-chip { color: var(--accent-cyan); font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace; white-space: nowrap; }\n  .mini-xp { width: 54px; height: 4px; background: #2a3542; overflow: hidden; }\n  .mini-xp span { display: block; height: 100%; width: 68%; background: var(--accent-purple); box-shadow: 0 0 9px rgba(138,43,226,.7); }\n\n  .intro { display: flex; align-items: end; justify-content: space-between; padding: 54px 0 26px; gap: 30px; }\n  .eyebrow { color: var(--accent-cyan); font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 14px; }\n  h1 { font-size: clamp(36px, 4.2vw, 58px); line-height: .96; margin: 0; letter-spacing: -.06em; font-weight: 850; }\n  .intro p { max-width: 560px; color: var(--muted); margin: 14px 0 0; font-size: 14px; line-height: 1.55; }\n  .quality-legend { display: flex; align-items: center; gap: 15px; border-left: 1px solid rgba(102,252,241,.3); padding-left: 18px; padding-bottom: 4px; white-space: nowrap; }\n  .legend-label { font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted-dim); text-transform: uppercase; letter-spacing: .15em; }\n  .quality-item { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); }\n  .quality-mark { font: 800 15px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .quality-mark.brilliant { color: var(--quality-brilliant); text-shadow: 0 0 9px rgba(77,163,255,.7); }\n  .quality-mark.best { color: var(--quality-best); text-shadow: 0 0 9px rgba(83,242,138,.65); }\n  .quality-mark.inaccuracy { color: var(--quality-inaccuracy); text-shadow: 0 0 9px rgba(255,154,61,.55); }\n  .quality-mark.blunder { color: var(--quality-blunder); text-shadow: 0 0 9px rgba(255,69,101,.6); }\n\n  .top-grid { display: grid; grid-template-columns: minmax(300px, 4fr) minmax(0, 8fr); gap: 18px; align-items: stretch; }\n  .panel { background: rgba(17,23,32,.94); border: 1px solid rgba(255,255,255,.1); position: relative; }\n  .panel::before { content: \"\"; position: absolute; width: 9px; height: 9px; top: -1px; left: -1px; border-top: 2px solid var(--accent-cyan); border-left: 2px solid var(--accent-cyan); opacity: .8; }\n  .panel::after { content: \"\"; position: absolute; width: 9px; height: 9px; bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent-purple); border-right: 2px solid var(--accent-purple); opacity: .8; }\n  .dial-panel { min-height: 292px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }\n  .panel-kicker { align-self: stretch; color: var(--muted-dim); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; }\n  .dial-wrap { position: relative; width: 192px; height: 192px; margin: 11px 0 15px; }\n  .dial-wrap::before, .dial-wrap::after { content: \"\"; position: absolute; width: 5px; height: 5px; transform: rotate(45deg); background: var(--accent-cyan); box-shadow: 0 0 12px rgba(102,252,241,.8); }\n  .dial-wrap::before { top: 7px; right: 28px; }\n  .dial-wrap::after { bottom: 15px; left: 11px; background: var(--accent-purple); box-shadow: 0 0 12px rgba(138,43,226,.8); }\n  .dial { width: 100%; height: 100%; transform: rotate(-90deg); }\n  .dial-track { fill: none; stroke: #293542; stroke-width: 8; }\n  .dial-progress { fill: none; stroke: var(--accent-cyan); stroke-width: 8; stroke-linecap: square; stroke-dasharray: 477; stroke-dashoffset: 181; filter: drop-shadow(0 0 7px rgba(102,252,241,.65)); }\n  .dial-hairline { fill: none; stroke: var(--accent-purple); stroke-width: 1; stroke-dasharray: 2 9; opacity: .75; }\n  .dial-center { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; text-align: center; }\n  .dial-level { color: var(--ink); font-size: 42px; font-weight: 850; line-height: .9; letter-spacing: -.08em; }\n  .dial-caption { color: var(--muted); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .13em; text-transform: uppercase; margin-top: 8px; }\n  .dial-xp { color: var(--accent-cyan); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; margin-top: 5px; }\n  .threshold { color: var(--muted); font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .threshold strong { color: var(--ink); font-weight: 650; }\n\n  .active-lesson { min-height: 292px; padding: 25px 27px 23px; display: flex; flex-direction: column; }\n  .lesson-topline { display: flex; align-items: center; justify-content: space-between; gap: 14px; color: var(--muted-dim); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .13em; text-transform: uppercase; }\n  .lesson-status { display: inline-flex; align-items: center; gap: 7px; color: var(--accent-cyan); }\n  .status-dot { width: 6px; height: 6px; background: var(--accent-cyan); box-shadow: 0 0 10px rgba(102,252,241,.85); transform: rotate(45deg); }\n  .tier-label { color: var(--tier-bronze); font-size: 10px; letter-spacing: .12em; }\n  .active-lesson h2 { font-size: clamp(24px, 2.5vw, 35px); line-height: 1.02; max-width: 610px; margin: 22px 0 9px; letter-spacing: -.045em; }\n  .active-lesson .summary { color: var(--muted); font-size: 13px; line-height: 1.55; max-width: 560px; margin: 0; }\n  .coach-note { display: flex; align-items: flex-start; gap: 10px; margin-top: 17px; padding: 10px 12px; border-left: 2px solid var(--quality-brilliant); background: rgba(77,163,255,.06); color: var(--muted); font-size: 11px; line-height: 1.45; }\n  .coach-note strong { color: var(--quality-brilliant); font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; white-space: nowrap; }\n  .lesson-metrics { margin-top: auto; padding-top: 20px; display: flex; align-items: end; justify-content: space-between; gap: 22px; }\n  .progress-block { flex: 1; min-width: 160px; }\n  .metric-line { display: flex; justify-content: space-between; color: var(--muted); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .04em; margin-bottom: 8px; }\n  .metric-line strong { color: var(--ink); font-weight: 650; }\n  .progress-track { height: 5px; background: #2a3542; position: relative; overflow: hidden; }\n  .progress-track span { display: block; height: 100%; width: 66%; background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple)); box-shadow: 0 0 12px rgba(102,252,241,.45); }\n  .reward { border-left: 1px solid rgba(255,255,255,.15); padding-left: 20px; min-width: 126px; }\n  .reward small { display: block; color: var(--muted-dim); font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }\n  .reward strong { display: block; color: var(--accent-cyan); font: 850 22px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: -.06em; margin-top: 4px; }\n  .lesson-actions { display: flex; align-items: center; gap: 16px; margin-top: 22px; }\n  .primary-action { appearance: none; border: 1px solid var(--accent-cyan); color: var(--bg-obsidian); background: var(--accent-cyan); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; min-height: 38px; padding: 0 17px; clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px)); transition: all .3s ease-in-out; }\n  .primary-action:hover, .primary-action:focus-visible { color: var(--bg-obsidian); box-shadow: var(--piece-glow); transform: translateY(-1px); outline: none; }\n  .secondary-action { color: var(--muted); text-decoration: none; font-size: 11px; border-bottom: 1px solid transparent; padding-bottom: 3px; transition: all .3s ease-in-out; }\n  .secondary-action:hover, .secondary-action:focus-visible { color: var(--ink); border-bottom-color: var(--accent-cyan); outline: none; }\n  .level-up { margin-top: 17px; display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 11px; }\n  .level-up b { color: var(--accent-purple); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .level-up-line { height: 1px; width: 45px; background: linear-gradient(90deg, var(--accent-purple), transparent); }\n\n  .path-section { margin-top: 48px; padding-bottom: 76px; }\n  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,.1); }\n  .section-heading h3 { margin: 0; font-size: 19px; letter-spacing: -.03em; }\n  .section-heading p { margin: 0; color: var(--muted); font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .path { position: relative; padding: 29px 0 0 72px; }\n  .path::before { content: \"\"; position: absolute; left: 25px; top: 30px; bottom: 32px; width: 1px; background: linear-gradient(var(--accent-cyan), rgba(102,252,241,.2) 35%, rgba(138,43,226,.42) 78%, rgba(138,43,226,.06)); }\n  .tier { position: relative; margin-bottom: 39px; }\n  .tier:last-child { margin-bottom: 0; }\n  .tier-node { position: absolute; left: -58px; top: 3px; width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid currentColor; background: var(--bg-obsidian); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; transform: rotate(45deg); }\n  .tier-node span { transform: rotate(-45deg); }\n  .tier.bronze { color: var(--tier-bronze); }\n  .tier.silver { color: var(--tier-silver); }\n  .tier.gold { color: var(--tier-gold); }\n  .tier-head { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; margin-bottom: 14px; }\n  .tier-title { display: flex; align-items: baseline; gap: 12px; }\n  .tier-title h4 { margin: 0; font-size: 14px; color: currentColor; text-transform: uppercase; letter-spacing: .14em; }\n  .tier-title span { color: var(--muted-dim); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .1em; }\n  .tier-progress { color: var(--muted); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .tickets { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px; }\n  .lesson-ticket { appearance: none; border: 1px solid rgba(255,255,255,.11); background: var(--surface); color: var(--ink); text-align: left; min-height: 86px; padding: 15px 17px 13px; position: relative; cursor: pointer; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%); transition: all .3s ease-in-out; }\n  .lesson-ticket::before { content: \"\"; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: currentColor; opacity: .7; }\n  .lesson-ticket:hover, .lesson-ticket:focus-visible { border-color: var(--accent-cyan); box-shadow: var(--piece-glow); transform: translateY(-1px); outline: none; }\n  .lesson-ticket.completed { width: min(29%, 280px); color: var(--quality-best); }\n  .lesson-ticket.current { width: min(39%, 370px); color: var(--accent-cyan); background: linear-gradient(135deg, rgba(102,252,241,.1), var(--surface) 42%); box-shadow: inset 0 0 0 1px rgba(102,252,241,.14); }\n  .lesson-ticket.upcoming { width: min(31%, 300px); color: var(--muted); }\n  .lesson-ticket.locked { width: min(31%, 300px); color: var(--muted-dim); background: rgba(17,23,32,.6); cursor: not-allowed; }\n  .lesson-ticket.locked:hover { transform: none; box-shadow: none; border-color: rgba(255,255,255,.11); }\n  .ticket-state { display: flex; align-items: center; justify-content: space-between; gap: 8px; font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .11em; color: currentColor; }\n  .ticket-state em { color: var(--muted-dim); font-style: normal; }\n  .ticket-title { display: block; color: var(--ink); font-size: 13px; line-height: 1.2; margin: 9px 0 12px; max-width: 220px; }\n  .ticket-footer { display: flex; justify-content: space-between; gap: 8px; color: var(--muted); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .ticket-footer strong { color: currentColor; font-weight: 700; }\n  .quality-activity { margin-top: 31px; border-top: 1px solid rgba(255,255,255,.1); padding-top: 18px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }\n  .activity-label { color: var(--muted-dim); font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; }\n  .activity-items { display: flex; align-items: center; gap: 21px; flex-wrap: wrap; }\n  .activity-item { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted); }\n  .activity-item .move { color: var(--ink); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .activity-item .mark { font: 850 14px ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .activity-item.brilliant .mark { color: var(--quality-brilliant); }\n  .activity-item.best .mark { color: var(--quality-best); }\n  .activity-item.inaccuracy .mark { color: var(--quality-inaccuracy); }\n  .activity-item.blunder .mark { color: var(--quality-blunder); }\n\n  @media (max-width: 1120px) {\n    .page-inner { width: min(100% - 36px, 980px); }\n    .topbar { grid-template-columns: 190px minmax(0, 1fr) 125px; }\n    .primary-nav { grid-template-columns: repeat(5, minmax(92px, 1fr)); }\n    .nav-link { font-size: 10px; gap: 5px; }\n    .nav-icon { width: 19px; height: 19px; flex-basis: 19px; font-size: 11px; }\n    .season { display: none; }\n  }\n\n  @media (max-width: 860px) {\n    .page-inner { width: min(100% - 36px, 760px); }\n    .topbar { display: grid; grid-template-columns: 1fr auto; padding: 12px 0 0; }\n    .primary-nav { grid-column: 1 / -1; grid-row: 2; justify-self: stretch; width: 100%; overflow-x: auto; scrollbar-width: none; min-height: 56px; }\n    .primary-nav::-webkit-scrollbar { display: none; }\n    .nav-link { min-width: 148px; }\n    .intro { display: block; padding-top: 40px; }\n    .quality-legend { margin-top: 22px; width: fit-content; }\n    .top-grid { grid-template-columns: 1fr; }\n    .active-lesson { grid-row: 1; }\n    .dial-panel { grid-row: 2; min-height: 260px; }\n    .path { padding-left: 55px; }\n    .lesson-ticket.completed, .lesson-ticket.current, .lesson-ticket.upcoming, .lesson-ticket.locked { width: calc(50% - 6px); }\n  }\n\n  @media (max-width: 620px) {\n    .page-inner { width: min(100% - 24px, 520px); }\n    .topbar { min-height: 0; }\n    .brand-sub { display: none; }\n    .top-status { min-width: auto; }\n    .profile-level { padding-left: 11px; }\n    .mini-xp { width: 40px; }\n    .nav-link { min-width: 138px; justify-content: flex-start; padding-left: 10px; }\n    .nav-index { display: none; }\n    .intro { padding: 35px 0 22px; }\n    h1 { font-size: 43px; }\n    .intro p { font-size: 13px; }\n    .quality-legend { align-items: flex-start; flex-direction: column; gap: 9px; border-left: 0; border-top: 1px solid rgba(102,252,241,.3); padding: 14px 0 0; width: 100%; }\n    .quality-item { margin-right: 15px; }\n    .active-lesson { padding: 21px 19px 20px; }\n    .active-lesson h2 { font-size: 28px; margin-top: 17px; }\n    .coach-note { display: block; }\n    .coach-note strong { display: block; margin-bottom: 5px; }\n    .lesson-metrics { align-items: stretch; flex-direction: column; gap: 16px; }\n    .reward { border-left: 0; border-top: 1px solid rgba(255,255,255,.15); padding: 13px 0 0; }\n    .lesson-actions { align-items: stretch; flex-direction: column; gap: 13px; }\n    .primary-action { width: 100%; }\n    .secondary-action { align-self: center; }\n    .path-section { margin-top: 37px; }\n    .section-heading { align-items: flex-start; flex-direction: column; gap: 7px; }\n    .path { padding: 23px 0 0 35px; }\n    .path::before { left: 13px; top: 24px; }\n    .tier-node { left: -31px; width: 23px; height: 23px; font-size: 9px; }\n    .tickets { display: block; }\n    .lesson-ticket.completed, .lesson-ticket.current, .lesson-ticket.upcoming, .lesson-ticket.locked { width: 100%; margin-bottom: 10px; }\n    .lesson-ticket:last-child { margin-bottom: 0; }\n    .quality-activity { align-items: flex-start; flex-direction: column; gap: 14px; }\n    .activity-items { gap: 12px 18px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .nav-link.active::after { animation: none; }\n    .nav-link, .nav-icon, .primary-action, .secondary-action, .lesson-ticket { transition: none; }\n  }\n</style>\n<div class=\"learn-page\" data-kid=\"1\">\n    <div aria-hidden=\"true\" class=\"ambient-line one\" data-kid=\"1-1\" data-name=\"ambient background line one\">\n    </div>\n    <div aria-hidden=\"true\" class=\"ambient-line two\" data-kid=\"1-2\" data-name=\"ambient background line two\">\n    </div>\n    <span aria-hidden=\"true\" class=\"spark s1\" data-kid=\"1-3\" data-name=\"floating decorative spark one\">\n    </span>\n    <span aria-hidden=\"true\" class=\"spark purple s2\" data-kid=\"1-4\" data-name=\"floating decorative spark two\">\n    </span>\n    <span aria-hidden=\"true\" class=\"spark s3\" data-kid=\"1-5\" data-name=\"floating decorative spark three\">\n    </span>\n    <span aria-hidden=\"true\" class=\"spark purple s4\" data-kid=\"1-6\" data-name=\"floating decorative spark four\">\n    </span>\n    <span aria-hidden=\"true\" class=\"spark s5\" data-kid=\"1-7\" data-name=\"floating decorative spark five\">\n    </span>\n    <div class=\"page-inner\" data-kid=\"1-8\">\n        <header aria-label=\"Navigation principale\" class=\"topbar\" data-kid=\"1-8-1\">\n            <div class=\"brand\" data-kid=\"1-8-1-1\">\n                <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-8-1-1-1\">\n                    ♞\n                </div>\n                <div class=\"brand-copy\" data-kid=\"1-8-1-1-2\">\n                    <div class=\"brand-name\" data-kid=\"1-8-1-1-2-1\">\n                        Chess Trainer\n                    </div>\n                    <div class=\"brand-sub\" data-kid=\"1-8-1-1-2-2\" data-name=\"brand subheader text\">\n                        E-sports academy / session 04\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"Navigation principale\" class=\"primary-nav\" data-kid=\"1-8-1-2\" data-name=\"primary navigation bar\" id=\"primary-nav\">\n                <a aria-label=\"Jouer contre des Bots\" class=\"nav-link\" data-kid=\"1-8-1-2-1\" data-name=\"navigation link for bots\" data-tab=\"bots\" href=\"#bots\">\n                    <span aria-hidden=\"true\" class=\"nav-icon\" data-kid=\"1-8-1-2-1-1\" data-name=\"bots navigation icon\">\n                        ♟\n                    </span>\n                    <span class=\"nav-index\" data-kid=\"1-8-1-2-1-2\" data-name=\"bots navigation index\">\n                        01\n                    </span>\n                    <span class=\"nav-label\" data-kid=\"1-8-1-2-1-3\" data-name=\"bots navigation label\">\n                        Jouer contre des Bots\n                    </span>\n                </a>\n                <a aria-label=\"Rapport\" class=\"nav-link\" data-kid=\"1-8-1-2-2\" data-name=\"navigation link for rapport\" data-tab=\"rapport\" href=\"#rapport\">\n                    <span aria-hidden=\"true\" class=\"nav-icon\" data-kid=\"1-8-1-2-2-1\" data-name=\"rapport navigation icon\">\n                        ◒\n                    </span>\n                    <span class=\"nav-index\" data-kid=\"1-8-1-2-2-2\" data-name=\"rapport navigation index\">\n                        02\n                    </span>\n                    <span class=\"nav-label\" data-kid=\"1-8-1-2-2-3\" data-name=\"rapport navigation label\">\n                        Rapport\n                    </span>\n                </a>\n                <a aria-label=\"Entraîner\" class=\"nav-link\" data-kid=\"1-8-1-2-3\" data-name=\"navigation link for entrainer\" data-tab=\"entrainer\" href=\"#entrainer\">\n                    <span aria-hidden=\"true\" class=\"nav-icon\" data-kid=\"1-8-1-2-3-1\" data-name=\"entrainer navigation icon\">\n                        ✦\n                    </span>\n                    <span class=\"nav-index\" data-kid=\"1-8-1-2-3-2\" data-name=\"entrainer navigation index\">\n                        03\n                    </span>\n                    <span class=\"nav-label\" data-kid=\"1-8-1-2-3-3\" data-name=\"entrainer navigation label\">\n                        Entraîner\n                    </span>\n                </a>\n                <a aria-current=\"page\" aria-label=\"Apprendre\" class=\"nav-link active\" data-kid=\"1-8-1-2-4\" data-name=\"navigation link for apprendre\" data-tab=\"apprendre\" href=\"#apprendre\">\n                    <span aria-hidden=\"true\" class=\"nav-icon\" data-kid=\"1-8-1-2-4-1\" data-name=\"apprendre navigation icon\">\n                        ◎\n                    </span>\n                    <span class=\"nav-index\" data-kid=\"1-8-1-2-4-2\" data-name=\"apprendre navigation index\">\n                        04\n                    </span>\n                    <span class=\"nav-label\" data-kid=\"1-8-1-2-4-3\" data-name=\"apprendre navigation label\">\n                        Apprendre\n                    </span>\n                </a>\n                <a aria-label=\"Ouvertures\" class=\"nav-link\" data-kid=\"1-8-1-2-5\" data-name=\"navigation link for ouvertures\" data-tab=\"ouvertures\" href=\"#ouvertures\">\n                    <span aria-hidden=\"true\" class=\"nav-icon\" data-kid=\"1-8-1-2-5-1\" data-name=\"ouvertures navigation icon\">\n                        ⌁\n                    </span>\n                    <span class=\"nav-index\" data-kid=\"1-8-1-2-5-2\" data-name=\"ouvertures navigation index\">\n                        05\n                    </span>\n                    <span class=\"nav-label\" data-kid=\"1-8-1-2-5-3\" data-name=\"ouvertures navigation label\">\n                        Ouvertures\n                    </span>\n                </a>\n            </nav>\n            <div class=\"top-status\" data-kid=\"1-8-1-3\">\n                <span class=\"season\" data-kid=\"1-8-1-3-1\">\n                    Saison 04 / 2026\n                </span>\n                <div class=\"profile-level\" data-kid=\"1-8-1-3-2\">\n                    <span class=\"level-chip\" data-kid=\"1-8-1-3-2-1\">\n                        NIV. 07\n                    </span>\n                    <span aria-label=\"68% vers le niveau suivant\" class=\"mini-xp\" data-kid=\"1-8-1-3-2-2\">\n                        <span data-dynamic=\"true\" data-kid=\"1-8-1-3-2-2-1\" data-name=\"xp progress bar\" data-reason=\"width updated by script to reflect user xp\">\n                        </span>\n                    </span>\n                </div>\n            </div>\n        </header>\n        <main data-kid=\"1-8-2\" id=\"apprendre\">\n            <section aria-labelledby=\"page-title\" class=\"intro\" data-kid=\"1-8-2-1\">\n                <div data-kid=\"1-8-2-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-8-2-1-1-1\" data-name=\"intro eyebrow text\">\n                        Parcours de maîtrise / vue active · Apprendre\n                    </div>\n                    <h1 data-kid=\"1-8-2-1-1-2\" id=\"page-title\">\n                        Apprendre.\n                    </h1>\n                    <p data-kid=\"1-8-2-1-1-3\">\n                        Reprends le fil de ton entraînement, verrouille les fondamentaux et transforme chaque erreur en avantage durable.\n                    </p>\n                </div>\n                <div aria-label=\"Légende des qualités de coup\" class=\"quality-legend\" data-kid=\"1-8-2-1-2\">\n                    <span class=\"legend-label\" data-kid=\"1-8-2-1-2-1\">\n                        Repères\n                    </span>\n                    <span class=\"quality-item\" data-kid=\"1-8-2-1-2-2\">\n                        <span class=\"quality-mark brilliant\" data-kid=\"1-8-2-1-2-2-1\">\n                            !!\n                        </span>\n                        Brillant\n                    </span>\n                    <span class=\"quality-item\" data-kid=\"1-8-2-1-2-3\">\n                        <span class=\"quality-mark best\" data-kid=\"1-8-2-1-2-3-1\">\n                            ★\n                        </span>\n                        Meilleur\n                    </span>\n                    <span class=\"quality-item\" data-kid=\"1-8-2-1-2-4\">\n                        <span class=\"quality-mark inaccuracy\" data-kid=\"1-8-2-1-2-4-1\" data-name=\"inaccuracy mark\">\n                            ?!\n                        </span>\n                        Imprécision\n                    </span>\n                    <span class=\"quality-item\" data-kid=\"1-8-2-1-2-5\">\n                        <span class=\"quality-mark blunder\" data-kid=\"1-8-2-1-2-5-1\">\n                            ??\n                        </span>\n                        Gaffe\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Progression actuelle\" class=\"top-grid\" data-kid=\"1-8-2-2\">\n                <article aria-label=\"Progression de niveau\" class=\"panel dial-panel\" data-kid=\"1-8-2-2-1\">\n                    <div class=\"panel-kicker\" data-kid=\"1-8-2-2-1-1\">\n                        Progression actuelle\n                    </div>\n                    <div class=\"dial-wrap\" data-kid=\"1-8-2-2-1-2\">\n                        <svg aria-label=\"68 pour cent vers le niveau 8\" class=\"dial\" data-dynamic=\"true\" data-kid=\"1-8-2-2-1-2-1\" data-name=\"radial progress dial svg\" data-reason=\"stroke-dashoffset updated by script to reflect progress\" role=\"img\" viewbox=\"0 0 192 192\">\n                            <circle class=\"dial-track\" cx=\"96\" cy=\"96\" r=\"76\">\n                            </circle>\n                            <circle class=\"dial-hairline\" cx=\"96\" cy=\"96\" r=\"84\">\n                            </circle>\n                            <circle class=\"dial-progress\" cx=\"96\" cy=\"96\" r=\"76\">\n                            </circle>\n                        </svg>\n                        <div class=\"dial-center\" data-kid=\"1-8-2-2-1-2-2\">\n                            <div class=\"dial-level\" data-dynamic=\"true\" data-kid=\"1-8-2-2-1-2-2-1\" data-name=\"current level text\" data-reason=\"level number updated by script\">\n                                07\n                            </div>\n                            <div class=\"dial-caption\" data-kid=\"1-8-2-2-1-2-2-2\">\n                                Niveau\n                            </div>\n                            <div class=\"dial-xp\" data-dynamic=\"true\" data-kid=\"1-8-2-2-1-2-2-3\" data-name=\"current xp text\" data-reason=\"xp text updated by script\">\n                                480 / 700 XP\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"threshold\" data-kid=\"1-8-2-2-1-3\">\n                        <strong data-kid=\"1-8-2-2-1-3-1\">\n                            220 XP\n                        </strong>\n                        avant le niveau suivant\n                    </div>\n                </article>\n                <article aria-labelledby=\"active-lesson-title\" class=\"panel active-lesson\" data-kid=\"1-8-2-2-2\">\n                    <div class=\"lesson-topline\" data-kid=\"1-8-2-2-2-1\">\n                        <span class=\"lesson-status\" data-kid=\"1-8-2-2-2-1-1\">\n                            <span class=\"status-dot\" data-kid=\"1-8-2-2-2-1-1-1\">\n                            </span>\n                            Leçon active · 03 / 08\n                        </span>\n                        <span class=\"tier-label\" data-kid=\"1-8-2-2-2-1-2\">\n                            Palier Bronze\n                        </span>\n                    </div>\n                    <h2 data-kid=\"1-8-2-2-2-2\" id=\"active-lesson-title\">\n                        Reconnaître les pièces en prise\n                    </h2>\n                    <p class=\"summary\" data-kid=\"1-8-2-2-2-3\">\n                        Apprends à repérer la menace avant de calculer la suite. Une routine courte pour ne plus laisser une pièce sans défense.\n                    </p>\n                    <div class=\"coach-note\" data-kid=\"1-8-2-2-2-4\" data-name=\"lesson coach note container\">\n                        <strong data-kid=\"1-8-2-2-2-4-1\" data-name=\"coach note label\">\n                            Brillant · !!\n                        </strong>\n                        <span data-kid=\"1-8-2-2-2-4-2\" data-name=\"coach note text\">\n                            Ton dernier coup a créé une menace double. Utilise ce repère pour démarrer la prochaine séquence tactique.\n                        </span>\n                    </div>\n                    <div class=\"lesson-metrics\" data-kid=\"1-8-2-2-2-5\">\n                        <div class=\"progress-block\" data-kid=\"1-8-2-2-2-5-1\">\n                            <div class=\"metric-line\" data-kid=\"1-8-2-2-2-5-1-1\">\n                                <span data-kid=\"1-8-2-2-2-5-1-1-1\">\n                                    Progression de la leçon\n                                </span>\n                                <strong data-kid=\"1-8-2-2-2-5-1-1-2\">\n                                    4 / 6 étapes\n                                </strong>\n                            </div>\n                            <div class=\"progress-track\" data-kid=\"1-8-2-2-2-5-1-2\">\n                                <span data-dynamic=\"true\" data-kid=\"1-8-2-2-2-5-1-2-1\" data-name=\"lesson progress bar\" data-reason=\"width updated by script to reflect lesson completion\">\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"reward\" data-kid=\"1-8-2-2-2-5-2\">\n                            <small data-kid=\"1-8-2-2-2-5-2-1\">\n                                Récompense\n                            </small>\n                            <strong data-kid=\"1-8-2-2-2-5-2-2\">\n                                +120 XP\n                            </strong>\n                        </div>\n                    </div>\n                    <div class=\"level-up\" data-kid=\"1-8-2-2-2-6\">\n                        <span class=\"level-up-line\" data-kid=\"1-8-2-2-2-6-1\">\n                        </span>\n                        <span data-kid=\"1-8-2-2-2-6-2\">\n                            Montée de niveau à\n                        </span>\n                        <b data-kid=\"1-8-2-2-2-6-3\">\n                            700 XP\n                        </b>\n                        <span data-kid=\"1-8-2-2-2-6-4\">\n                            · encore 220 XP\n                        </span>\n                    </div>\n                    <div class=\"lesson-actions\" data-kid=\"1-8-2-2-2-7\">\n                        <button class=\"primary-action\" data-kid=\"1-8-2-2-2-7-1\" type=\"button\">\n                            Reprendre la leçon\n                            <span aria-hidden=\"true\" data-kid=\"1-8-2-2-2-7-1-1\">\n                                →\n                            </span>\n                        </button>\n                        <a class=\"secondary-action\" data-kid=\"1-8-2-2-2-7-2\" href=\"#parcours\">\n                            Voir le parcours\n                        </a>\n                    </div>\n                </article>\n            </section>\n            <section aria-labelledby=\"path-title\" class=\"path-section\" data-kid=\"1-8-2-3\" id=\"parcours\">\n                <div class=\"section-heading\" data-kid=\"1-8-2-3-1\">\n                    <div data-kid=\"1-8-2-3-1-1\">\n                        <div class=\"eyebrow\" data-kid=\"1-8-2-3-1-1-1\" style=\"margin-bottom:8px\">\n                            Feuille de route\n                        </div>\n                        <h3 data-kid=\"1-8-2-3-1-1-2\" id=\"path-title\">\n                            Parcours de progression\n                        </h3>\n                    </div>\n                    <p data-kid=\"1-8-2-3-1-2\">\n                        8 leçons · 3 paliers · 1 mission en cours\n                    </p>\n                </div>\n                <div class=\"path\" data-kid=\"1-8-2-3-2\">\n                    <section aria-labelledby=\"bronze-title\" class=\"tier bronze\" data-kid=\"1-8-2-3-2-1\">\n                        <div class=\"tier-node\" data-kid=\"1-8-2-3-2-1-1\">\n                            <span data-kid=\"1-8-2-3-2-1-1-1\">\n                                01\n                            </span>\n                        </div>\n                        <div class=\"tier-head\" data-kid=\"1-8-2-3-2-1-2\">\n                            <div class=\"tier-title\" data-kid=\"1-8-2-3-2-1-2-1\">\n                                <h4 data-kid=\"1-8-2-3-2-1-2-1-1\" id=\"bronze-title\">\n                                    Bronze\n                                </h4>\n                                <span data-kid=\"1-8-2-3-2-1-2-1-2\">\n                                    Fondamentaux\n                                </span>\n                            </div>\n                            <span class=\"tier-progress\" data-dynamic=\"true\" data-kid=\"1-8-2-3-2-1-2-2\" data-name=\"bronze tier progress text\" data-reason=\"text updated by script as lessons are completed\">\n                                4 / 6 terminées\n                            </span>\n                        </div>\n                        <div class=\"tickets\" data-kid=\"1-8-2-3-2-1-3\">\n                            <button class=\"lesson-ticket completed\" data-kid=\"1-8-2-3-2-1-3-1\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-1-3-1-1\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-1-1-1\">\n                                        ✓ Terminé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-1-3-1-1-2\">\n                                        01\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-1-3-1-2\">\n                                    Valeur des pièces\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-1-3-1-3\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-1-3-1\">\n                                        12 min\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-1-3-1-3-2\">\n                                        +80 XP\n                                    </strong>\n                                </span>\n                            </button>\n                            <button class=\"lesson-ticket completed\" data-kid=\"1-8-2-3-2-1-3-2\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-1-3-2-1\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-2-1-1\">\n                                        ✓ Terminé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-1-3-2-1-2\">\n                                        02\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-1-3-2-2\">\n                                    Développer avec tempo\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-1-3-2-3\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-2-3-1\">\n                                        15 min\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-1-3-2-3-2\">\n                                        +100 XP\n                                    </strong>\n                                </span>\n                            </button>\n                            <button class=\"lesson-ticket current\" data-kid=\"1-8-2-3-2-1-3-3\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-1-3-3-1\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-3-1-1\">\n                                        ● En cours\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-1-3-3-1-2\">\n                                        03\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-1-3-3-2\">\n                                    Pièces en prise\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-1-3-3-3\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-3-3-1\">\n                                        18 min\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-1-3-3-3-2\">\n                                        +120 XP\n                                    </strong>\n                                </span>\n                            </button>\n                            <button class=\"lesson-ticket upcoming\" data-kid=\"1-8-2-3-2-1-3-4\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-1-3-4-1\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-4-1-1\">\n                                        À commencer\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-1-3-4-1-2\">\n                                        04\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-1-3-4-2\">\n                                    Échecs et menaces\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-1-3-4-3\">\n                                    <span data-kid=\"1-8-2-3-2-1-3-4-3-1\">\n                                        14 min\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-1-3-4-3-2\">\n                                        +100 XP\n                                    </strong>\n                                </span>\n                            </button>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"silver-title\" class=\"tier silver\" data-kid=\"1-8-2-3-2-2\">\n                        <div class=\"tier-node\" data-kid=\"1-8-2-3-2-2-1\">\n                            <span data-kid=\"1-8-2-3-2-2-1-1\">\n                                02\n                            </span>\n                        </div>\n                        <div class=\"tier-head\" data-kid=\"1-8-2-3-2-2-2\">\n                            <div class=\"tier-title\" data-kid=\"1-8-2-3-2-2-2-1\">\n                                <h4 data-kid=\"1-8-2-3-2-2-2-1-1\" id=\"silver-title\">\n                                    Argent\n                                </h4>\n                                <span data-kid=\"1-8-2-3-2-2-2-1-2\">\n                                    Calcul & précision\n                                </span>\n                            </div>\n                            <span class=\"tier-progress\" data-dynamic=\"true\" data-kid=\"1-8-2-3-2-2-2-2\" data-name=\"silver tier progress text\" data-reason=\"text updated by script as lessons are completed\">\n                                0 / 3 terminées\n                            </span>\n                        </div>\n                        <div class=\"tickets\" data-kid=\"1-8-2-3-2-2-3\">\n                            <button class=\"lesson-ticket locked\" data-kid=\"1-8-2-3-2-2-3-1\" disabled=\"\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-2-3-1-1\">\n                                    <span data-kid=\"1-8-2-3-2-2-3-1-1-1\">\n                                        Verrouillé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-2-3-1-1-2\">\n                                        05\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-2-3-1-2\">\n                                    Calculer les variantes\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-2-3-1-3\">\n                                    <span data-kid=\"1-8-2-3-2-2-3-1-3-1\">\n                                        Débloqué après Bronze\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-2-3-1-3-2\">\n                                        +160 XP\n                                    </strong>\n                                </span>\n                            </button>\n                            <button class=\"lesson-ticket locked\" data-kid=\"1-8-2-3-2-2-3-2\" disabled=\"\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-2-3-2-1\">\n                                    <span data-kid=\"1-8-2-3-2-2-3-2-1-1\">\n                                        Verrouillé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-2-3-2-1-2\">\n                                        06\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-2-3-2-2\">\n                                    Plans de milieu de partie\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-2-3-2-3\">\n                                    <span data-kid=\"1-8-2-3-2-2-3-2-3-1\">\n                                        Débloqué après Bronze\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-2-3-2-3-2\">\n                                        +180 XP\n                                    </strong>\n                                </span>\n                            </button>\n                            <button class=\"lesson-ticket locked\" data-kid=\"1-8-2-3-2-2-3-3\" disabled=\"\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-2-3-3-1\">\n                                    <span data-kid=\"1-8-2-3-2-2-3-3-1-1\">\n                                        Verrouillé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-2-3-3-1-2\">\n                                        07\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-2-3-3-2\">\n                                    Convertir un avantage\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-2-3-3-3\">\n                                    <span data-kid=\"1-8-2-3-2-2-3-3-3-1\">\n                                        Débloqué après Bronze\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-2-3-3-3-2\">\n                                        +200 XP\n                                    </strong>\n                                </span>\n                            </button>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"gold-title\" class=\"tier gold\" data-kid=\"1-8-2-3-2-3\">\n                        <div class=\"tier-node\" data-kid=\"1-8-2-3-2-3-1\">\n                            <span data-kid=\"1-8-2-3-2-3-1-1\">\n                                03\n                            </span>\n                        </div>\n                        <div class=\"tier-head\" data-kid=\"1-8-2-3-2-3-2\">\n                            <div class=\"tier-title\" data-kid=\"1-8-2-3-2-3-2-1\">\n                                <h4 data-kid=\"1-8-2-3-2-3-2-1-1\" id=\"gold-title\">\n                                    Or\n                                </h4>\n                                <span data-kid=\"1-8-2-3-2-3-2-1-2\">\n                                    Maîtrise & intuition\n                                </span>\n                            </div>\n                            <span class=\"tier-progress\" data-dynamic=\"true\" data-kid=\"1-8-2-3-2-3-2-2\" data-name=\"gold tier progress text\" data-reason=\"text updated by script as lessons are completed\">\n                                0 / 2 terminées\n                            </span>\n                        </div>\n                        <div class=\"tickets\" data-kid=\"1-8-2-3-2-3-3\">\n                            <button class=\"lesson-ticket locked\" data-kid=\"1-8-2-3-2-3-3-1\" disabled=\"\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-3-3-1-1\">\n                                    <span data-kid=\"1-8-2-3-2-3-3-1-1-1\">\n                                        Verrouillé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-3-3-1-1-2\">\n                                        08\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-3-3-1-2\">\n                                    Trouver le coup critique\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-3-3-1-3\">\n                                    <span data-kid=\"1-8-2-3-2-3-3-1-3-1\">\n                                        Débloqué après Argent\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-3-3-1-3-2\">\n                                        +240 XP\n                                    </strong>\n                                </span>\n                            </button>\n                            <button class=\"lesson-ticket locked\" data-kid=\"1-8-2-3-2-3-3-2\" disabled=\"\" type=\"button\">\n                                <span class=\"ticket-state\" data-kid=\"1-8-2-3-2-3-3-2-1\">\n                                    <span data-kid=\"1-8-2-3-2-3-3-2-1-1\">\n                                        Verrouillé\n                                    </span>\n                                    <em data-kid=\"1-8-2-3-2-3-3-2-1-2\">\n                                        09\n                                    </em>\n                                </span>\n                                <span class=\"ticket-title\" data-kid=\"1-8-2-3-2-3-3-2-2\">\n                                    Construire son répertoire\n                                </span>\n                                <span class=\"ticket-footer\" data-kid=\"1-8-2-3-2-3-3-2-3\">\n                                    <span data-kid=\"1-8-2-3-2-3-3-2-3-1\">\n                                        Débloqué après Argent\n                                    </span>\n                                    <strong data-kid=\"1-8-2-3-2-3-3-2-3-2\">\n                                        +300 XP\n                                    </strong>\n                                </span>\n                            </button>\n                        </div>\n                    </section>\n                </div>\n                <div aria-label=\"Activité récente des coups\" class=\"quality-activity\" data-kid=\"1-8-2-3-3\">\n                    <span class=\"activity-label\" data-kid=\"1-8-2-3-3-1\">\n                        Derniers repères de partie\n                    </span>\n                    <div class=\"activity-items\" data-kid=\"1-8-2-3-3-2\">\n                        <span class=\"activity-item brilliant\" data-kid=\"1-8-2-3-3-2-1\">\n                            <span class=\"mark\" data-kid=\"1-8-2-3-3-2-1-1\">\n                                !!\n                            </span>\n                            <span class=\"move\" data-kid=\"1-8-2-3-3-2-1-2\">\n                                18. Fxf7+\n                            </span>\n                            <span data-kid=\"1-8-2-3-3-2-1-3\">\n                                Brillant\n                            </span>\n                        </span>\n                        <span class=\"activity-item best\" data-kid=\"1-8-2-3-3-2-2\">\n                            <span class=\"mark\" data-kid=\"1-8-2-3-3-2-2-1\">\n                                ★\n                            </span>\n                            <span class=\"move\" data-kid=\"1-8-2-3-3-2-2-2\">\n                                22. Ce4\n                            </span>\n                            <span data-kid=\"1-8-2-3-3-2-2-3\">\n                                Meilleur\n                            </span>\n                        </span>\n                        <span class=\"activity-item inaccuracy\" data-kid=\"1-8-2-3-3-2-3\" data-name=\"inaccuracy activity item\">\n                            <span class=\"mark\" data-kid=\"1-8-2-3-3-2-3-1\" data-name=\"inaccuracy activity mark\">\n                                ?!\n                            </span>\n                            <span class=\"move\" data-kid=\"1-8-2-3-3-2-3-2\" data-name=\"inaccuracy activity move text\">\n                                24... h6\n                            </span>\n                            <span data-kid=\"1-8-2-3-3-2-3-3\" data-name=\"inaccuracy activity label text\">\n                                Imprécision\n                            </span>\n                        </span>\n                        <span class=\"activity-item blunder\" data-kid=\"1-8-2-3-3-2-4\" data-name=\"blunder activity item\">\n                            <span class=\"mark\" data-kid=\"1-8-2-3-3-2-4-1\" data-name=\"blunder activity mark\">\n                                ??\n                            </span>\n                            <span class=\"move\" data-kid=\"1-8-2-3-3-2-4-2\" data-name=\"blunder activity move text\">\n                                27... Txd4\n                            </span>\n                            <span data-kid=\"1-8-2-3-3-2-4-3\" data-name=\"blunder activity label text\">\n                                Gaffe\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n<script>\n    (() => {\n    const nav = document.querySelectorAll('.nav-link');\n    nav.forEach((tab) => {\n      tab.addEventListener('click', (event) => {\n        event.preventDefault();\n        nav.forEach((item) => {\n          item.classList.remove('active');\n          item.removeAttribute('aria-current');\n        });\n        tab.classList.add('active');\n        tab.setAttribute('aria-current', 'page');\n      });\n    });\n\n    const tickets = document.querySelectorAll('.lesson-ticket:not(.locked)');\n    const activeTitle = document.querySelector('#active-lesson-title');\n    tickets.forEach((ticket) => {\n      ticket.addEventListener('click', () => {\n        const title = ticket.querySelector('.ticket-title');\n        if (title && activeTitle) activeTitle.textContent = title.textContent;\n        tickets.forEach((item) => item.classList.remove('current'));\n        ticket.classList.add('current');\n      });\n    });\n  })();\n</script>\n",
