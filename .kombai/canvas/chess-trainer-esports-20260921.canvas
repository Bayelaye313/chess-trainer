      "html": "<style>\n    :root {\n    --bg-obsidian: #0B0C10;\n    --bg-slate: #1F2833;\n    --bg-slate-2: #151d27;\n    --line: rgba(102, 252, 241, .18);\n    --line-strong: rgba(102, 252, 241, .38);\n    --text: #f5f7fb;\n    --muted: #9aa7b5;\n    --neon-cyan: #66FCF1;\n    --accent-purple: #8A2BE2;\n    --quality-brilliant: #39e6b4;\n    --quality-best: #58a6ff;\n    --quality-inaccuracy: #f4c95d;\n    --quality-blunder: #ff5d67;\n    --piece-glow: 0 0 15px rgba(102, 252, 241, .6);\n    --motion-tab-duration: 260ms;\n    --motion-hover-duration: 300ms;\n    --motion-panel-ease: cubic-bezier(.22, 1, .36, 1);\n  }\n\n  .chess-app {\n    min-height: 100vh;\n    margin: 0;\n    padding: 26px 42px 44px;\n    color: var(--text);\n    background:\n      radial-gradient(circle at 88% 4%, rgba(138, 43, 226, .10), transparent 22%),\n      radial-gradient(circle at 6% 16%, rgba(102, 252, 241, .055), transparent 20%),\n      var(--bg-obsidian);\n    font-family: \"Geist\", \"Inter\", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    letter-spacing: -.01em;\n    overflow: hidden;\n  }\n\n  .chess-app button,\n  .chess-app [role=\"button\"] {\n    font: inherit;\n  }\n\n  .topbar {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    min-height: 54px;\n    border-bottom: 1px solid rgba(255,255,255,.08);\n  }\n\n  .brand-lockup {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--text);\n    font-size: 12px;\n    font-weight: 750;\n    letter-spacing: .17em;\n  }\n\n  .brand-mark {\n    display: grid;\n    width: 28px;\n    height: 28px;\n    place-items: center;\n    color: var(--bg-obsidian);\n    background: var(--neon-cyan);\n    border-radius: 7px 2px 7px 2px;\n    box-shadow: 0 0 18px rgba(102,252,241,.22);\n    font-size: 19px;\n    line-height: 1;\n  }\n\n  .brand-slash { color: var(--neon-cyan); }\n\n  .brand-caption {\n    margin-left: 2px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 550;\n    letter-spacing: .18em;\n  }\n\n  .primary-nav {\n    display: flex;\n    align-items: stretch;\n    gap: 30px;\n    height: 54px;\n    margin-left: 120px;\n  }\n\n  .nav-link {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    padding: 0 2px;\n    color: var(--muted);\n    background: transparent;\n    border: 0;\n    cursor: default;\n    font-size: 13px;\n    font-weight: 650;\n    transition: all .3s ease-in-out;\n  }\n\n  .nav-link.is-active { color: var(--text); }\n  .nav-link.is-active::after {\n    position: absolute;\n    right: 0;\n    bottom: -1px;\n    left: 0;\n    height: 2px;\n    background: var(--neon-cyan);\n    box-shadow: 0 0 12px rgba(102,252,241,.75);\n    content: \"\";\n  }\n\n  .nav-link:not(.is-active):hover { color: var(--neon-cyan); }\n\n  .session-user {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .user-avatar {\n    display: grid;\n    width: 30px;\n    height: 30px;\n    place-items: center;\n    color: var(--neon-cyan);\n    background: rgba(102,252,241,.08);\n    border: 1px solid rgba(102,252,241,.28);\n    border-radius: 50%;\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 10px;\n    font-weight: 700;\n  }\n\n  .top-sparkle {\n    position: absolute;\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background: var(--neon-cyan);\n    box-shadow: 0 0 10px rgba(102,252,241,.9);\n    pointer-events: none;\n  }\n\n  .top-sparkle.one { top: 12px; left: 34%; }\n  .top-sparkle.two { top: 39px; left: 66%; width: 3px; height: 3px; background: var(--accent-purple); box-shadow: 0 0 10px rgba(138,43,226,.9); }\n\n  .page-intro {\n    display: flex;\n    align-items: end;\n    justify-content: space-between;\n    gap: 24px;\n    margin: 31px 0 16px;\n  }\n\n  .eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--neon-cyan);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .eyebrow::before {\n    display: block;\n    width: 25px;\n    height: 1px;\n    background: var(--neon-cyan);\n    box-shadow: 0 0 8px rgba(102,252,241,.75);\n    content: \"\";\n  }\n\n  .page-title {\n    margin: 8px 0 0;\n    font-size: clamp(24px, 2.2vw, 34px);\n    font-weight: 730;\n    letter-spacing: -.055em;\n  }\n\n  .page-title em {\n    color: var(--neon-cyan);\n    font-style: normal;\n  }\n\n  .session-note {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    padding-bottom: 5px;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 10px;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n  }\n\n  .session-note .status-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--quality-brilliant);\n    box-shadow: 0 0 10px rgba(57,230,180,.9);\n  }\n\n  .scorebar {\n    display: grid;\n    grid-template-columns: 1.15fr .85fr 1fr;\n    min-height: 48px;\n    margin-bottom: 22px;\n    background: rgba(31,40,51,.78);\n    border: 1px solid rgba(102,252,241,.20);\n    border-radius: 4px 0 4px 0;\n    box-shadow: inset 0 -1px 0 rgba(255,255,255,.035);\n  }\n\n  .score-cell {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    padding: 0 17px;\n    border-right: 1px solid rgba(255,255,255,.08);\n  }\n\n  .score-cell:last-child {\n    justify-content: flex-end;\n    border-right: 0;\n  }\n\n  .score-label {\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 9px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .score-value {\n    color: var(--text);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .score-value.cyan { color: var(--neon-cyan); }\n  .score-value.eval { color: var(--quality-brilliant); }\n\n  .score-arrow {\n    color: var(--neon-cyan);\n    font-size: 15px;\n  }\n\n  .arena-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 374px;\n    align-items: start;\n    gap: 28px;\n  }\n\n  .board-column {\n    width: clamp(640px, 58vw, 880px);\n    min-width: 640px;\n  }\n\n  .board-frame {\n    position: relative;\n    display: flex;\n    width: 100%;\n    aspect-ratio: 1;\n    padding: 13px 13px 13px 41px;\n    background: linear-gradient(135deg, rgba(102,252,241,.18), transparent 17%), rgba(31,40,51,.34);\n    border: 1px solid rgba(102,252,241,.25);\n    border-radius: 4px 0 4px 0;\n    box-shadow: 0 0 0 1px rgba(138,43,226,.08), inset 0 0 28px rgba(102,252,241,.035);\n  }\n\n  .board-frame::before,\n  .board-frame::after {\n    position: absolute;\n    width: 18px;\n    height: 18px;\n    border-color: var(--neon-cyan);\n    content: \"\";\n    pointer-events: none;\n  }\n\n  .board-frame::before {\n    top: -1px;\n    left: -1px;\n    border-top: 2px solid;\n    border-left: 2px solid;\n  }\n\n  .board-frame::after {\n    right: -1px;\n    bottom: -1px;\n    border-right: 2px solid var(--accent-purple);\n    border-bottom: 2px solid var(--accent-purple);\n  }\n\n  .evaluation-rail {\n    position: absolute;\n    top: 13px;\n    bottom: 13px;\n    left: 10px;\n    display: flex;\n    width: 22px;\n    flex-direction: column;\n    align-items: center;\n    justify-content: space-between;\n    color: rgba(245,247,251,.52);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 8px;\n  }\n\n  .eval-track {\n    position: relative;\n    width: 4px;\n    flex: 1;\n    margin: 7px 0;\n    overflow: hidden;\n    background: #11161c;\n    border: 1px solid rgba(255,255,255,.12);\n  }\n\n  .eval-fill {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    height: 63%;\n    background: linear-gradient(to top, var(--quality-brilliant), var(--neon-cyan));\n    box-shadow: 0 0 9px rgba(102,252,241,.55);\n  }\n\n  .eval-zero {\n    position: absolute;\n    right: -5px;\n    left: -5px;\n    top: 53%;\n    height: 1px;\n    background: rgba(245,247,251,.42);\n  }\n\n  .board-wrap {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    background: #111820;\n    border: 1px solid rgba(255,255,255,.14);\n  }\n\n  .chessboard {\n    display: grid;\n    width: 100%;\n    aspect-ratio: 1;\n    grid-template-columns: repeat(8, 1fr);\n    grid-template-rows: repeat(8, 1fr);\n  }\n\n  .square {\n    position: relative;\n    display: grid;\n    min-width: 0;\n    min-height: 0;\n    place-items: center;\n    cursor: default;\n    transition: all .3s ease-in-out;\n  }\n\n  .square.light { background: #30414c; }\n  .square.dark { background: #17212b; }\n  .square.last-move { background: rgba(102,252,241,.30); box-shadow: inset 0 0 0 2px rgba(102,252,241,.45); }\n  .square.selected { background: rgba(102,252,241,.47); box-shadow: inset 0 0 0 2px var(--neon-cyan), inset 0 0 24px rgba(102,252,241,.28); }\n  .square:hover { z-index: 2; box-shadow: inset 0 0 0 2px rgba(102,252,241,.8), var(--piece-glow); }\n\n  .piece {\n    position: relative;\n    z-index: 1;\n    color: #f4f7f8;\n    font-family: \"Times New Roman\", \"DejaVu Serif\", serif;\n    font-size: clamp(33px, 5vw, 70px);\n    line-height: .9;\n    user-select: none;\n    transition: all .3s ease-in-out;\n    transform: translateY(-2%);\n  }\n\n  .piece.white {\n    color: #f6fbff;\n    text-shadow: 0 2px 0 rgba(0,0,0,.26), 0 0 12px rgba(102,252,241,.13);\n  }\n\n  .piece.black {\n    color: #0f141a;\n    -webkit-text-stroke: 1px rgba(102,252,241,.46);\n    text-shadow: 0 2px 0 rgba(0,0,0,.48), 0 0 7px rgba(102,252,241,.22);\n  }\n\n  .square:hover .piece,\n  .square.selected .piece { transform: translateY(-4%); filter: drop-shadow(0 0 8px rgba(102,252,241,.55)); }\n\n  .coord-file,\n  .coord-rank {\n    position: absolute;\n    z-index: 2;\n    color: rgba(245,247,251,.50);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: clamp(7px, .72vw, 10px);\n    font-weight: 700;\n    line-height: 1;\n    pointer-events: none;\n  }\n\n  .coord-file { right: 5px; bottom: 4px; }\n  .coord-rank { top: 4px; left: 5px; }\n  .square.light .coord-file,\n  .square.light .coord-rank { color: rgba(11,12,16,.64); }\n\n  .board-caption {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    min-height: 43px;\n    padding: 10px 2px 0;\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .board-caption strong { color: var(--text); font-weight: 650; }\n\n  .notation {\n    color: var(--neon-cyan);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 12px;\n    font-weight: 700;\n  }\n\n  .history-strip {\n    display: flex;\n    align-items: center;\n    min-height: 54px;\n    margin-top: 7px;\n    padding: 0 13px;\n    overflow: hidden;\n    background: rgba(31,40,51,.66);\n    border-top: 1px solid rgba(255,255,255,.10);\n    border-bottom: 1px solid rgba(102,252,241,.16);\n  }\n\n  .history-label {\n    flex: 0 0 auto;\n    margin-right: 19px;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 9px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .history-moves {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    min-width: 0;\n    white-space: nowrap;\n  }\n\n  .move-item {\n    display: inline-flex;\n    align-items: baseline;\n    gap: 5px;\n    padding: 6px 8px;\n    color: var(--muted);\n    border: 1px solid transparent;\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 11px;\n    transition: all .3s ease-in-out;\n  }\n\n  .move-number { color: rgba(245,247,251,.36); font-size: 9px; }\n  .move-item.active { color: var(--text); background: rgba(102,252,241,.10); border-color: rgba(102,252,241,.56); box-shadow: var(--piece-glow); }\n  .move-item.active .move-number { color: var(--neon-cyan); }\n  .move-quality { color: var(--quality-brilliant); font-size: 10px; }\n  .move-item:hover { color: var(--neon-cyan); border-color: rgba(102,252,241,.34); box-shadow: var(--piece-glow); }\n\n  .analysis-panel {\n    position: relative;\n    min-height: 632px;\n    padding: 19px;\n    overflow: hidden;\n    background: linear-gradient(150deg, rgba(31,40,51,.84), rgba(15,20,27,.88));\n    border: 1px solid rgba(102,252,241,.23);\n    border-radius: 4px 0 4px 0;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.04), 0 0 32px rgba(0,0,0,.18);\n    backdrop-filter: blur(14px);\n  }\n\n  .analysis-panel::before {\n    position: absolute;\n    top: 0;\n    right: 18px;\n    width: 40px;\n    height: 1px;\n    background: var(--accent-purple);\n    box-shadow: 0 0 12px rgba(138,43,226,.65);\n    content: \"\";\n  }\n\n  .panel-kicker {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 9px;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .panel-kicker span:last-child { color: var(--neon-cyan); }\n\n  .commentary-tabs {\n    position: relative;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 0;\n    margin-top: 20px;\n    border-bottom: 1px solid rgba(255,255,255,.13);\n  }\n\n  .tab-button {\n    position: relative;\n    padding: 11px 3px 12px;\n    color: var(--muted);\n    background: transparent;\n    border: 0;\n    cursor: pointer;\n    font-size: 11px;\n    text-align: left;\n    transition: all .3s ease-in-out;\n  }\n\n  .tab-button.is-active { color: var(--text); }\n  .tab-button:hover,\n  .tab-button:focus-visible { color: var(--neon-cyan); outline: none; box-shadow: var(--piece-glow); }\n\n  .tab-indicator {\n    position: absolute;\n    bottom: -1px;\n    left: 0;\n    width: 33.333%;\n    height: 2px;\n    background: var(--neon-cyan);\n    box-shadow: 0 0 12px rgba(102,252,241,.72);\n    transition: transform var(--motion-tab-duration) var(--motion-panel-ease);\n  }\n\n  .tab-panel {\n    display: none;\n    padding-top: 22px;\n    animation: panel-in var(--motion-tab-duration) var(--motion-panel-ease) both;\n  }\n\n  .tab-panel.is-active { display: block; }\n\n  @keyframes panel-in {\n    from { opacity: 0; transform: translateX(12px); }\n    to { opacity: 1; transform: translateX(0); }\n  }\n\n  .quality-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding-bottom: 19px;\n    border-bottom: 1px solid rgba(255,255,255,.10);\n  }\n\n  .quality-mark {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n  }\n\n  .quality-symbol {\n    display: grid;\n    width: 38px;\n    height: 38px;\n    place-items: center;\n    color: #071413;\n    background: var(--quality-brilliant);\n    border-radius: 4px 0 4px 0;\n    box-shadow: 0 0 14px rgba(57,230,180,.26);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 16px;\n    font-weight: 800;\n  }\n\n  .quality-label {\n    display: block;\n    color: var(--quality-brilliant);\n    font-size: 14px;\n    font-weight: 740;\n  }\n\n  .quality-detail {\n    display: block;\n    margin-top: 4px;\n    color: var(--muted);\n    font-size: 10px;\n  }\n\n  .evaluation {\n    color: var(--quality-brilliant);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 22px;\n    font-weight: 750;\n    letter-spacing: -.06em;\n  }\n\n  .coach-copy {\n    margin: 20px 0 0;\n    color: var(--text);\n    font-size: 17px;\n    font-weight: 560;\n    line-height: 1.36;\n    letter-spacing: -.025em;\n  }\n\n  .coach-copy em { color: var(--neon-cyan); font-style: normal; }\n\n  .micro-label {\n    display: block;\n    margin-bottom: 9px;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 9px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .engine-block {\n    margin-top: 24px;\n    padding: 15px 14px;\n    background: rgba(11,12,16,.58);\n    border: 1px solid rgba(102,252,241,.16);\n    border-left: 2px solid var(--neon-cyan);\n  }\n\n  .engine-line {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    color: var(--text);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 12px;\n    line-height: 1.8;\n  }\n\n  .engine-line span { color: var(--neon-cyan); }\n  .engine-line.secondary { color: var(--muted); font-size: 11px; }\n  .engine-line.secondary span { color: var(--quality-inaccuracy); }\n\n  .coach-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    margin-top: 24px;\n    padding-top: 17px;\n    border-top: 1px solid rgba(255,255,255,.10);\n  }\n\n  .position-id {\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 9px;\n    line-height: 1.5;\n  }\n\n  .primary-action {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-height: 38px;\n    padding: 0 15px;\n    color: #061313;\n    background: var(--neon-cyan);\n    border: 1px solid var(--neon-cyan);\n    border-radius: 3px 0 3px 0;\n    cursor: pointer;\n    font-size: 11px;\n    font-weight: 800;\n    transition: all .3s ease-in-out;\n  }\n\n  .primary-action:hover,\n  .primary-action:focus-visible { transform: translateY(-1px); box-shadow: var(--piece-glow); outline: none; }\n  .primary-action:active { transform: translateY(1px); }\n\n  .secondary-action {\n    display: inline-flex;\n    align-items: center;\n    min-height: 36px;\n    padding: 0;\n    color: var(--neon-cyan);\n    background: transparent;\n    border: 0;\n    cursor: pointer;\n    font-size: 11px;\n    transition: all .3s ease-in-out;\n  }\n\n  .secondary-action:hover { text-decoration: underline; text-underline-offset: 4px; box-shadow: var(--piece-glow); }\n\n  .side-note {\n    display: flex;\n    align-items: start;\n    gap: 10px;\n    margin-top: 23px;\n    padding-top: 16px;\n    color: var(--muted);\n    border-top: 1px solid rgba(255,255,255,.08);\n    font-size: 10px;\n    line-height: 1.5;\n  }\n\n  .side-note-mark {\n    width: 5px;\n    height: 5px;\n    flex: 0 0 auto;\n    margin-top: 5px;\n    background: var(--accent-purple);\n    box-shadow: 0 0 9px rgba(138,43,226,.9);\n  }\n\n  .move-list {\n    margin-top: 22px;\n  }\n\n  .move-list-row {\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n    padding: 12px 0;\n    border-bottom: 1px solid rgba(255,255,255,.09);\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 11px;\n  }\n\n  .move-list-row strong { color: var(--text); font-weight: 600; }\n  .move-list-row .mark { color: var(--quality-brilliant); }\n\n  .engine-lines {\n    margin-top: 4px;\n    border-top: 1px solid rgba(255,255,255,.10);\n  }\n\n  .engine-choice {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 14px;\n    padding: 14px 0;\n    border-bottom: 1px solid rgba(255,255,255,.09);\n    color: var(--text);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 11px;\n  }\n\n  .engine-choice span { color: var(--neon-cyan); }\n  .engine-choice small { color: var(--muted); font-size: 9px; }\n\n  .footer-status {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-top: 18px;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: 9px;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .footer-status::before { width: 6px; height: 6px; background: var(--quality-brilliant); border-radius: 50%; box-shadow: 0 0 9px rgba(57,230,180,.85); content: \"\"; }\n\n  @media (max-width: 1180px) {\n    .chess-app { padding-right: 24px; padding-left: 24px; overflow: auto; }\n    .primary-nav { margin-left: 40px; }\n    .arena-grid { grid-template-columns: minmax(0, 1fr) 340px; gap: 18px; }\n    .board-column { width: clamp(640px, 57vw, 760px); }\n  }\n\n  @media (max-width: 980px) {\n    .chess-app { padding: 20px 16px 34px; }\n    .arena-grid { display: block; }\n    .board-column { width: min(100%, 760px); min-width: 0; margin: 0 auto; }\n    .analysis-panel { min-height: 0; margin-top: 24px; }\n    .page-intro { margin-top: 25px; }\n  }\n\n  @media (max-width: 620px) {\n    .topbar { min-height: 48px; }\n    .brand-caption, .session-user span { display: none; }\n    .primary-nav { gap: 18px; height: 48px; margin-left: 0; }\n    .nav-link { font-size: 12px; }\n    .page-intro { align-items: start; flex-direction: column; gap: 10px; margin-top: 22px; }\n    .page-title { font-size: 26px; }\n    .session-note { padding-bottom: 0; }\n    .scorebar { grid-template-columns: 1fr 1fr 1fr; margin-bottom: 13px; }\n    .score-cell { gap: 6px; padding: 0 8px; }\n    .score-cell:last-child { justify-content: flex-start; }\n    .score-label { font-size: 8px; letter-spacing: .08em; }\n    .score-value { font-size: 11px; }\n    .score-arrow { display: none; }\n    .board-frame { padding: 8px 8px 8px 28px; }\n    .evaluation-rail { top: 8px; bottom: 8px; left: 5px; width: 17px; font-size: 7px; }\n    .piece { font-size: clamp(29px, 11vw, 52px); }\n    .coord-file, .coord-rank { font-size: 7px; }\n    .history-strip { margin-top: 5px; padding: 0 8px; }\n    .history-label { margin-right: 8px; font-size: 8px; }\n    .move-item { padding: 6px 5px; font-size: 9px; }\n    .analysis-panel { padding: 15px; }\n    .tab-button { font-size: 10px; }\n    .coach-copy { font-size: 16px; }\n 