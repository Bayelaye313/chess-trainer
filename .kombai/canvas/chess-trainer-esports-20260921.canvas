 </p>\n                    </div>\n                    <span class=\"tier-status\" data-kid=\"1-2-4-4-1-3\" data-name=\"tier lesson status summary\">\n                        00 / 04 TERMINÉES\n                    </span>\n                </div>\n                <div class=\"lane-content\" data-kid=\"1-2-4-4-2\" data-name=\"tier content area\">\n                    <div aria-label=\"Or : 0 pour cent\" class=\"dial\" data-kid=\"1-2-4-4-2-1\" data-name=\"tier mastery dial\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-2-4-4-2-1-1\" data-name=\"tier mastery dial svg\" viewbox=\"0 0 120 120\">\n                            <circle class=\"track\" cx=\"60\" cy=\"60\" r=\"48\">\n                            </circle>\n                            <circle class=\"value-ring\" cx=\"60\" cy=\"60\" r=\"48\" stroke-dasharray=\"0 301.6\">\n                            </circle>\n                        </svg>\n                        <div class=\"dial-copy\" data-kid=\"1-2-4-4-2-1-2\" data-name=\"tier mastery percentage group\">\n                            <span class=\"dial-value\" data-kid=\"1-2-4-4-2-1-2-1\" data-name=\"tier mastery percentage\">\n                                0%\n                            </span>\n                            <small data-kid=\"1-2-4-4-2-1-2-2\" data-name=\"tier mastery label\">\n                                à ouvrir\n                            </small>\n                        </div>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"orthogonal\" data-kid=\"1-2-4-4-2-2\" data-name=\"connector graphic\">\n                        <span data-kid=\"1-2-4-4-2-2-1\" data-name=\"connector graphic line\">\n                        </span>\n                        <i data-kid=\"1-2-4-4-2-2-2\" data-name=\"connector graphic dot\">\n                        </i>\n                    </div>\n                    <div class=\"lesson-list\" data-kid=\"1-2-4-4-2-3\" data-name=\"lesson list\">\n                        <button aria-disabled=\"true\" class=\"lesson-file locked\" data-kid=\"1-2-4-4-2-3-1\" type=\"button\">\n                            <div class=\"lesson-meta\" data-kid=\"1-2-4-4-2-3-1-1\">\n                                <span data-kid=\"1-2-4-4-2-3-1-1-1\">\n                                    LEÇON 01\n                                </span>\n                                <span class=\"lesson-state\" data-kid=\"1-2-4-4-2-3-1-1-2\">\n                                    VERROUILLÉE\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-4-4-2-3-1-2\">\n                                <h3 data-kid=\"1-2-4-4-2-3-1-2-1\">\n                                    Préparer le terrain\n                                </h3>\n                                <p data-kid=\"1-2-4-4-2-3-1-2-2\">\n                                    Ouvre le palier Argent pour accéder.\n                                </p>\n                            </div>\n                            <div class=\"lesson-footer\" data-kid=\"1-2-4-4-2-3-1-3\">\n                                <span data-kid=\"1-2-4-4-2-3-1-3-1\">\n                                    —\n                                </span>\n                                <strong data-kid=\"1-2-4-4-2-3-1-3-2\">\n                                    +180 XP\n                                </strong>\n                            </div>\n                        </button>\n                        <button aria-disabled=\"true\" class=\"lesson-file locked\" data-kid=\"1-2-4-4-2-3-2\" type=\"button\">\n                            <div class=\"lesson-meta\" data-kid=\"1-2-4-4-2-3-2-1\">\n                                <span data-kid=\"1-2-4-4-2-3-2-1-1\">\n                                    LEÇON 02\n                                </span>\n                                <span class=\"lesson-state\" data-kid=\"1-2-4-4-2-3-2-1-2\">\n                                    VERROUILLÉE\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-4-4-2-3-2-2\">\n                                <h3 data-kid=\"1-2-4-4-2-3-2-2-1\">\n                                    Calcul profond\n                                </h3>\n                                <p data-kid=\"1-2-4-4-2-3-2-2-2\">\n                                    Une ligne, plusieurs réponses.\n                                </p>\n                            </div>\n                            <div class=\"lesson-footer\" data-kid=\"1-2-4-4-2-3-2-3\">\n                                <span data-kid=\"1-2-4-4-2-3-2-3-1\">\n                                    —\n                                </span>\n                                <strong data-kid=\"1-2-4-4-2-3-2-3-2\">\n                                    +220 XP\n                                </strong>\n                            </div>\n                        </button>\n                        <button aria-disabled=\"true\" class=\"lesson-file locked\" data-kid=\"1-2-4-4-2-3-3\" type=\"button\">\n                            <div class=\"lesson-meta\" data-kid=\"1-2-4-4-2-3-3-1\">\n                                <span data-kid=\"1-2-4-4-2-3-3-1-1\">\n                                    LEÇON 03\n                                </span>\n                                <span class=\"lesson-state\" data-kid=\"1-2-4-4-2-3-3-1-2\">\n                                    VERROUILLÉE\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-4-4-2-3-3-2\">\n                                <h3 data-kid=\"1-2-4-4-2-3-3-2-1\">\n                                    La décision finale\n                                </h3>\n                                <p data-kid=\"1-2-4-4-2-3-3-2-2\">\n                                    Le test de maîtrise.\n                                </p>\n                            </div>\n                            <div class=\"lesson-footer\" data-kid=\"1-2-4-4-2-3-3-3\">\n                                <span data-kid=\"1-2-4-4-2-3-3-3-1\">\n                                    —\n                                </span>\n                                <strong data-kid=\"1-2-4-4-2-3-3-3-2\">\n                                    +260 XP\n                                </strong>\n                            </div>\n                        </button>\n                    </div>\n                </div>\n                <span class=\"lane-marker\" data-kid=\"1-2-4-4-3\">\n                    TIER / 03\n                </span>\n            </article>\n        </section>\n        <footer class=\"page-foot\" data-kid=\"1-2-5\" data-name=\"footer bar\">\n            <span data-kid=\"1-2-5-1\" data-name=\"footer primary status text\">\n                <strong data-kid=\"1-2-5-1-1\" data-name=\"status emphasis label\">\n                    PROGRESSION SAUVEGARDÉE\n                </strong>\n                · Les qualités de coup suivent les mêmes repères que la revue de partie.\n            </span>\n            <span class=\"page-note\" data-kid=\"1-2-5-2\" data-name=\"footer secondary note\">\n                SYNC LOCAL / PRÊT POUR LA PROCHAINE SESSION\n            </span>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-09-21T11:47:52.359618+00:00",
      "modified": "2026-09-21T11:49:01.664514+00:00",
      "id": "var_72bf228bd77f"
    },
    "var_489702ef2138": {
      "type": "variant",
      "label": "Laboratoire — Cours Actif",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    :root {\n    --obsidian: #0b0c10;\n    --surface: #11151d;\n    --surface-raised: #1f2833;\n    --surface-soft: #151b24;\n    --line: #334155;\n    --line-bright: #526174;\n    --ink: #f5f7fa;\n    --muted: #a4afbd;\n    --muted-deep: #778494;\n    --accent-cyan: #66fcf1;\n    --accent-purple: #8a2be2;\n    --quality-brilliant: #1baaa6;\n    --quality-best: #98bc49;\n    --quality-inaccuracy: #f4bf44;\n    --quality-blunder: #c93230;\n    --tier-bronze: #c2793a;\n    --tier-silver: #b6c2d1;\n    --tier-gold: #eab308;\n    --motion-tab-duration: 260ms;\n    --motion-hover-duration: 300ms;\n    --motion-panel-ease: cubic-bezier(.22, 1, .36, 1);\n    --piece-glow: 0 0 15px rgba(102, 252, 241, .6);\n  }\n\n  body {\n    margin: 0;\n    background: var(--obsidian);\n    color: var(--ink);\n    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }\n\n  .lab-app {\n    min-height: 100vh;\n    background:\n      radial-gradient(circle at 78% 4%, rgba(138, 43, 226, .08), transparent 25rem),\n      radial-gradient(circle at 12% 88%, rgba(102, 252, 241, .045), transparent 28rem),\n      var(--obsidian);\n    letter-spacing: .01em;\n  }\n\n  .lab-shell {\n    width: min(1360px, calc(100% - 56px));\n    margin: 0 auto;\n    padding: 0 0 64px;\n  }\n\n  .topbar {\n    min-height: 82px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 28px;\n    border-bottom: 1px solid rgba(82, 97, 116, .56);\n  }\n\n  .brand-lockup {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    min-width: 228px;\n  }\n\n  .brand-mark {\n    width: 30px;\n    height: 30px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--accent-cyan);\n    color: var(--accent-cyan);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 14px;\n    font-weight: 700;\n    box-shadow: inset 0 0 0 3px rgba(102, 252, 241, .08), 0 0 14px rgba(102, 252, 241, .13);\n  }\n\n  .brand-name {\n    font-size: 12px;\n    font-weight: 750;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .brand-caption {\n    margin-top: 4px;\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .topnav {\n    display: flex;\n    align-items: stretch;\n    align-self: stretch;\n    gap: 26px;\n  }\n\n  .topnav button,\n  .rail-button,\n  .action-button,\n  .lesson-slide {\n    transition: all .3s ease-in-out;\n  }\n\n  .topnav button {\n    position: relative;\n    border: 0;\n    padding: 4px 2px 0;\n    background: transparent;\n    color: var(--muted);\n    font-size: 13px;\n    cursor: pointer;\n  }\n\n  .topnav button::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    bottom: -1px;\n    left: 0;\n    height: 2px;\n    background: var(--accent-cyan);\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform var(--motion-tab-duration) var(--motion-panel-ease);\n  }\n\n  .topnav button:hover,\n  .topnav button[aria-current=\"page\"] {\n    color: var(--ink);\n  }\n\n  .topnav button[aria-current=\"page\"]::after {\n    transform: scaleX(1);\n  }\n\n  .top-status {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-width: 228px;\n    justify-content: flex-end;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .status-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--accent-cyan);\n    box-shadow: 0 0 10px rgba(102, 252, 241, .9);\n  }\n\n  .content-grid {\n    display: grid;\n    grid-template-columns: 162px minmax(0, 1fr);\n    gap: 32px;\n    padding-top: 34px;\n  }\n\n  .section-rail {\n    border-right: 1px solid rgba(82, 97, 116, .42);\n    padding: 10px 22px 0 0;\n  }\n\n  .rail-label,\n  .eyebrow,\n  .micro-label {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .rail-label {\n    margin-bottom: 22px;\n    padding-left: 12px;\n  }\n\n  .rail-stack {\n    display: grid;\n    gap: 5px;\n  }\n\n  .rail-button {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    width: 100%;\n    min-height: 40px;\n    border: 0;\n    border-left: 2px solid transparent;\n    padding: 0 8px 0 12px;\n    background: transparent;\n    color: var(--muted);\n    text-align: left;\n    font-size: 12px;\n    cursor: pointer;\n  }\n\n  .rail-button::before {\n    content: \"\";\n    width: 4px;\n    height: 4px;\n    border: 1px solid currentColor;\n    transform: rotate(45deg);\n  }\n\n  .rail-button:hover,\n  .rail-button.is-active {\n    border-left-color: var(--accent-cyan);\n    background: linear-gradient(90deg, rgba(102, 252, 241, .1), transparent);\n    color: var(--ink);\n  }\n\n  .rail-button.is-active::before {\n    background: var(--accent-cyan);\n    box-shadow: 0 0 8px rgba(102, 252, 241, .8);\n  }\n\n  .rail-footnote {\n    margin: 44px 0 0 12px;\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n    line-height: 1.7;\n  }\n\n  .main-surface {\n    min-width: 0;\n    animation: panel-in .45s var(--motion-panel-ease) both;\n  }\n\n  .main-surface.panel-shift {\n    animation: panel-in .36s var(--motion-panel-ease) both;\n  }\n\n  @keyframes panel-in {\n    from { opacity: 0; transform: translateX(10px); }\n    to { opacity: 1; transform: translateX(0); }\n  }\n\n  .page-heading {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 24px;\n    margin-bottom: 24px;\n  }\n\n  .page-heading h1 {\n    margin: 8px 0 0;\n    font-size: clamp(28px, 3vw, 42px);\n    line-height: 1;\n    letter-spacing: -.045em;\n    font-weight: 730;\n  }\n\n  .page-heading p {\n    max-width: 440px;\n    margin: 0;\n    color: var(--muted);\n    font-size: 13px;\n    line-height: 1.55;\n    text-align: right;\n  }\n\n  .measurement-head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    min-height: 38px;\n    border-top: 1px solid var(--line-bright);\n    border-bottom: 3px double var(--line-bright);\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n    letter-spacing: .11em;\n    text-transform: uppercase;\n  }\n\n  .measurement-head strong {\n    color: var(--accent-cyan);\n    font-weight: 700;\n  }\n\n  .measurement-head .head-right {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    white-space: nowrap;\n  }\n\n  .course-stage {\n    display: grid;\n    grid-template-columns: minmax(280px, 332px) minmax(0, 1fr);\n    gap: clamp(32px, 5vw, 72px);\n    align-items: center;\n    padding: 34px 0 32px;\n    border-bottom: 1px solid rgba(82, 97, 116, .55);\n  }\n\n  .dial-panel {\n    display: grid;\n    justify-items: center;\n    gap: 16px;\n  }\n\n  .dial-wrap {\n    position: relative;\n    width: 304px;\n    height: 304px;\n    display: grid;\n    place-items: center;\n  }\n\n  .dial-wrap::before,\n  .dial-wrap::after {\n    content: \"\";\n    position: absolute;\n    background: var(--line-bright);\n    opacity: .7;\n  }\n\n  .dial-wrap::before {\n    width: 1px;\n    height: 326px;\n  }\n\n  .dial-wrap::after {\n    width: 326px;\n    height: 1px;\n  }\n\n  .dial-frame {\n    position: absolute;\n    inset: 0;\n    border: 1px solid rgba(82, 97, 116, .38);\n    clip-path: polygon(0 18px, 18px 0, calc(100% - 18px) 0, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 0 calc(100% - 18px));\n  }\n\n  .dial-frame::before,\n  .dial-frame::after {\n    content: \"\";\n    position: absolute;\n    width: 22px;\n    height: 22px;\n    border-color: var(--accent-cyan);\n    border-style: solid;\n  }\n\n  .dial-frame::before {\n    top: -1px;\n    left: -1px;\n    border-width: 1px 0 0 1px;\n  }\n\n  .dial-frame::after {\n    right: -1px;\n    bottom: -1px;\n    border-width: 0 1px 1px 0;\n  }\n\n  .dial-svg {\n    position: absolute;\n    inset: 10px;\n    width: 284px;\n    height: 284px;\n    overflow: visible;\n    transform: rotate(-90deg);\n  }\n\n  .dial-track {\n    fill: none;\n    stroke: #26313e;\n    stroke-width: 7;\n  }\n\n  .dial-progress {\n    fill: none;\n    stroke: var(--accent-cyan);\n    stroke-width: 7;\n    stroke-linecap: butt;\n    stroke-dasharray: 506 816;\n    filter: drop-shadow(0 0 7px rgba(102, 252, 241, .5));\n    animation: draw-dial 900ms var(--motion-panel-ease) both;\n  }\n\n  @keyframes draw-dial {\n    from { stroke-dasharray: 0 816; }\n    to { stroke-dasharray: 506 816; }\n  }\n\n  .dial-ticks {\n    fill: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 7px;\n    letter-spacing: .1em;\n  }\n\n  .dial-readout {\n    position: relative;\n    z-index: 2;\n    display: grid;\n    justify-items: center;\n    gap: 5px;\n    text-align: center;\n  }\n\n  .dial-percent {\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 45px;\n    line-height: .95;\n    letter-spacing: -.08em;\n    font-weight: 700;\n  }\n\n  .dial-title {\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .dial-xp {\n    color: var(--accent-cyan);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 12px;\n    letter-spacing: .04em;\n  }\n\n  .dial-caption {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .course-detail {\n    min-width: 0;\n  }\n\n  .detail-kicker {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 12px;\n  }\n\n  .detail-kicker .course-code {\n    color: var(--accent-purple);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n    letter-spacing: .16em;\n  }\n\n  .active-lesson {\n    position: relative;\n    min-height: 176px;\n    border: 1px solid rgba(102, 252, 241, .38);\n    background: linear-gradient(112deg, rgba(31, 40, 51, .95), rgba(17, 21, 29, .82));\n    padding: 28px 30px 24px;\n    clip-path: polygon(0 16px, 16px 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);\n  }\n\n  .active-lesson::before,\n  .active-lesson::after {\n    content: \"\";\n    position: absolute;\n    width: 13px;\n    height: 13px;\n    border-color: var(--accent-cyan);\n    border-style: solid;\n  }\n\n  .active-lesson::before {\n    top: 7px;\n    left: 7px;\n    border-width: 1px 0 0 1px;\n  }\n\n  .active-lesson::after {\n    right: 7px;\n    bottom: 7px;\n    border-width: 0 1px 1px 0;\n  }\n\n  .active-lesson h2 {\n    margin: 10px 0 10px;\n    max-width: 610px;\n    font-size: clamp(22px, 2.4vw, 32px);\n    line-height: 1.05;\n    letter-spacing: -.035em;\n  }\n\n  .active-lesson p {\n    max-width: 620px;\n    margin: 0;\n    color: var(--muted);\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  .lesson-meta {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 10px 22px;\n    margin-top: 20px;\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n    text-transform: uppercase;\n    letter-spacing: .08em;\n  }\n\n  .tier-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    color: var(--tier-bronze);\n  }\n\n  .tier-chip::before {\n    content: \"\";\n    width: 7px;\n    height: 7px;\n    border: 1px solid currentColor;\n    transform: rotate(45deg);\n  }\n\n  .tier-chip.silver { color: var(--tier-silver); }\n  .tier-chip.gold { color: var(--tier-gold); }\n\n  .action-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 34px;\n    border: 1px solid var(--accent-cyan);\n    border-radius: 2px;\n    padding: 0 15px;\n    background: var(--accent-cyan);\n    color: #081012;\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    cursor: pointer;\n  }\n\n  .action-button:hover,\n  .action-button:focus-visible,\n  .lesson-slide:hover,\n  .lesson-slide:focus-visible {\n    box-shadow: var(--piece-glow);\n  }\n\n  .action-button:active,\n  .lesson-slide:active {\n    transform: translateY(1px);\n  }\n\n  .level-band {\n    display: grid;\n    grid-template-columns: 144px minmax(0, 1fr) 130px;\n    align-items: center;\n    gap: 18px;\n    margin-top: 20px;\n    padding: 14px 0 13px;\n    border-top: 1px solid rgba(82, 97, 116, .45);\n    border-bottom: 3px double rgba(82, 97, 116, .45);\n  }\n\n  .level-value {\n    display: grid;\n    gap: 4px;\n  }\n\n  .level-value strong {\n    font-size: 19px;\n    line-height: 1;\n  }\n\n  .level-value span,\n  .level-xp span {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .level-progress {\n    display: grid;\n    gap: 8px;\n  }\n\n  .level-progress-head {\n    display: flex;\n    justify-content: space-between;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n  }\n\n  .progress-track {\n    height: 4px;\n    background: #293440;\n    overflow: hidden;\n  }\n\n  .progress-fill {\n    width: 68%;\n    height: 100%;\n    background: linear-gradient(90deg, var(--accent-purple), var(--accent-cyan));\n    box-shadow: 0 0 10px rgba(102, 252, 241, .42);\n  }\n\n  .level-xp {\n    display: grid;\n    gap: 4px;\n    text-align: right;\n  }\n\n  .level-xp strong {\n    color: var(--accent-cyan);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 12px;\n  }\n\n  .quality-strip {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 1px;\n    margin: 26px 0 30px;\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n    background: var(--line);\n  }\n\n  .quality-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    min-height: 46px;\n    padding: 0 14px;\n    background: var(--surface);\n  }\n\n  .quality-copy {\n    display: grid;\n    gap: 2px;\n  }\n\n  .quality-copy strong {\n    font-size: 11px;\n    font-weight: 650;\n  }\n\n  .quality-copy span {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 8px;\n    letter-spacing: .09em;\n    text-transform: uppercase;\n  }\n\n  .quality-mark {\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 17px;\n    font-weight: 800;\n  }\n\n  .quality-item.brilliant .quality-mark { color: var(--quality-brilliant); text-shadow: 0 0 9px rgba(27, 170, 166, .45); }\n  .quality-item.best .quality-mark { color: var(--quality-best); text-shadow: 0 0 9px rgba(152, 188, 73, .45); }\n  .quality-item.inaccuracy .quality-mark { color: var(--quality-inaccuracy); text-shadow: 0 0 9px rgba(244, 191, 68, .38); }\n  .quality-item.blunder .quality-mark { color: var(--quality-blunder); text-shadow: 0 0 9px rgba(201, 50, 48, .38); }\n\n  .list-heading {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 18px;\n    margin-bottom: 11px;\n  }\n\n  .list-heading h2 {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 680;\n    letter-spacing: -.02em;\n  }\n\n  .list-heading span {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .lesson-list {\n    display: grid;\n    gap: 7px;\n  }\n\n  .lesson-slide {\n    position: relative;\n    display: grid;\n    grid-template-columns: minmax(220px, 1.65fr) minmax(130px, .8fr) minmax(140px, 1fr) 92px;\n    align-items: center;\n    gap: 18px;\n    min-height: 72px;\n    border: 1px solid rgba(82, 97, 116, .55);\n    padding: 0 18px;\n    background: rgba(17, 21, 29, .78);\n    color: var(--ink);\n    text-align: left;\n    cursor: pointer;\n  }\n\n  .lesson-slide::before,\n  .lesson-slide::after {\n    content: \"\";\n    position: absolute;\n    width: 9px;\n    height: 9px;\n    border-color: transparent;\n    border-style: solid;\n    transition: all .3s ease-in-out;\n  }\n\n  .lesson-slide::before {\n    top: -1px;\n    left: -1px;\n    border-width: 1px 0 0 1px;\n  }\n\n  .lesson-slide::after {\n    right: -1px;\n    bottom: -1px;\n    border-width: 0 1px 1px 0;\n  }\n\n  .lesson-slide:hover,\n  .lesson-slide.is-selected {\n    border-color: rgba(102, 252, 241, .72);\n    background: linear-gradient(90deg, rgba(31, 40, 51, .96), rgba(17, 21, 29, .88));\n  }\n\n  .lesson-slide:hover::before,\n  .lesson-slide:hover::after,\n  .lesson-slide.is-selected::before,\n  .lesson-slide.is-selected::after {\n    border-color: var(--accent-cyan);\n  }\n\n  .lesson-title {\n    display: grid;\n    gap: 5px;\n    min-width: 0;\n  }\n\n  .lesson-index {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n    letter-spacing: .12em;\n  }\n\n  .lesson-title strong {\n    overflow: hidden;\n    font-size: 12px;\n    font-weight: 650;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .lesson-tier,\n  .lesson-status,\n  .lesson-reward {\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 10px;\n  }\n\n  .lesson-tier {\n    text-transform: uppercase;\n    letter-spacing: .09em;\n  }\n\n  .lesson-tier.bronze { color: var(--tier-bronze); }\n  .lesson-tier.silver { color: var(--tier-silver); }\n  .lesson-tier.gold { color: var(--tier-gold); }\n\n  .lesson-progress {\n    display: grid;\n    gap: 6px;\n  }\n\n  .lesson-progress .progress-track {\n    height: 3px;\n  }\n\n  .lesson-progress small {\n    color: var(--muted-deep);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 9px;\n  }\n\n  .lesson-status {\n    color: var(--muted-deep);\n    text-align: right;\n  }\n\n  .lesson-status.active { color: var(--accent-cyan); }\n  .lesson-status.done { color: var(--quality-best); }\n  .lesson-status.locked { color: var(--muted-deep); }\n\n  .lesson-reward {\n    color: var(--accent-cyan);\n    text-align: right;\n  }\n\n  .reward-line {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    margin-top: 20px;\n    border-top: 1px solid rgba(82, 97, 116, .42);\n    padding-top: 14px;\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .reward-line strong {\n    color: var(--accent-cyan);\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: 11px;\n  }\n\n  .reward-line .reward-accent {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--muted-deep);\n  }\n\n  .reward-accent::before {\n    content: \"\";\n    width: 5px;\n    height: 5px;\n    background: var(--accent-purple);\n    box-shadow: 0 0 9px rgba(138, 43, 226, .75);\n    transform: rotate(45deg);\n  }\n\n  button:focus-visible,\n  .lesson-slide:focus-visible {\n    outline: 2px solid var(--accent-cyan);\n    outline-offset: 2px;\n    box-shadow: 0 0 0 4px rgba(138, 43, 226, .42), var(--piece-glow);\n  }\n\n  @media (max-width: 1050px) {\n    .lab-shell { width: min(100% - 36px, 920px); }\n    .content-grid { grid-template-columns: 1fr; gap: 20px; }\n    .section-rail {\n      border-right: 0;\n      border-bottom: 1px solid rgba(82, 97, 116, .42);\n      padding: 0 0 14px;\n    }\n    .rail-label { margin-bottom: 10px; padding-left: 0; }\n    .rail-stack { display: flex; gap: 7px; overflow-x: auto; padding-bottom: 2px; }\n    .rail-button { width: auto; min-width: max-content; border-left: 0; border-bottom: 2px solid transparent; padding: 8px 12px; }\n    .rail-button:hover, .rail-button.is-active { border-bottom-color: var(--accent-cyan); border-left-color: transparent; }\n    .rail-footnote { display: none; }\n  }\n\n  @media (max-width: 760px) {\n    .lab-shell { width: min(100% - 24px, 640px); }\n    .topbar { min-height: 70px; gap: 14px; }\n    .brand-lockup { min-width: auto; }\n    .brand-caption, .top-status { display: none; }\n    .topnav { gap: 18px; }\n    .page-heading { display: grid; gap: 10px; margin-bottom: 18px; }\n    .page-heading p { max-width: none; text-align: left; }\n    .measurement-head { font-size: 9px; }\n    .measurement-head .head-right { gap: 9px; }\n    .course-stage { grid-template-columns: 1fr; gap: 30px; padding-top: 28px; }\n    .dial-wrap { width: min(304px, calc(100vw - 48px)); height: min(304px, calc(100vw - 48px)); }\n    .dial-svg { width: calc(100% - 20px); height: calc(100% - 20px); }\n    .dial-wrap::before { height: calc(100% + 22px); }\n    .dial-wrap::after { width: calc(100% + 22px); }\n    .active-lesson { padding: 24px 20px 20px; }\n    .active-lesson h2 { font-size: 24px; }\n    .level-band { grid-template-columns: 1fr 1fr; gap: 14px; }\n    .level-progress { grid-column: 1 / -1; grid-row: 2; }\n    .level-xp { text-align: right; }\n    .quality-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .quality-item { min-height: 42px; }\n    .lesson-slide { grid-template-columns: 1fr auto; gap: 9px 14px; min-height: 86px; padding: 12px 14px; }\n    .lesson-tier { text-align: right; }\n    .lesson-progress { grid-column: 1 / -1; grid-row: 2; }\n    .lesson-status { text-align: left; }\n    .lesson-reward { text-align: right; }\n    .reward-line { align-items: flex-start; flex-direction: column; gap: 8px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n      animation-duration: .01ms !important;\n      animation-iteration-count: 1 !important;\n      scroll-behavior: auto !important;\n      transition-duration: .01ms !important;\n    }\n  }\n</style>\n<div class=\"lab-app\" data-kid=\"1\">\n    <div class=\"lab-shell\" data-kid=\"1-1\">\n        <header class=\"topbar\" data-kid=\"1-1-1\">\n            <div class=\"brand-lockup\" data-kid=\"1-1-1-1\">\n                <div class=\"brand-mark\" data-kid=\"1-1-1-1-1\">\n                    ♞\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"brand-name\" data-kid=\"1-1-1-1-2-1\">\n                        Chess Trainer\n                    </div>\n                    <div class=\"brand-caption\" data-kid=\"1-1-1-1-2-2\">\n                        Laboratoire d'analyse / 07\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"Navigation principale\" class=\"topnav\" data-kid=\"1-1-1-2\">\n                <button data-kid=\"1-1-1-2-1\" type=\"button\">\n                    Jouer\n                </button>\n                <button aria-current=\"page\" data-kid=\"1-1-1-2-2\" type=\"button\">\n                    Apprendre\n                </button>\n            </nav>\n            <div class=\"top-status\" data-kid=\"1-1-1-3\">\n                <span class=\"status-dot\" data-kid=\"1-1-1-3-1\">\n                </span>\n                <span data-kid=\"1-1-1-3-2\">\n                    Session locale · prête\n                </span>\n            </div>\n        </header>\n        <div class=\"content-grid\" data-kid=\"1-1-2\">\n            <aside aria-label=\"Sections Apprendre\" class=\"section-rail\" data-kid=\"1-1-2-1\">\n                <div class=\"rail-label\" data-kid=\"1-1-2-1-1\">\n                    Apprendre / index\n                </div>\n                <div class=\"rail-stack\" data-kid=\"1-1-2-1-2\">\n                    <button class=\"rail-button is-active\" data-kid=\"1-1-2-1-2-1\" data-section=\"En cours\" type=\"button\">\n                        <span data-kid=\"1-1-2-1-2-1-1\">\n                            En cours\n                        </span>\n                    </button>\n                    <button class=\"rail-button\" data-kid=\"1-1-2-1-2-2\" data-section=\"Parcours\" type=\"button\">\n                        <span data-kid=\"1-1-2-1-2-2-1\">\n                            Parcours\n                        </span>\n                    </button>\n                    <button class=\"rail-button\" data-kid=\"1-1-2-1-2-3\" data-section=\"Récompenses\" type=\"button\">\n                        <span data-kid=\"1-1-2-1-2-3-1\">\n                            Récompenses\n                        </span>\n                    </button>\n                </div>\n                <p class=\"rail-footnote\" data-kid=\"1-1-2-1-3\">\n                    MESURE\n                    <br data-kid=\"1-1-2-1-3-1\"/>\n                    COURS 04\n                    <br data-kid=\"1-1-2-1-3-2\"/>\n                    MISE À JOUR\n                    <br data-kid=\"1-1-2-1-3-3\"/>\n                    À L'INSTANT\n                </p>\n            </aside>\n            <main class=\"main-surface\" data-kid=\"1-1-2-2\" data-main=\"\">\n                <div class=\"page-heading\" data-kid=\"1-1-2-2-1\">\n                    <div data-kid=\"1-1-2-2-1-1\">\n                        <div class=\"eyebrow\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"active section title\" data-readout=\"\" data-reason=\"text replaced by script on rail button click\">\n                            En cours / lecture active\n                        </div>\n                        <h1 data-kid=\"1-1-2-2-1-1-2\">\n                            Mesure du cours\n                        </h1>\n                    </div>\n                    <p data-kid=\"1-1-2-2-1-2\">\n                        Reprends la position où tu t'es arrêté. Chaque leçon alimente ton niveau et affine ta lecture des motifs.\n                    </p>\n                </div>\n                <div class=\"measurement-head\" data-kid=\"1-1-2-2-2\">\n                    <span data-kid=\"1-1-2-2-2-1\">\n                        <strong data-kid=\"1-1-2-2-2-1-1\">\n                            COURS 04\n                        </strong>\n                        · Tactiques de milieu de partie\n                    </span>\n                    <div class=\"head-right\" data-kid=\"1-1-2-2-2-2\">\n                        <span data-kid=\"1-1-2-2-2-2-1\">\n                            ÉTAT\n                        </span>\n                        <strong data-kid=\"1-1-2-2-2-2-2\">\n                            62 % TERMINÉ\n                        </strong>\n                        <span data-kid=\"1-1-2-2-2-2-3\">\n                            ●\n                        </span>\n                    </div>\n                </div>\n                <section aria-label=\"Mesure du cours actif\" class=\"course-stage\" data-kid=\"1-1-2-2-3\">\n                    <div class=\"dial-panel\" data-kid=\"1-1-2-2-3-1\">\n                        <div aria-label=\"Progression du cours : 62 pour cent, 480 sur 700 XP\" class=\"dial-wrap\" data-kid=\"1-1-2-2-3-1-1\">\n                            <div class=\"dial-frame\" data-kid=\"1-1-2-2-3-1-1-1\">\n                            </div>\n                            <svg aria-hidden=\"true\" class=\"dial-svg\" data-kid=\"1-1-2-2-3-1-1-2\" role=\"img\" viewbox=\"0 0 284 284\">\n                                <circle class=\"dial-track\" cx=\"142\" cy=\"142\" r=\"130\">\n                                </circle>\n                                <circle class=\"dial-progress\" cx=\"142\" cy=\"142\" r=\"130\">\n                                </circle>\n                                <g class=\"dial-ticks\" transform=\"rotate(90 142 142)\">\n                                    <text text-anchor=\"middle\" x=\"142\" y=\"18\">\n                                        100\n                                    </text>\n                                    <text text-anchor=\"middle\" x=\"266\" y=\"146\">\n                                        25\n                                    </text>\n                                    <text text-anchor=\"middle\" x=\"142\" y=\"274\">\n                                        50\n                                    </text>\n                                    <text text-anchor=\"middle\" x=\"18\" y=\"146\">\n                                        75\n                                    </text>\n                                </g>\n                            </svg>\n                            <div class=\"dial-readout\" data-kid=\"1-1-2-2-3-1-1-3\">\n                                <div class=\"dial-percent\" data-kid=\"1-1-2-2-3-1-1-3-1\">\n                                    62%\n                                </div>\n                                <div class=\"dial-title\" data-kid=\"1-1-2-2-3-1-1-3-2\">\n                                    terminé\n                                </div>\n                                <div class=\"dial-xp\" data-kid=\"1-1-2-2-3-1-1-3-3\">\n                                    480 / 700 XP\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"dial-caption\" data-kid=\"1-1-2-2-3-1-2\">\n                            Cadran de progression · seuil explicite\n                        </div>\n                    </div>\n                    <div class=\"course-detail\" data-kid=\"1-1-2-2-3-2\">\n                        <div class=\"detail-kicker\" data-kid=\"1-1-2-2-3-2-1\">\n                            <span class=\"eyebrow\" data-kid=\"1-1-2-2-3-2-1-1\">\n                                Leçon active / 04.03\n                            </span>\n                            <span class=\"course-code\" data-kid=\"1-1-2-2-3-2-1-2\">\n                                COORD. 48° · 02′\n                            </span>\n                        </div>\n                        <article class=\"active-lesson\" data-kid=\"1-1-2-2-3-2-2\">\n                            <div class=\"micro-label\" data-kid=\"1-1-2-2-3-2-2-1\">\n                                Palier bronze · étape 03 / 05\n                            </div>\n                            <h2 data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-2-2\" data-name=\"active lesson title\" data-reason=\"text replaced by script on lesson slide click\">\n                                Attaque double : reconnaître la fourchette\n                            </h2>\n                            <p data-kid=\"1-1-2-2-3-2-2-3\">\n                                Repère la pièce qui crée deux menaces simultanées, puis choisis la case qui conserve l'initiative.\n                            </p>\n                            <div class=\"lesson-meta\" data-kid=\"1-1-2-2-3-2-2-4\">\n                                <span class=\"tier-chip\" data-kid=\"1-1-2-2-3-2-2-4-1\">\n                                    Bronze\n                                </span>\n                                <span data-kid=\"1-1-2-2-3-2-2-4-2\">\n                                    Progression 62 %\n                                </span>\n                                <span data-kid=\"1-1-2-2-3-2-2-4-3\">\n                                    +120 XP à la validation\n                                </span>\n                                <button class=\"action-button\" data-kid=\"1-1-2-2-3-2-2-4-4\" type=\"button\">\n                                    Reprendre\n                                </button>\n                            </div>\n                        </article>\n                        <div aria-label=\"Progression de niveau\" class=\"level-band\" data-kid=\"1-1-2-2-3-2-3\">\n                            <div class=\"level-value\" data-kid=\"1-1-2-2-3-2-3-1\">\n                                <strong data-kid=\"1-1-2-2-3-2-3-1-1\">\n                                    Niveau 7\n                                </strong>\n                                <span data-kid=\"1-1-2-2-3-2-3-1-2\">\n                                    niveau actuel\n                                </span>\n                            </div>\n                            <div class=\"level-progress\" data-kid=\"1-1-2-2-3-2-3-2\">\n                                <div class=\"level-progress-head\" data-kid=\"1-1-2-2-3-2-3-2-1\">\n                                    <span data-kid=\"1-1-2-2-3-2-3-2-1-1\">\n                                        Progression vers le niveau 8\n                                    </span>\n                                    <strong data-kid=\"1-1-2-2-3-2-3-2-1-2\">\n                                        680 / 1 000 XP\n                                    </strong>\n                                </div>\n                                <div class=\"progress-track\" data-kid=\"1-1-2-2-3-2-3-2-2\">\n                                    <div class=\"progress-fill\" data-kid=\"1-1-2-2-3-2-3-2-2-1\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"level-xp\" data-kid=\"1-1-2-2-3-2-3-3\">\n                                <strong data-kid=\"1-1-2-2-3-2-3-3-1\">\n                                    +320 XP\n                                </strong>\n                                <span data-kid=\"1-1-2-2-3-2-3-3-2\">\n                                    avant niveau 8\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section aria-label=\"Notation de qualité des coups\" class=\"quality-strip\" data-kid=\"1-1-2-2-4\">\n                    <div class=\"quality-item brilliant\" data-kid=\"1-1-2-2-4-1\">\n                        <div class=\"quality-copy\" data-kid=\"1-1-2-2-4-1-1\">\n                            <strong data-kid=\"1-1-2-2-4-1-1-1\">\n                                Brillant\n                            </strong>\n                            <span data-kid=\"1-1-2-2-4-1-1-2\">\n                                Sacrifice juste\n                            </span>\n                        </div>\n                        <span class=\"quality-mark\" data-kid=\"1-1-2-2-4-1-2\">\n                            !!\n                        </span>\n                    </div>\n                    <div class=\"quality-item best\" data-kid=\"1-1-2-2-4-2\">\n                        <div class=\"quality-copy\" data-kid=\"1-1-2-2-4-2-1\">\n                            <strong data-kid=\"1-1-2-2-4-2-1-1\">\n                                Meilleur\n                            </strong>\n                            <span data-kid=\"1-1-2-2-4-2-1-2\">\n                                Choix moteur\n                            </span>\n                        </div>\n                        <span class=\"quality-mark\" data-kid=\"1-1-2-2-4-2-2\">\n                            ★\n                        </span>\n                    </div>\n                    <div class=\"quality-item inaccuracy\" data-kid=\"1-1-2-2-4-3\">\n                        <div class=\"quality-copy\" data-kid=\"1-1-2-2-4-3-1\">\n                            <strong data-kid=\"1-1-2-2-4-3-1-1\">\n                                Imprécision\n                            </strong>\n                            <span data-kid=\"1-1-2-2-4-3-1-2\">\n                                Perte légère\n                            </span>\n                        </div>\n                        <span class=\"quality-mark\" data-kid=\"1-1-2-2-4-3-2\">\n                            ?!\n                        </span>\n                    </div>\n                    <div class=\"quality-item blunder\" data-kid=\"1-1-2-2-4-4\">\n                        <div class=\"quality-copy\" data-kid=\"1-1-2-2-4-4-1\">\n                            <strong data-kid=\"1-1-2-2-4-4-1-1\">\n                                Gaffe\n                            </strong>\n                            <span data-kid=\"1-1-2-2-4-4-1-2\">\n                                Position compromise\n                            </span>\n                        </div>\n                        <span class=\"quality-mark\" data-kid=\"1-1-2-2-4-4-2\">\n                            ??\n                        </span>\n                    </div>\n                </section>\n                <section aria-labelledby=\"lessons-title\" data-kid=\"1-1-2-2-5\">\n                    <div class=\"list-heading\" data-kid=\"1-1-2-2-5-1\">\n                        <h2 data-kid=\"1-1-2-2-5-1-1\" id=\"lessons-title\">\n                            Lames de leçon\n                        </h2>\n                        <span data-kid=\"1-1-2-2-5-1-2\">\n                            05 étapes · ordre réel du parcours\n                        </span>\n                    </div>\n                    <div class=\"lesson-list\" data-kid=\"1-1-2-2-5-2\">\n                        <button class=\"lesson-slide is-selected\" data-kid=\"1-1-2-2-5-2-1\" data-lesson=\"Attaque double : reconnaître la fourchette\" type=\"button\">\n                            <span class=\"lesson-title\" data-kid=\"1-1-2-2-5-2-1-1\">\n                                <span class=\"lesson-index\" data-kid=\"1-1-2-2-5-2-1-1-1\">\n                                    04.03\n                                </span>\n                                <strong data-kid=\"1-1-2-2-5-2-1-1-2\">\n                                    Attaque double : reconnaître la fourchette\n                                </strong>\n                            </span>\n                            <span class=\"lesson-tier bronze\" data-kid=\"1-1-2-2-5-2-1-2\">\n                                Bronze\n                            </span>\n                            <span class=\"lesson-progress\" data-kid=\"1-1-2-2-5-2-1-3\">\n                                <span class=\"progress-track\" data-kid=\"1-1-2-2-5-2-1-3-1\">\n                                    <span class=\"progress-fill\" data-kid=\"1-1-2-2-5-2-1-3-1-1\" data-name=\"progress bar fill\" style=\"width:62%\">\n                                    </span>\n                                </span>\n                                <small data-kid=\"1-1-2-2-5-2-1-3-2\">\n                                    62 % / en cours\n                                </small>\n                            </span>\n                            <span class=\"lesson-reward\" data-kid=\"1-1-2-2-5-2-1-4\">\n                                +120 XP\n                            </span>\n                        </button>\n                        <button class=\"lesson-slide\" data-kid=\"1-1-2-2-5-2-2\" data-lesson=\"Le roi au centre : créer une cible\" type=\"button\">\n                            <span class=\"lesson-title\" data-kid=\"1-1-2-2-5-2-2-1\">\n                                <span class=\"lesson-index\" data-kid=\"1-1-2-2-5-2-2-1-1\">\n                                    04.04\n                                </span>\n                                <strong data-kid=\"1-1-2-2-5-2-2-1-2\">\n                                    Le roi au centre : créer une cible\n                                </strong>\n                            </span>\n                            <span class=\"lesson-tier bronze\" data-kid=\"1-1-2-2-5-2-2-2\">\n                                Bronze\n                            </span>\n                            <span class=\"lesson-progress\" data-kid=\"1-1-2-2-5-2-2-3\">\n                                <span class=\"progress-track\" data-kid=\"1-1-2-2-5-2-2-3-1\">\n                                    <span class=\"progress-fill\" data-kid=\"1-1-2-2-5-2-2-3-1-1\" data-name=\"progress bar fill\" style=\"width:28%\">\n                                    </span>\n                                </span>\n                                <small data-kid=\"1-1-2-2-5-2-2-3-2\">\n                                    28 % / à commencer\n                                </small>\n                            </span>\n                            <span class=\"lesson-reward\" data-kid=\"1-1-2-2-5-2-2-4\">\n                                +120 XP\n                            </span>\n                        </button>\n                        <button class=\"lesson-slide\" data-kid=\"1-1-2-2-5-2-3\" data-lesson=\"Échange favorable : compter avant de prendre\" type=\"button\">\n                            <span class=\"lesson-title\" data-kid=\"1-1-2-2-5-2-3-1\">\n                                <span class=\"lesson-index\" data-kid=\"1-1-2-2-5-2-3-1-1\">\n                                    04.05\n                                </span>\n                                <strong data-kid=\"1-1-2-2-5-2-3-1-2\">\n                                    Échange favorable : compter avant de prendre\n                                </strong>\n                            </span>\n                            <span class=\"lesson-tier silver\" data-kid=\"1-1-2-2-5-2-3-2\">\n                                Argent\n                            </span>\n                            <span class=\"lesson-progress\" data-kid=\"1-1-2-2-5-2-3-3\">\n                                <span class=\"progress-track\" data-kid=\"1-1-2-2-5-2-3-3-1\">\n                                    <span class=\"progress-fill\" data-kid=\"1-1-2-2-5-2-3-3-1-1\" data-name=\"progress bar fill\" style=\"width:100%\">\n                                    </span>\n                                </span>\n                                <small data-kid=\"1-1-2-2-5-2-3-3-2\">\n                                    100 % / terminé\n                                </small>\n                            </span>\n                            <span class=\"lesson-reward\" data-kid=\"1-1-2-2-5-2-3-4\">\n                                +160 XP\n                            </span>\n                        </button>\n                        <button class=\"lesson-slide\" data-kid=\"1-1-2-2-5-2-4\" data-lesson=\"La case forte : installer une pièce\" type=\"button\">\n                            <span class=\"lesson-title\" data-kid=\"1-1-2-2-5-2-4-1\">\n                                <span class=\"lesson-index\" data-kid=\"1-1-2-2-5-2-4-1-1\">\n                                    05.01\n                                </span>\n                                <strong data-kid=\"1-1-2-2-5-2-4-1-2\">\n                                    La case forte : installer une pièce\n                                </strong>\n                            </span>\n                            <span class=\"lesson-tier gold\" data-kid=\"1-1-2-2-5-2-4-2\">\n                                Or\n                            </span>\n                            <span class=\"lesson-progress\" data-kid=\"1-1-2-2-5-2-4-3\">\n                                <span class=\"progress-track\" data-kid=\"1-1-2-2-5-2-4-3-1\">\n                                    <span class=\"progress-fill\" data-kid=\"1-1-2-2-5-2-4-3-1-1\" data-name=\"progress bar fill\" style=\"width:0%\">\n                                    </span>\n                                </span>\n                                <small data-kid=\"1-1-2-2-5-2-4-3-2\">\n                                    0 % / verrouillée\n                                </small>\n                            </span>\n                            <span class=\"lesson-reward\" data-kid=\"1-1-2-2-5-2-4-4\">\n                                +220 XP\n                            </span>\n                        </button>\n                    </div>\n                </section>\n                <div class=\"reward-line\" data-kid=\"1-1-2-2-6\">\n                    <span class=\"reward-accent\" data-kid=\"1-1-2-2-6-1\">\n                        Dernière récompense · Série tactique validée il y a 2 min\n                    </span>\n                    <strong data-kid=\"1-1-2-2-6-2\">\n                        +80 XP · prochain palier à 700 XP\n                    </strong>\n                </div>\n            </main>\n        </div>\n    </div>\n</div>\n<script>\n    const railButtons = document.querySelectorAll('[data-section]');\n  const mainSurface = document.querySelector('[data-main]');\n  const readout = document.querySelector('[data-readout]');\n  railButtons.forEach((button) => {\n    button.addEventListener('click', () => {\n      railButtons.forEach((item) => item.classList.remove('is-active'));\n      button.classList.add('is-active');\n      readout.textContent = button.dataset.section + ' / lecture active';\n      mainSurface.classList.remove('panel-shift');\n      void mainSurface.offsetWidth;\n      mainSurface.classList.add('panel-shift');\n    });\n  });\n\n  const lessonSlides = document.querySelectorAll('[data-lesson]');\n  const activeLessonTitle = document.querySelector('.active-lesson h2');\n  lessonSlides.forEach((lesson) => {\n    lesson.addEventListener('click', () => {\n      lessonSlides.forEach((item) => item.classList.remove('is-selected'));\n      lesson.classList.add('is-selected');\n      activeLessonTitle.textContent = lesson.dataset.lesson;\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-09-21T11:48:00.515750+00:00",
      "modified": "2026-09-21T11:48:59.288937+00:00",
      "id": "var_489702ef2138"
    },
    "var_ef074d3a2105": {
      "type": "variant",
      "label": "Playbook — Fiche Tactique",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --bg: #0B0C10;\n    --surface: #121820;\n    --slate: #1F2833;\n    --slate-2: #273442;\n    --line: rgba(145, 167, 188, .24);\n    --line-strong: rgba(102, 252, 241, .46);\n    --text: #F5F8FA;\n    --muted: #9AA9B7;\n    --faint: #657381;\n    --cyan: #66FCF1;\n    --accent-purple: #8A2BE2;\n    --quality-brilliant: #1BAAA6;\n    --quality-best: #98BC49;\n    --quality-inaccuracy: #F4BF44;\n    --quality-blunder: #C93230;\n    --engine-best: #22C55E;\n    --engine-played: #F97316;\n    --board-light: #D7E3DF;\n    --board-dark: #31464A;\n    --board-ink: #172125;\n    --motion-tab-duration: 260ms;\n    --motion-hover-duration: 300ms;\n    --motion-panel-ease: cubic-bezier(.22, 1, .36, 1);\n    --piece-glow: 0 0 15px rgba(102, 252, 241, .6);\n    --board-size: clamp(660px, 59vw, 880px);\n  }\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background:\n      radial-gradient(circle at 78% 4%, rgba(138, 43, 226, .12), transparent 25%),\n      radial-gradient(circle at 7% 38%, rgba(102, 252, 241, .05), transparent 23%),\n      var(--bg);\n    color: var(--text);\n    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;\n    letter-spacing: -.01em;\n  }\n  button, a { font: inherit; }\n  button { border: 0; }\n  .app-shell {\n    min-height: 100vh;\n    overflow: hidden;\n    position: relative;\n  }\n  .app-shell::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .16;\n    background-image: radial-gradient(rgba(102,252,241,.62) .7px, transparent .7px);\n    background-size: 28px 28px;\n    mask-image: linear-gradient(90deg, transparent, black 18%, black 80%, transparent);\n  }\n  .topbar {\n    height: 76px;\n    border-bottom: 1px solid var(--line);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 clamp(20px, 4vw, 60px);\n    position: relative;\n    z-index: 2;\n    background: rgba(11, 12, 16, .82);\n    backdrop-filter: blur(18px);\n  }\n  .brand-lockup { display: flex; align-items: center; gap: 13px; min-width: 210px; }\n  .brand-mark {\n    width: 30px; height: 30px; display: grid; place-items: center;\n    color: var(--cyan); border: 1px solid var(--cyan); background: rgba(102,252,241,.07);\n    clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);\n    font-size: 16px; line-height: 1;\n  }\n  .brand-name { font-weight: 700; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; }\n  .brand-sub { color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .13em; margin-top: 2px; }\n  .nav-tabs { display: flex; align-items: stretch; align-self: stretch; gap: 26px; }\n  .nav-tab {\n    position: relative; color: var(--muted); background: transparent; cursor: pointer; padding: 0 4px;\n    font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;\n    transition: all .3s ease-in-out;\n  }\n  .nav-tab::after {\n    content: ''; position: absolute; height: 2px; left: 0; right: 0; bottom: 0; background: var(--cyan);\n    transform: scaleX(0); transform-origin: left; transition: transform var(--motion-tab-duration) var(--motion-panel-ease);\n    box-shadow: 0 0 12px rgba(102,252,241,.8);\n  }\n  .nav-tab:hover, .nav-tab:focus-visible, .nav-tab.active { color: var(--text); outline: none; }\n  .nav-tab.active::after { transform: scaleX(1); }\n  .nav-tab:focus-visible { box-shadow: var(--piece-glow); }\n  .profile-chip { display: flex; align-items: center; gap: 10px; min-width: 210px; justify-content: flex-end; }\n  .profile-status { text-align: right; }\n  .profile-name { font-size: 11px; font-weight: 600; }\n  .profile-level { font-family: 'JetBrains Mono', monospace; color: var(--cyan); font-size: 9px; margin-top: 3px; }\n  .avatar {\n    width: 30px; height: 30px; display: grid; place-items: center; color: var(--bg); background: var(--cyan);\n    font-size: 12px; font-weight: 700; clip-path: polygon(0 0, 100% 0, 100% 76%, 76% 100%, 0 100%);\n  }\n\n  .content { max-width: 1450px; margin: 0 auto; padding: 34px clamp(20px, 4vw, 60px) 52px; position: relative; z-index: 1; }\n  .view-kicker { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }\n  .eyebrow { display: flex; align-items: center; gap: 9px; font-family: 'JetBrains Mono', monospace; color: var(--muted); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }\n  .eyebrow::before { content: ''; width: 6px; height: 6px; background: var(--accent-purple); box-shadow: 0 0 10px rgba(138,43,226,.9); }\n  .session-tag { color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .08em; }\n  .arena-grid {\n    display: grid;\n    grid-template-columns: minmax(330px, 380px) minmax(var(--board-size), var(--board-size));\n    gap: clamp(22px, 3vw, 44px);\n    align-items: start;\n  }\n\n  .coach-column { order: 1; display: flex; flex-direction: column; gap: 16px; animation: panel-in 600ms var(--motion-panel-ease) both; }\n  .board-column { order: 2; min-width: var(--board-size); animation: panel-in 600ms var(--motion-panel-ease) 80ms both; }\n  .coach-sheet, .compare-sheet, .side-note, .history-rail {\n    background: linear-gradient(145deg, rgba(31,40,51,.94), rgba(15,20,26,.96));\n    border: 1px solid var(--line);\n    position: relative;\n    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 15px 100%, 0 calc(100% - 15px));\n  }\n  .coach-sheet { padding: 22px 22px 20px; border-color: rgba(102,252,241,.36); box-shadow: inset 0 1px 0 rgba(255,255,255,.04); }\n  .coach-sheet::before, .compare-sheet::before, .history-rail::before {\n    content: ''; position: absolute; top: 0; left: 0; width: 60px; height: 2px; background: var(--cyan); box-shadow: 0 0 14px rgba(102,252,241,.7);\n  }\n  .sheet-tab {\n    position: absolute; top: -1px; left: 20px; transform: translateY(-100%); color: var(--cyan); font-family: 'JetBrains Mono', monospace;\n    font-size: 9px; letter-spacing: .15em; padding: 5px 9px 4px; border: 1px solid rgba(102,252,241,.36); border-bottom: 0;\n    background: var(--bg); clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);\n  }\n  .sheet-top { display: flex; justify-content: space-between; align-items: start; gap: 12px; margin-bottom: 27px; }\n  .label { color: var(--muted); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }\n  .sheet-id { font-family: 'JetBrains Mono', monospace; color: var(--faint); font-size: 10px; }\n  .quality-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }\n  .quality-mark {\n    display: inline-flex; align-items: center; justify-content: center; width: 47px; height: 34px; color: #061918; background: var(--quality-brilliant);\n    font-family: 'JetBrains Mono', monospace; font-size: 19px; font-weight: 600; clip-path: polygon(0 0, 100% 0, 100% 76%, 76% 100%, 0 100%);\n  }\n  .quality-copy strong { display: block; font-size: 17px; line-height: 1.1; }\n  .quality-copy span { display: block; color: var(--quality-brilliant); font-family: 'JetBrains Mono', monospace; font-size: 10px; margin-top: 4px; }\n  .coach-quote { font-size: 20px; line-height: 1.26; font-weight: 600; letter-spacing: -.03em; max-width: 310px; margin: 0 0 20px; }\n  .coach-detail { color: var(--muted); font-size: 12px; line-height: 1.6; margin: 0 0 21px; max-width: 315px; }\n  .tactic-line { display: flex; align-items: center; gap: 8px; color: var(--cyan); font-family: 'JetBrains Mono', monospace; font-size: 10px; margin-bottom: 20px; }\n  .tactic-line::before { content: '↳'; color: var(--accent-purple); font-size: 15px; }\n  .primary-action {\n    width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 13px 14px; color: #071314; background: var(--cyan); cursor: pointer;\n    font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);\n    transition: all .3s ease-in-out;\n  }\n  .primary-action:hover, .primary-action:focus-visible { transform: translateY(-1px); box-shadow: var(--piece-glow); outline: none; }\n  .primary-action .action-arrow { font-family: 'JetBrains Mono', monospace; font-size: 15px; }\n  .compare-sheet { padding: 18px 19px 16px; }\n  .compare-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n  .compare-header .label { color: var(--text); }\n  .engine-state { color: var(--engine-best); font-family: 'JetBrains Mono', monospace; font-size: 9px; }\n  .compare-row { display: grid; grid-template-columns: 98px 1fr 45px; align-items: center; border-top: 1px solid var(--line); min-height: 48px; gap: 8px; }\n  .compare-row:last-child { border-bottom: 1px solid var(--line); }\n  .compare-row .row-label { color: var(--muted); font-size: 11px; }\n  .compare-row .move-code { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 13px; }\n  .compare-row .eval { text-align: right; font-family: 'JetBrains Mono', monospace; font-size: 12px; }\n  .compare-row.played .eval { color: var(--engine-played); }\n  .compare-row.best .eval { color: var(--engine-best); }\n  .micro-badge { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 20px; margin-right: 7px; font-family: 'JetBrains Mono', monospace; font-size: 10px; }\n  .micro-badge.orange { color: #190c04; background: var(--engine-played); }\n  .micro-badge.green { color: #07140a; background: var(--engine-best); }\n  .side-note { padding: 13px 16px; display: flex; align-items: center; justify-content: space-between; gap: 15px; border-color: rgba(138,43,226,.35); }\n  .side-note::after { content: ''; width: 6px; height: 6px; background: var(--accent-purple); box-shadow: 0 0 12px rgba(138,43,226,.9); flex-shrink: 0; }\n  .side-note p { color: var(--muted); font-size: 11px; line-height: 1.4; margin: 0; }\n  .side-note strong { color: var(--text); }\n\n  .scorebar { min-height: 50px; border: 1px solid var(--line); border-bottom: 0; background: rgba(31,40,51,.72); display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr; align-items: center; }\n  .score-item { height: 28px; padding: 0 17px; border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; gap: 3px; }\n  .score-item:last-child { border-right: 0; }\n  .score-label { color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: .14em; text-transform: uppercase; }\n  .score-value { color: var(--text); font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; }\n  .score-value.cyan { color: var(--cyan); }\n  .score-value.green { color: var(--engine-best); }\n  .board-shell { display: flex; align-items: stretch; border: 1px solid rgba(102,252,241,.24); border-top: 0; background: rgba(18,24,32,.5); position: relative; }\n  .eval-ruler { width: 24px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 4px 0; border-right: 1px solid var(--line); color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 8px; }\n  .eval-ruler .zero { color: var(--cyan); }\n  .board-wrap { width: var(--board-size); aspect-ratio: 1; position: relative; flex-shrink: 0; padding: 14px; }\n  .board-wrap::before { content: ''; position: absolute; inset: 7px; border: 1px solid rgba(102,252,241,.28); pointer-events: none; }\n  .board-wrap::after { content: ''; position: absolute; inset: 2px; border: 1px solid rgba(138,43,226,.28); pointer-events: none; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 14px, 14px 0); }\n  .board {\n    width: 100%; height: 100%; display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr); position: relative; overflow: hidden;\n    border: 2px solid rgba(245,248,250,.72); box-shadow: 0 0 0 1px rgba(102,252,241,.26), 0 22px 44px rgba(0,0,0,.45);\n  }\n  .square { position: relative; display: grid; place-items: center; }\n  .square.light { background: var(--board-light); }\n  .square.dark { background: var(--board-dark); }\n  .square.last::after { content: ''; position: absolute; inset: 0; background: rgba(102,252,241,.28); box-shadow: inset 0 0 0 3px rgba(102,252,241,.72); pointer-events: none; }\n  .square.target::after { content: ''; position: absolute; width: 24%; aspect-ratio: 1; border-radius: 50%; background: rgba(102,252,241,.84); box-shadow: 0 0 14px rgba(102,252,241,.8); pointer-events: none; }\n  .coord { position: absolute; z-index: 2; font-family: 'JetBrains Mono', monospace; font-size: clamp(8px, .72vw, 11px); font-weight: 600; line-height: 1; opacity: .74; pointer-events: none; }\n  .file { right: 6px; bottom: 5px; }\n  .rank { left: 6px; top: 5px; }\n  .light .coord { color: var(--board-dark); }\n  .dark .coord { color: var(--board-light); }\n  .piece {\n    position: relative; z-index: 3; width: 76%; height: 76%; padding: 0; background: transparent; cursor: pointer; display: grid; place-items: center;\n    font-family: Georgia, 'Times New Roman', serif; font-size: clamp(42px, 5.3vw, 82px); line-height: 1; transition: all .3s ease-in-out;\n  }\n  .piece.white { color: #F7FBFF; text-shadow: 0 2px 0 #7F9599, 0 3px 7px rgba(0,0,0,.55); }\n  .piece.black { color: #11191B; text-shadow: 0 1px 0 rgba(255,255,255,.25), 0 4px 7px rgba(0,0,0,.6); }\n  .piece:hover, .piece:focus-visible { transform: translateY(-1px); box-shadow: var(--piece-glow); outline: none; filter: brightness(1.1); }\n  .piece.selected { filter: drop-shadow(0 0 8px rgba(102,252,241,.95)); }\n  .board-overlay { position: absolute; inset: 14px; pointer-events: none; z-index: 4; }\n  .board-overlay svg { width: 100%; height: 100%; overflow: visible; }\n  .board-overlay .arrow-best { stroke: var(--engine-best); stroke-width: .1; opacity: .92; filter: drop-shadow(0 0 4px rgba(34,197,94,.75)); }\n  .board-overlay .arrow-played { stroke: var(--engine-played); stroke-width: .08; stroke-dasharray: .16 .11; opacity: .9; }\n  .tactical-dot { position: absolute; width: 6px; height: 6px; background: var(--accent-purple); box-shadow: 0 0 11px rgba(138,43,226,.9); z-index: 5; }\n  .dot-a { top: 10%; right: 13%; } .dot-b { top: 39%; left: 8%; } .dot-c { bottom: 12%; right: 29%; }\n  .board-caption { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px 0 38px; color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .08em; }\n  .board-caption span:last-child { color: var(--cyan); }\n\n  .history-rail { margin-top: 22px; padding: 16px 18px 17px; clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px)); animation: panel-in 600ms var(--motion-panel-ease) 160ms both; }\n  .history-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; }\n  .history-title { display: flex; align-items: center; gap: 9px; font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n  .history-title::before { content: ''; width: 8px; height: 8px; border: 1px solid var(--cyan); background: rgba(102,252,241,.16); }\n  .history-meta { color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 9px; }\n  .move-list { display: flex; gap: 3px; overflow-x: auto; padding-bottom: 2px; scrollbar-color: var(--slate-2) transparent; }\n  .move-group { display: flex; align-items: stretch; flex-shrink: 0; border: 1px solid var(--line); background: rgba(11,12,16,.34); }\n  .move-number { padding: 11px 9px; color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 10px; border-right: 1px solid var(--line); }\n  .move {\n    min-width: 74px; padding: 10px 11px; background: transparent; color: var(--muted); cursor: pointer; text-align: left;\n    font-family: 'JetBrains Mono', monospace; font-size: 11px; position: relative; transition: all .3s ease-in-out;\n  }\n  .move:hover, .move:focus-visible { color: var(--text); box-shadow: var(--piece-glow); outline: none; }\n  .move.current { color: var(--text); background: rgba(102,252,241,.14); box-shadow: inset 0 -2px 0 var(--cyan); }\n  .move .quality { font-size: 9px; margin-left: 4px; }\n  .quality.brilliant { color: var(--quality-brilliant); } .quality.best { color: var(--quality-best); } .quality.inaccuracy { color: var(--quality-inaccuracy); } .quality.blunder { color: var(--quality-blunder); }\n  .history-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; color: var(--faint); font-family: 'JetBrains Mono', monospace; font-size: 9px; }\n  .history-foot .cursor { color: var(--cyan); }\n  .key-hint { display: inline-flex; gap: 5px; align-items: center; }\n  kbd { padding: 2px 5px; border: 1px solid var(--line); color: var(--muted); background: var(--bg); font-size: 8px; }\n\n  @keyframes panel-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }\n  @keyframes pulse-line { 0%,100% { opacity: .45; } 50% { opacity: 1; } }\n  .analysis-pulse { animation: pulse-line 2.3s ease-in-out infinite; }\n\n  @media (max-width: 1250px) and (min-width: 901px) {\n    .arena-grid { grid-template-columns: minmax(310px, 350px) minmax(var(--board-size), var(--board-size)); gap: 20px; }\n    .content { padding-inline: 24px; }\n    .board-column { min-width: var(--board-size); }\n    .coach-sheet { padding-inline: 18px; }\n    .coach-quote { font-size: 18px; }\n  }\n  @media (max-width: 900px) {\n    body { overflow-x: hidden; }\n    .topbar { padding-inline: 16px; height: 68px; }\n    .brand-lockup { min-width: auto; }\n    .brand-sub, .profile-status { display: none; }\n    .profile-chip { min-width: auto; }\n    .nav-tabs { gap: 16px; }\n    .content { padding: 26px 12px 36px; }\n    .view-kicker { margin-bottom: 13px; }\n    .arena-grid { display: flex; flex-direction: column; gap: 18px; }\n    .board-column { order: 1; width: 100%; min-width: 0; }\n    .coach-column { order: 2; width: 100%; }\n    .scorebar { grid-template-columns: 1.2fr 1fr 1fr; }\n    .score-item:nth-child(4) { display: none; }\n    .board-shell { width: 100%; }\n    .board-wrap { width: calc(100vw - 60px); max-width: none; min-width: 0; padding: 10px; }\n    .board-overlay { inset: 10px; }\n    .board-caption { padding-left: 32px; }\n    .history-rail { margin-top: 18px; }\n  }\n  @media (max-width: 520px) {\n    .brand-name { font-size: 11px; letter-spacing: .1em; }\n    .nav-tabs { gap: 11px; }\n    .nav-tab { font-size: 10px; letter-spacing: .05em; }\n    .score-item { padding-inline: 9px; }\n    .score-label { font-size: 7px; letter-spacing: .08em; }\n    .score-value { font-size: 10px; }\n    .eval-ruler { width: 19px; font-size: 7px; }\n    .board-wrap { width: calc(100vw - 43px); padding: 6px; }\n    .board-overlay { inset: 6px; }\n    .piece { font-size: clamp(32px, 12vw, 54px); }\n    .coach-sheet { padding: 19px 16px 17px; }\n    .coach-quote { font-size: 18px; }\n    .compare-row { grid-template-columns: 90px 1fr 40px; }\n  }\n</style>\n<div class=\"app-shell\" data-kid=\"1\">\n    <header class=\"topbar\" data-kid=\"1-1\">\n        <div class=\"brand-lockup\" data-kid=\"1-1-1\">\n            <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                ♞\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\">\n                    CHESS / TRAINER\n                </div>\n                <div class=\"brand-sub\" data-kid=\"1-1-1-2-2\">\n                    TACTICAL COACHING SYSTEM\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Navigation principale\" class=\"nav-tabs\" data-kid=\"1-1-2\">\n            <button aria-current=\"page\" class=\"nav-tab active\" data-kid=\"1-1-2-1\" type=\"button\">\n                Jouer\n            </button>\n            <button class=\"nav-tab\" data-kid=\"1-1-2-2\" type=\"button\">\n                Apprendre\n            </button>\n        </nav>\n        <div class=\"profile-chip\" data-kid=\"1-1-3\">\n            <div class=\"profile-status\" data-kid=\"1-1-3-1\">\n                <div class=\"profile-name\" data-kid=\"1-1-3-1-1\">\n                    Alexandre M.\n                </div>\n                <div class=\"profile-level\" data-kid=\"1-1-3-1-2\">\n                    NIVEAU 07 · 2 480 XP\n                </div>\n            </div>\n            <div aria-label=\"Profil Alexandre M.\" class=\"avatar\" data-kid=\"1-1-3-2\">\n                AM\n            </div>\n        </div>\n    </header>\n    <main class=\"content\" data-kid=\"1-2\">\n        <div class=\"view-kicker\" data-kid=\"1-2-1\">\n            <div class=\"eyebrow\" data-kid=\"1-2-1-1\">\n                Jouer · Revue tactique\n            </div>\n            <div class=\"session-tag\" data-kid=\"1-2-1-2\">\n                SESSION 04 / CLASSIQUE · 12:48\n            </div>\n        </div>\n        <section aria-label=\"Arène de jeu et coaching\" class=\"arena-grid\" data-kid=\"1-2-2\">\n            <aside class=\"coach-column\" data-kid=\"1-2-2-1\">\n                <section aria-labelledby=\"coach-title\" class=\"coach-sheet\" data-kid=\"1-2-2-1-1\">\n                    <div class=\"sheet-tab\" data-kid=\"1-2-2-1-1-1\">\n                        CONSIGNE / 018\n                    </div>\n                    <div class=\"sheet-top\" data-kid=\"1-2-2-1-1-2\">\n                        <div class=\"label\" data-kid=\"1-2-2-1-1-2-1\" id=\"coach-title\">\n                            Lecture du coach\n                        </div>\n                        <div class=\"sheet-id\" data-kid=\"1-2-2-1-1-2-2\">\n                            FEN · 18...h6\n                        </div>\n                    </div>\n                    <div class=\"quality-row\" data-kid=\"1-2-2-1-1-3\">\n                        <div aria-label=\"Brillant\" class=\"quality-mark\" data-kid=\"1-2-2-1-1-3-1\">\n                            !!\n                        </div>\n                        <div class=\"quality-copy\" data-kid=\"1-2-2-1-1-3-2\">\n                            <strong data-kid=\"1-2-2-1-1-3-2-1\">\n                                Brillant\n                            </strong>\n                            <span data-kid=\"1-2-2-1-1-3-2-2\">\n                                Sacrifice positionnel · +0.62\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"coach-quote\" data-kid=\"1-2-2-1-1-4\">\n                        Tu as ouvert la diagonale avant que ton adversaire ne puisse verrouiller son roi.\n                    </p>\n                    <p class=\"coach-detail\" data-kid=\"1-2-2-1-1-5\">\n                        Le pion h6 détourne le défenseur et prépare la pression sur f7. La suite reste gagnante si tu gardes la pièce active.\n                    </p>\n                    <div class=\"tactic-line\" data-kid=\"1-2-2-1-1-6\">\n                        Motif détecté · Attaque à la découverte\n                    </div>\n                    <button aria-label=\"Rejouer et analyser le coup\" class=\"primary-action\" data-kid=\"1-2-2-1-1-7\" type=\"button\">\n                        <span data-kid=\"1-2-2-1-1-7-1\">\n                            Rejouer / Analyser\n                        </span>\n                        <span class=\"action-arrow\" data-kid=\"1-2-2-1-1-7-2\">\n                            ↗\n                        </span>\n                    </button>\n                </section>\n                <section aria-label=\"Comparaison du coup joué et de la meilleure ligne\" class=\"compare-sheet\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"compare-header\" data-kid=\"1-2-2-1-2-1\">\n                        <div class=\"label\" data-kid=\"1-2-2-1-2-1-1\">\n                            Comparatif moteur\n                        </div>\n                        <div class=\"engine-state analysis-pulse\" data-kid=\"1-2-2-1-2-1-2\">\n                            ● ANALYSE ACTIVE\n                        </div>\n                    </div>\n                    <div class=\"compare-row played\" data-kid=\"1-2-2-1-2-2\">\n                        <div class=\"row-label\" data-kid=\"1-2-2-1-2-2-1\">\n                            Coup joué\n                        </div>\n                        <div class=\"move-code\" data-kid=\"1-2-2-1-2-2-2\">\n                            <span class=\"micro-badge orange\" data-kid=\"1-2-2-1-2-2-2-1\">\n                                18.\n                            </span>\n                            h6\n                        </div>\n                        <div class=\"eval\" data-kid=\"1-2-2-1-2-2-3\">\n                            +0.62\n                        </div>\n                    </div>\n                    <div class=\"compare-row best\" data-kid=\"1-2-2-1-2-3\">\n                        <div class=\"row-label\" data-kid=\"1-2-2-1-2-3-1\">\n                            Meilleure ligne\n                        </div>\n                        <div class=\"move-code\" data-kid=\"1-2-2-1-2-3-2\">\n                            <span class=\"micro-badge green\" data-kid=\"1-2-2-1-2-3-2-1\">\n                                ★\n                            </span>\n                            h6!\n                        </div>\n                        <div class=\"eval\" data-kid=\"1-2-2-1-2-3-3\">\n                            +0.62\n                        </div>\n                    </div>\n                </section>\n                <div class=\"side-note\" data-kid=\"1-2-2-1-3\">\n                    <p data-kid=\"1-2-2-1-3-1\">\n                        <strong data-kid=\"1-2-2-1-3-1-1\">\n                            Indice :\n                        </strong>\n                        regarde la case f7 avant de calculer ta variante.\n                    </p>\n                </div>\n            </aside>\n            <section aria-label=\"Échiquier de la position courante\" class=\"board-column\" data-kid=\"1-2-2-2\">\n                <div class=\"scorebar\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"score-item\" data-kid=\"1-2-2-2-1-1\">\n                        <span class=\"score-label\" data-kid=\"1-2-2-2-1-1-1\">\n                            Position\n                        </span>\n                        <span class=\"score-value cyan\" data-kid=\"1-2-2-2-1-1-2\">\n                            Trait aux Blancs\n                        </span>\n                    </div>\n                    <div class=\"score-item\" data-kid=\"1-2-2-2-1-2\">\n                        <span class=\"score-label\" data-kid=\"1-2-2-2-1-2-1\">\n                            Coup\n                        </span>\n                        <span class=\"score-value\" data-kid=\"1-2-2-2-1-2-2\">\n                            18 / 32\n                        </span>\n                    </div>\n                    <div class=\"score-item\" data-kid=\"1-2-2-2-1-3\">\n                        <span class=\"score-label\" data-kid=\"1-2-2-2-1-3-1\">\n                            Évaluation\n                        </span>\n                        <span class=\"score-value green\" data-kid=\"1-2-2-2-1-3-2\">\n                            +0.62\n                        </span>\n                    </div>\n                    <div class=\"score-item\" data-kid=\"1-2-2-2-1-4\">\n                        <span class=\"score-label\" data-kid=\"1-2-2-2-1-4-1\">\n                            Phase\n                        </span>\n                        <span class=\"score-value\" data-kid=\"1-2-2-2-1-4-2\">\n                            Milieu de partie\n                        </span>\n                    </div>\n                </div>\n                <div class=\"board-shell\" data-kid=\"1-2-2-2-2\">\n                    <div aria-label=\"Échelle d'évaluation\" class=\"eval-ruler\" data-kid=\"1-2-2-2-2-1\">\n                        <span data-kid=\"1-2-2-2-2-1-1\">\n                            +3\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-1-2\">\n                            +2\n                        </span>\n                        <span class=\"zero\" data-kid=\"1-2-2-2-2-1-3\">\n                            0\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-1-4\">\n                            -2\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-1-5\">\n                            -3\n                        </span>\n                    </div>\n                    <div class=\"board-wrap\" data-kid=\"1-2-2-2-2-2\">\n                        <div aria-label=\"Échiquier interactif\" class=\"board\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"interactive chessboard\" data-reason=\"squares and pieces rendered by script\" id=\"board\">\n                        </div>\n                        <div aria-hidden=\"true\" class=\"board-overlay\" data-kid=\"1-2-2-2-2-2-2\">\n                            <svg data-kid=\"1-2-2-2-2-2-2-1\" preserveaspectratio=\"none\" viewbox=\"0 0 8 8\">\n                                <defs>\n                                    <marker id=\"arrowGreen\" markerheight=\".28\" markerunits=\"strokeWidth\" markerwidth=\".28\" orient=\"auto\" refx=\".2\" refy=\".14\">\n                                        <path d=\"M0,0 L.28,.14 L0,.28 z\" fill=\"var(--engine-best)\">\n                                        </path>\n                                    </marker>\n                                    <marker id=\"arrowOrange\" markerheight=\".28\" markerunits=\"strokeWidth\" markerwidth=\".28\" orient=\"auto\" refx=\".2\" refy=\".14\">\n                                        <path d=\"M0,0 L.28,.14 L0,.28 z\" fill=\"var(--engine-played)\">\n                                        </path>\n                                    </marker>\n                                </defs>\n                                <line class=\"arrow-best\" marker-end=\"url(#arrowGreen)\" x1=\"5.5\" x2=\"5.5\" y1=\"5.5\" y2=\"3.5\">\n                                </line>\n                                <line class=\"arrow-played\" marker-end=\"url(#arrowOrange)\" x1=\"5.5\" x2=\"4.5\" y1=\"5.5\" y2=\"4.5\">\n                                </line>\n                            </svg>\n                            <span class=\"tactical-dot dot-a\" data-kid=\"1-2-2-2-2-2-2-2\">\n                            </span>\n                            <span class=\"tactical-dot dot-b\" data-kid=\"1-2-2-2-2-2-2-3\">\n                            </span>\n                            <span class=\"tactical-dot dot-c\" data-kid=\"1-2-2-2-2-2-2-4\">\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"board-caption\" data-kid=\"1-2-2-2-3\">\n                    <span data-kid=\"1-2-2-2-3-1\">\n                        Position courante · 18. h6\n                    </span>\n                    <span data-kid=\"1-2-2-2-3-2\">\n                        ↗ ligne candidate affichée\n                    </span>\n                </div>\n            </section>\n        </section>\n        <section aria-label=\"Historique tactique de la partie\" class=\"history-rail\" data-kid=\"1-2-3\">\n            <div class=\"history-head\" data-kid=\"1-2-3-1\">\n                <div class=\"history-title\" data-kid=\"1-2-3-1-1\">\n                    Historique tactique\n                </div>\n                <div class=\"history-meta\" data-kid=\"1-2-3-1-2\">\n                    BLANCS · 18e COUP SÉLECTIONNÉ\n                </div>\n            </div>\n            <div class=\"move-list\" data-dynamic=\"true\" data-kid=\"1-2-3-2\" data-name=\"move list container\" data-reason=\"moves rendered or updated by script\" id=\"move-list\">\n                <div class=\"move-group\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-1-1\">\n                        14\n                    </span>\n                    <button class=\"move\" data-kid=\"1-2-3-2-1-2\" type=\"button\">\n                        Nf3\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-1-3\" type=\"button\">\n                        d5\n                    </button>\n                </div>\n                <div class=\"move-group\" data-kid=\"1-2-3-2-2\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-2-1\">\n                        15\n                    </span>\n                    <button class=\"move\" data-kid=\"1-2-3-2-2-2\" type=\"button\">\n                        Bg5\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-2-3\" type=\"button\">\n                        Be7\n                    </button>\n                </div>\n                <div class=\"move-group\" data-kid=\"1-2-3-2-3\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-3-1\">\n                        16\n                    </span>\n                    <button class=\"move\" data-kid=\"1-2-3-2-3-2\" type=\"button\">\n                        O-O\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-3-3\" type=\"button\">\n                        O-O\n                    </button>\n                </div>\n                <div class=\"move-group\" data-kid=\"1-2-3-2-4\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-4-1\">\n                        17\n                    </span>\n                    <button class=\"move\" data-kid=\"1-2-3-2-4-2\" type=\"button\">\n                        Re1\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-4-3\" type=\"button\">\n                        Qc7\n                    </button>\n                </div>\n                <div class=\"move-group\" data-kid=\"1-2-3-2-5\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-5-1\">\n                        18\n                    </span>\n                    <button aria-current=\"true\" class=\"move current\" data-kid=\"1-2-3-2-5-2\" type=\"button\">\n                        h6\n                        <span class=\"quality brilliant\" data-kid=\"1-2-3-2-5-2-1\">\n                            !!\n                        </span>\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-5-3\" type=\"button\">\n                        hxg5\n                    </button>\n                </div>\n                <div class=\"move-group\" data-kid=\"1-2-3-2-6\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-6-1\">\n                        19\n                    </span>\n                    <button class=\"move\" data-kid=\"1-2-3-2-6-2\" type=\"button\">\n                        Bxf6\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-6-3\" type=\"button\">\n                        Bxf6\n                    </button>\n                </div>\n                <div class=\"move-group\" data-kid=\"1-2-3-2-7\">\n                    <span class=\"move-number\" data-kid=\"1-2-3-2-7-1\">\n                        20\n                    </span>\n                    <button class=\"move\" data-kid=\"1-2-3-2-7-2\" type=\"button\">\n                        Qd3\n                    </button>\n                    <button class=\"move\" data-kid=\"1-2-3-2-7-3\" type=\"button\">\n                        g6\n                    </button>\n                </div>\n            </div>\n            <div class=\"history-foot\" data-kid=\"1-2-3-3\">\n                <span class=\"cursor\" data-kid=\"1-2-3-3-1\">\n                    ◀ Position 18 / 32 ▶\n                </span>\n                <span class=\"key-hint\" data-kid=\"1-2-3-3-2\">\n                    Naviguer\n                    <kbd data-kid=\"1-2-3-3-2-1\">\n                        ←\n                    </kbd>\n                    <kbd data-kid=\"1-2-3-3-2-2\">\n                        →\n                    </kbd>\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n<script>\n    const board = document.getElementById('board');\n  const files = ['a','b','c','d','e','f','g','h'];\n  const ranks = [8,7,6,5,4,3,2,1];\n  const pieces = {\n    a8:['♜','black'], b8:['♞','black'], c8:['♝','black'], d8:['♛','black'], e8:['♚','black'], f8:['♝','black'], g8:['♞','black'], h8:['♜','black'],\n    a7:['♟','black'], b7:['♟','black'], c7:['♟','black'], d7:['♟','black'], e7:['♟','black'], f7:['♟','black'], g7:['♟','black'], h7:['♟','black'],\n    a6:['',''], b6:['',''], c6:['',''], d6:['',''], e6:['',''], f6:['',''], g6:['♟','black'], h6:['',''],\n    a5:['',''], b5:['',''], c5:['',''], d5:['',''], e5:['',''], f5:['',''], g5:['',''], h5:['',''],\n    a4:['',''], b4:['',''], c4:['',''], d4:['',''], e4:['',''], f4:['',''], g4:['',''], h4:['',''],\n    a3:['',''], b3:['',''], c3:['',''], d3:['',''], e3:['',''], f3:['♘','white'], g3:['',''], h3:['',''],\n    a2:['♙','white'], b2:['♙','white'], c2:['♙','white'], d2:['♙','white'], e2:['♙','white'], f2:['♙','white'], g2:['♙','white'], h2:['♙','white'],\n    a1:['♖','white'], b1:['♘','white'], c1:['♗','white'], d1:['♕','white'], e1:['♔','white'], f1:['♗','white'], g1:['♘','white'], h1:['♖','white']\n  };\n  ranks.forEach((rank, row) => files.forEach((file, col) => {\n    const squareName = file + rank;\n    const square = document.createElement('div');\n    square.className = 'square ' + ((row + col) % 2 === 0 ? 'light' : 'dark');\n    square.dataset.square = squareName;\n    if (squareName === 'f3') square.classList.add('last');\n    if (squareName === 'f5') square.classList.add('target');\n    if (col === 0) {\n      const rankLabel = document.createElement('span'); rankLabel.className = 'coord rank'; rankLabel.textContent = rank; square.appendChild(rankLabel);\n    }\n    if (row === 7) {\n      const fileLabel = document.createElement('span'); fileLabel.className = 'coord file'; fileLabel.textContent = file; square.appendChild(fileLabel);\n    }\n    const piece = pieces[squareName];\n    if (piece && piece[0]) {\n      const button = document.createElement('button');\n      button.className = 'piece ' + piece[1]; button.type = 'button'; button.textContent = piece[0]; button.setAttribute('aria-label', piece[1] + ' ' + squareName);\n      button.addEventListener('click', () => { document.querySelectorAll('.piece.selected').forEach((node) => node.classList.remove('selected')); button.classList.add('selected'); });\n      square.appendChild(button);\n    }\n    board.appendChild(square);\n  }));\n  document.querySelectorAll('.move').forEach((move) => move.addEventListener('click', () => {\n    document.querySelectorAll('.move.current').forEach((node) => node.classList.remove('current'));\n    move.classList.add('current');\n  }));\n  document.querySelectorAll('.nav-tab').forEach((tab) => tab.addEventListener('click', () => {\n    document.querySelectorAll('.nav-tab.active').forEach((node) => node.classList.remove('active'));\n    tab.classList.add('active');\n  }));\n</script>\n",
