    <div class=\"engine-choice\" data-kid=\"1-2-3-2-5-2-3\">\n                            <span data-kid=\"1-2-3-2-5-2-3-1\">\n                                18. a3 Fe6 19. b4\n                            </span>\n                            <small data-kid=\"1-2-3-2-5-2-3-2\">\n                                +0,28 · 3\n                            </small>\n                        </div>\n                    </div>\n                    <div class=\"footer-status\" data-kid=\"1-2-3-2-5-3\" data-name=\"analysis engine status label\">\n                        Analyse stable · profondeur 22\n                    </div>\n                </section>\n            </aside>\n        </section>\n    </main>\n</div>\n<script>\n    (function () {\n    var board = document.getElementById('chessboard');\n    if (board) {\n      var files = ['a','b','c','d','e','f','g','h'];\n      var ranks = ['8','7','6','5','4','3','2','1'];\n      var pieces = {\n        a8:['♜','black'], c8:['♝','black'], d8:['♛','black'], f8:['♝','black'], g8:['♞','black'], h8:['♜','black'],\n        a7:['♟','black'], b7:['♟','black'], d7:['♟','black'], e7:['♟','black'], f7:['♟','black'], g7:['♟','black'], h7:['♟','black'],\n        c6:['♞','black'], e5:['♟','black'],\n        a1:['♖','white'], b1:['♘','white'], c1:['♗','white'], d1:['♕','white'], f1:['♗','white'], h1:['♖','white'],\n        a2:['♙','white'], b2:['♙','white'], c2:['♙','white'], d4:['♙','white'], e4:['♙','white'], f2:['♙','white'], g2:['♙','white'],\n        e2:['♘','white'], g1:['♘','white'], h3:['♙','white'],\n        e1:['♔','white']\n      };\n      for (var r = 0; r < ranks.length; r += 1) {\n        for (var c = 0; c < files.length; c += 1) {\n          var squareName = files[c] + ranks[r];\n          var cell = document.createElement('div');\n          cell.className = 'square ' + ((r + c) % 2 === 0 ? 'light' : 'dark');\n          cell.setAttribute('data-square', squareName);\n          if (squareName === 'h2' || squareName === 'h3') cell.classList.add('last-move');\n          if (squareName === 'h3') cell.classList.add('selected');\n          if (c === 0) {\n            var rankLabel = document.createElement('span');\n            rankLabel.className = 'coord-rank';\n            rankLabel.textContent = ranks[r];\n            cell.appendChild(rankLabel);\n          }\n          if (r === 7) {\n            var fileLabel = document.createElement('span');\n            fileLabel.className = 'coord-file';\n            fileLabel.textContent = files[c];\n            cell.appendChild(fileLabel);\n          }\n          if (pieces[squareName]) {\n            var piece = document.createElement('span');\n            piece.className = 'piece ' + pieces[squareName][1];\n            piece.textContent = pieces[squareName][0];\n            cell.appendChild(piece);\n          }\n          board.appendChild(cell);\n        }\n      }\n    }\n\n    var tabButtons = Array.prototype.slice.call(document.querySelectorAll('.tab-button'));\n    var panels = Array.prototype.slice.call(document.querySelectorAll('.tab-panel'));\n    var indicator = document.querySelector('.tab-indicator');\n    tabButtons.forEach(function (button, index) {\n      button.addEventListener('click', function () {\n        var target = button.getAttribute('data-tab');\n        tabButtons.forEach(function (item) {\n          var active = item === button;\n          item.classList.toggle('is-active', active);\n          item.setAttribute('aria-selected', active ? 'true' : 'false');\n        });\n        panels.forEach(function (panel) {\n          panel.classList.toggle('is-active', panel.getAttribute('data-panel') === target);\n        });\n        if (indicator) indicator.style.transform = 'translateX(' + (index * 100) + '%)';\n      });\n    });\n  }());\n</script>\n",
