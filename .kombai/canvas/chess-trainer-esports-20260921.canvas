    "var_72bf228bd77f": {
      "type": "variant",
      "label": "Playbook — Couloirs Parcours",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3095,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"learn-canvas\" data-kid=\"1\" data-name=\"learning dashboard main container\">\n    <style>\n        :root {\n      --bg-obsidian: #0B0C10;\n      --bg-slate: #1F2833;\n      --bg-slate-2: #151B23;\n      --ink: #F7F9FB;\n      --muted: #8D98A8;\n      --muted-2: #5C6878;\n      --rule: #34404F;\n      --cyan: #66FCF1;\n      --cyan-soft: rgba(102, 252, 241, .12);\n      --purple: #8A2BE2;\n      --accent-purple: #8A2BE2;\n      --bronze: #C2793A;\n      --silver: #B6C2D1;\n      --gold: #EAB308;\n      --quality-brilliant: #1BAAA6;\n      --quality-best: #98BC49;\n      --quality-blunder: #C93230;\n      --motion-tab-duration: 260ms;\n      --motion-hover-duration: 300ms;\n      --motion-panel-ease: cubic-bezier(.22, 1, .36, 1);\n      --piece-glow: 0 0 15px rgba(102, 252, 241, .6);\n    }\n\n    .learn-canvas {\n      width: 100%;\n      min-height: 100%;\n      box-sizing: border-box;\n      background: var(--bg-obsidian);\n      color: var(--ink);\n      font-family: \"Geist\", \"Inter\", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      padding: 26px 42px 56px;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .learn-canvas::before,\n    .learn-canvas::after {\n      content: \"\";\n      position: absolute;\n      pointer-events: none;\n      opacity: .55;\n    }\n\n    .learn-canvas::before {\n      width: 2px;\n      height: 2px;\n      left: 5.8%;\n      top: 20%;\n      background: var(--cyan);\n      box-shadow: 73px 24px 0 rgba(102,252,241,.42), 211px 146px 0 rgba(138,43,226,.55), 390px -82px 0 rgba(102,252,241,.32), 812px 117px 0 rgba(138,43,226,.36), 1120px -44px 0 rgba(102,252,241,.3), 1230px 306px 0 rgba(138,43,226,.48);\n    }\n\n    .learn-canvas::after {\n      right: 5%;\n      top: 0;\n      width: 1px;\n      height: 340px;\n      background: var(--cyan);\n      box-shadow: 0 0 18px rgba(102,252,241,.45);\n      opacity: .2;\n    }\n\n    .topbar {\n      max-width: 1450px;\n      margin: 0 auto;\n      height: 64px;\n      display: grid;\n      grid-template-columns: 230px 1fr auto;\n      align-items: center;\n      border-bottom: 1px solid var(--rule);\n      position: relative;\n      z-index: 1;\n    }\n\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      min-width: 0;\n    }\n\n    .brand-mark {\n      width: 30px;\n      height: 30px;\n      display: grid;\n      place-items: center;\n      border: 1px solid var(--cyan);\n      color: var(--cyan);\n      background: var(--bg-slate-2);\n      clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 100%, 0 100%);\n      box-shadow: 0 0 14px rgba(102,252,241,.16);\n    }\n\n    .brand-mark svg { width: 18px; height: 18px; }\n\n    .brand-title {\n      font-size: 11px;\n      letter-spacing: .16em;\n      font-weight: 800;\n      white-space: nowrap;\n    }\n\n    .brand-subtitle {\n      margin-top: 3px;\n      font-family: \"Geist Mono\", ui-monospace, monospace;\n      color: var(--muted-2);\n      font-size: 8px;\n      letter-spacing: .12em;\n      white-space: nowrap;\n    }\n\n    .main-nav {\n      display: flex;\n      align-items: stretch;\n      gap: 26px;\n      align-self: stretch;\n      justify-self: center;\n    }\n\n    .nav-tab {\n      border: 0;\n      background: transparent;\n      color: var(--muted);\n      font: inherit;\n      font-size: 12px;\n      font-weight: 650;\n      padding: 0 2px;\n      position: relative;\n      cursor: pointer;\n      transition: all var(--motion-hover-duration) ease-in-out;\n    }\n\n    .nav-tab::after {\n      content: \"\";\n      position: absolute;\n      height: 2px;\n      left: 0;\n      right: 0;\n      bottom: -1px;\n      background: transparent;\n      transform: scaleX(0);\n      transform-origin: left;\n      transition: transform var(--motion-tab-duration) var(--motion-panel-ease), background var(--motion-tab-duration) ease;\n    }\n\n    .nav-tab:hover,\n    .nav-tab:focus-visible { color: var(--ink); text-shadow: 0 0 12px rgba(102,252,241,.38); outline: none; }\n    .nav-tab.active { color: var(--ink); }\n    .nav-tab.active::after { background: var(--cyan); transform: scaleX(1); box-shadow: 0 0 12px rgba(102,252,241,.7); }\n\n    .header-status {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n      color: var(--muted);\n      font-family: \"Geist Mono\", ui-monospace, monospace;\n      font-size: 9px;\n      letter-spacing: .1em;\n      white-space: nowrap;\n    }\n\n    .status-dot {\n      display: inline-block;\n      width: 6px;\n      height: 6px;\n      margin-right: 7px;\n      background: var(--cyan);\n      border-radius: 50%;\n      box-shadow: 0 0 9px rgba(102,252,241,.8);\n    }\n\n    .profile-chip {\n      width: 28px;\n      height: 28px;\n      display: grid;\n      place-items: center;\n      border: 1px solid #4B5867;\n      color: var(--ink);\n      background: var(--bg-slate);\n      font-size: 10px;\n      letter-spacing: .08em;\n      clip-path: polygon(0 0, 100% 0, 100% 75%, 75% 100%, 0 100%);\n    }\n\n    .page-frame {\n      max-width: 1450px;\n      margin: 0 auto;\n      position: relative;\n      z-index: 1;\n    }\n\n    .page-intro {\n      display: flex;\n      justify-content: space-between;\n      gap: 32px;\n      padding: 42px 0 28px;\n      border-bottom: 1px solid var(--rule);\n    }\n\n    .eyebrow,\n    .section-label,\n    .mission-label,\n    .tier-index,\n    .lesson-meta,\n    .lesson-footer,\n    .level-caption,\n    .level-xp,\n    .level-up small,\n    .quality-key,\n    .quality-label,\n    .page-note {\n      font-family: \"Geist Mono\", ui-monospace, monospace;\n      text-transform: uppercase;\n      letter-spacing: .12em;\n    }\n\n    .eyebrow {\n      color: var(--cyan);\n      font-size: 9px;\n      margin: 0 0 13px;\n    }\n\n    h1, h2, h3, p { margin: 0; }\n\n    h1 {\n      font-size: clamp(28px, 3.2vw, 45px);\n      line-height: 1.03;\n      letter-spacing: -.045em;\n      font-weight: 760;\n      max-width: 650px;\n    }\n\n    .intro-copy {\n      color: var(--muted);\n      font-size: 13px;\n      line-height: 1.6;\n      max-width: 520px;\n      margin-top: 14px;\n    }\n\n    .quality-notation {\n      display: flex;\n      align-items: end;\n      gap: 18px;\n      padding-bottom: 4px;\n      flex-shrink: 0;\n    }\n\n    .quality-item {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      column-gap: 7px;\n      align-items: center;\n      color: var(--muted);\n      min-width: 72px;\n    }\n\n    .quality-key {\n      grid-row: span 2;\n      font-weight: 800;\n      font-size: 18px;\n      line-height: 1;\n    }\n\n    .quality-item.brilliant .quality-key { color: var(--quality-brilliant); text-shadow: 0 0 11px rgba(27,170,166,.55); }\n    .quality-item.best .quality-key { color: var(--quality-best); text-shadow: 0 0 11px rgba(152,188,73,.55); }\n    .quality-item.blunder .quality-key { color: var(--quality-blunder); text-shadow: 0 0 11px rgba(201,50,48,.5); }\n\n    .quality-label { font-size: 8px; color: var(--muted-2); }\n    .quality-caption { font-size: 10px; color: var(--ink); margin-top: 2px; }\n\n    .mission-strip {\n      min-height: 98px;\n      display: grid;\n      grid-template-columns: 170px 1fr auto;\n      align-items: stretch;\n      margin-top: 24px;\n      background: var(--bg-slate-2);\n      border: 1px solid #465466;\n      clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);\n      transition: all var(--motion-hover-duration) ease-in-out;\n    }\n\n    .mission-strip:hover,\n    .mission-strip:focus-within { border-color: var(--cyan); box-shadow: var(--piece-glow); }\n\n    .mission-tag {\n      padding: 22px 20px;\n      border-right: 1px solid var(--rule);\n      color: var(--cyan);\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      background: rgba(102,252,241,.035);\n    }\n\n    .mission-label { font-size: 9px; font-weight: 700; }\n    .mission-number { font-family: \"Geist Mono\", ui-monospace, monospace; font-size: 11px; color: var(--muted); }\n\n    .mission-content {\n      padding: 18px 26px;\n      display: grid;\n      grid-template-columns: minmax(240px, 1fr) 330px;\n      align-items: center;\n      gap: 30px;\n    }\n\n    .mission-content h2 { font-size: 19px; letter-spacing: -.02em; font-weight: 700; }\n    .mission-content p { color: var(--muted); font-size: 12px; margin-top: 7px; }\n\n    .mission-progress-wrap { align-self: center; }\n    .mission-progress-head { display: flex; justify-content: space-between; color: var(--muted); font: 9px \"Geist Mono\", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .1em; }\n    .mission-progress-head strong { color: var(--cyan); font-weight: 700; }\n    .progress-line { height: 5px; margin-top: 9px; background: #27313D; position: relative; }\n    .progress-line span { position: absolute; inset: 0 auto 0 0; width: 68%; background: var(--cyan); box-shadow: 0 0 10px rgba(102,252,241,.45); }\n    .progress-line::after { content: \"\"; position: absolute; top: -3px; left: 68%; width: 1px; height: 11px; background: var(--purple); box-shadow: 0 0 8px rgba(138,43,226,.8); }\n\n    .primary-action {\n      align-self: center;\n      margin-right: 24px;\n      min-width: 148px;\n      border: 1px solid var(--cyan);\n      color: #061216;\n      background: var(--cyan);\n      padding: 12px 16px;\n      font: 800 11px \"Geist Mono\", ui-monospace, monospace;\n      letter-spacing: .11em;\n      text-transform: uppercase;\n      cursor: pointer;\n      clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 0 100%);\n      transition: all 0.3s ease-in-out;\n    }\n\n    .primary-action:hover,\n    .primary-action:focus-visible { box-shadow: var(--piece-glow); transform: translateY(-1px); outline: none; }\n    .primary-action:active { transform: translateY(1px); }\n    .primary-action span { font-size: 15px; margin-left: 12px; }\n\n    .level-rail {\n      min-height: 82px;\n      display: grid;\n      grid-template-columns: 150px minmax(200px, 1fr) 120px 250px;\n      align-items: center;\n      gap: 22px;\n      padding: 0 20px;\n      border-bottom: 1px solid var(--rule);\n      border-left: 1px solid var(--rule);\n      border-right: 1px solid var(--rule);\n      background: rgba(31,40,51,.34);\n    }\n\n    .level-caption { font-size: 8px; color: var(--muted-2); display: block; }\n    .level-name { display: block; margin-top: 5px; font-size: 16px; font-weight: 700; }\n    .level-track { height: 7px; background: #2A3441; position: relative; }\n    .level-track span { position: absolute; inset: 0 auto 0 0; width: 69%; background: var(--purple); box-shadow: 0 0 12px rgba(138,43,226,.5); }\n    .level-track i { position: absolute; width: 1px; height: 13px; left: 69%; top: -3px; background: var(--cyan); box-shadow: 0 0 8px rgba(102,252,241,.75); }\n    .level-track::before { content: \"NIVEAU 7\"; position: absolute; top: 13px; left: 0; color: var(--muted-2); font: 8px \"Geist Mono\", ui-monospace, monospace; letter-spacing: .08em; }\n    .level-track::after { content: \"NIVEAU 8\"; position: absolute; top: 13px; right: 0; color: var(--muted-2); font: 8px \"Geist Mono\", ui-monospace, monospace; letter-spacing: .08em; }\n\n    .level-xp { color: var(--ink); font-size: 13px; font-weight: 700; letter-spacing: .05em; white-space: nowrap; }\n    .level-xp small { color: var(--muted); font-size: 9px; font-weight: 400; }\n\n    .level-up {\n      min-height: 46px;\n      border-left: 1px solid var(--purple);\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      padding-left: 16px;\n      box-shadow: -5px 0 0 -4px rgba(138,43,226,.55);\n    }\n\n    .level-up > span { color: var(--cyan); font: 24px \"Geist Mono\", ui-monospace, monospace; text-shadow: 0 0 10px rgba(102,252,241,.6); }\n    .level-up small { display: block; color: var(--purple); font-size: 8px; font-weight: 800; }\n    .level-up strong { display: block; font-size: 12px; margin-top: 4px; font-weight: 650; }\n    .level-up b { color: var(--cyan); font: 10px \"Geist Mono\", ui-monospace, monospace; margin-left: 5px; }\n\n    .path-section { padding-top: 34px; }\n\n    .path-header {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      padding-bottom: 11px;\n      border-bottom: 1px solid var(--rule);\n    }\n\n    .section-label { color: var(--cyan); font-weight: 700; font-size: 9px; }\n    .path-count { color: var(--muted-2); font: 10px \"Geist Mono\", ui-monospace, monospace; }\n    .path-note { color: var(--muted); font-size: 11px; }\n\n    .tier-lane {\n      display: grid;\n      grid-template-columns: 170px 1fr;\n      min-height: 172px;\n      border-bottom: 1px solid var(--rule);\n      position: relative;\n    }\n\n    .tier-label {\n      display: grid;\n      grid-template-columns: 25px 1fr;\n      align-content: center;\n      gap: 11px;\n      padding: 22px 16px 22px 0;\n      border-right: 1px solid var(--rule);\n      position: relative;\n    }\n\n    .tier-label::after { content: \"\"; position: absolute; right: -1px; top: 50%; width: 8px; height: 1px; background: var(--cyan); box-shadow: 0 0 8px rgba(102,252,241,.7); }\n    .tier-index { font-size: 9px; color: var(--muted-2); padding-top: 4px; }\n    .tier-label h2 { font-size: 22px; line-height: 1; letter-spacing: -.03em; font-weight: 720; }\n    .tier-label p { color: var(--muted); font-size: 10px; margin-top: 9px; line-height: 1.4; }\n    .tier-status { grid-column: 2; color: var(--muted-2); font: 9px \"Geist Mono\", ui-monospace, monospace; margin-top: 10px; }\n    .bronze .tier-label h2, .bronze .dial-value { color: var(--bronze); }\n    .silver .tier-label h2, .silver .dial-value { color: var(--silver); }\n    .gold .tier-label h2, .gold .dial-value { color: var(--gold); }\n\n    .lane-content {\n      display: grid;\n      grid-template-columns: 144px 38px 1fr;\n      align-items: center;\n      padding: 22px 0 22px 30px;\n      min-width: 0;\n    }\n\n    .dial {\n      width: 106px;\n      height: 106px;\n      position: relative;\n      display: grid;\n      place-items: center;\n    }\n    .dial svg { width: 106px; height: 106px; transform: rotate(-90deg); overflow: visible; }\n    .dial circle { fill: none; stroke-width: 4; }\n    .dial .track { stroke: #2A3441; }\n    .dial .value-ring { stroke-linecap: square; }\n    .bronze .value-ring { stroke: var(--bronze); filter: drop-shadow(0 0 4px rgba(194,121,58,.38)); }\n    .silver .value-ring { stroke: var(--silver); filter: drop-shadow(0 0 4px rgba(182,194,209,.3)); }\n    .gold .value-ring { stroke: var(--gold); filter: drop-shadow(0 0 4px rgba(234,179,8,.32)); }\n    .dial-copy { position: absolute; text-align: center; }\n    .dial-value { display: block; font: 700 22px \"Geist Mono\", ui-monospace, monospace; line-height: 1; }\n    .dial-copy small { display: block; color: var(--muted-2); font: 8px \"Geist Mono\", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .12em; margin-top: 7px; }\n\n    .orthogonal { height: 100%; position: relative; min-height: 92px; }\n    .orthogonal::before { content: \"\"; position: absolute; left: 0; top: 50%; width: 24px; height: 1px; background: #445160; }\n    .orthogonal::after { content: \"\"; position: absolute; left: 24px; top: 29%; width: 1px; height: 42%; background: #445160; }\n    .orthogonal span { position: absolute; left: 24px; top: 29%; width: 15px; height: 1px; background: #445160; box-shadow: 0 39px 0 #445160; }\n    .orthogonal i { position: absolute; left: 22px; top: 27%; width: 5px; height: 5px; background: var(--cyan); box-shadow: 0 41px 0 var(--cyan); }\n\n    .lesson-list { display: flex; gap: 12px; min-width: 0; align-items: stretch; }\n\n    .lesson-file {\n      flex: 1 1 0;\n      min-width: 148px;\n      min-height: 118px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      position: relative;\n      border: 1px solid #3A4655;\n      background: var(--bg-slate-2);\n      color: var(--ink);\n      padding: 16px 15px 13px;\n      text-align: left;\n      cursor: pointer;\n      clip-path: polygon(0 0, calc(100% - 17px) 0, 100% 17px, 100% 100%, 0 100%);\n      transition: all 0.3s ease-in-out;\n    }\n\n    .lesson-file::before { content: \"\"; position: absolute; left: 0; right: 17px; top: 0; height: 2px; background: #4B5867; }\n    .lesson-file:hover,\n    .lesson-file:focus-visible { border-color: var(--cyan); box-shadow: var(--piece-glow); transform: translateY(-1px); outline: none; }\n    .lesson-file.active { border-color: var(--cyan); box-shadow: 0 0 0 1px var(--accent-purple), 0 0 16px rgba(102,252,241,.22); background: #17242A; }\n    .lesson-file.active::before { background: var(--cyan); box-shadow: 14px 0 0 var(--purple), 29px 0 0 var(--purple); }\n    .lesson-file.completed::before { background: var(--quality-best); }\n    .lesson-file.locked { border-color: #303A47; color: #798494; background: #141920; }\n    .lesson-file.locked::before { background: #4C5867; }\n\n    .lesson-meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 8px; color: var(--muted); }\n    .lesson-state { color: var(--quality-best); }\n    .lesson-file.active .lesson-state { color: var(--cyan); }\n    .lesson-file.locked .lesson-state { color: var(--muted); }\n    .lesson-file h3 { font-size: 14px; line-height: 1.18; letter-spacing: -.015em; max-width: 170px; }\n    .lesson-file p { color: var(--muted); font-size: 10px; line-height: 1.4; margin-top: 6px; }\n    .lesson-footer { display: flex; justify-content: space-between; color: var(--muted-2); font-size: 8px; border-top: 1px solid #303A47; padding-top: 10px; }\n    .lesson-footer strong { color: var(--cyan); font-weight: 700; }\n    .completed .lesson-footer strong { color: var(--quality-best); }\n    .locked .lesson-footer strong { color: var(--muted); }\n\n    .lane-marker {\n      position: absolute;\n      right: 0;\n      top: 0;\n      font: 8px \"Geist Mono\", ui-monospace, monospace;\n      color: var(--muted-2);\n      padding-top: 10px;\n      letter-spacing: .1em;\n    }\n\n    .page-foot {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 20px;\n      padding-top: 24px;\n      color: var(--muted-2);\n      font-size: 10px;\n    }\n\n    .page-foot strong { color: var(--cyan); font-weight: 600; }\n    .page-note { font-size: 8px; }\n\n    @media (max-width: 1080px) {\n      .learn-canvas { padding-left: 24px; padding-right: 24px; overflow: visible; }\n      .topbar { grid-template-columns: 200px 1fr auto; }\n      .mission-content { grid-template-columns: 1fr; gap: 12px; }\n      .mission-strip { grid-template-columns: 145px 1fr auto; }\n      .level-rail { grid-template-columns: 130px minmax(160px, 1fr) 105px; }\n      .level-up { display: none; }\n      .lane-content { padding-left: 20px; }\n      .lesson-list { overflow-x: auto; padding-bottom: 4px; }\n      .lesson-file { min-width: 176px; }\n    }\n\n    @media (max-width: 760px) {\n      .learn-canvas { padding: 18px 14px 38px; }\n      .topbar { height: auto; min-height: 58px; grid-template-columns: 1fr auto; gap: 14px; }\n      .main-nav { grid-row: 2; grid-column: 1 / -1; justify-self: stretch; height: 42px; gap: 20px; }\n      .nav-tab { flex: 1; text-align: center; }\n      .header-status { gap: 8px; font-size: 8px; }\n      .header-status > span:first-child { display: none; }\n      .page-intro { display: block; padding-top: 30px; }\n      h1 { font-size: 31px; }\n      .intro-copy { font-size: 12px; }\n      .quality-notation { margin-top: 24px; justify-content: space-between; gap: 8px; }\n      .quality-item { min-width: 0; }\n      .mission-strip { display: block; clip-path: polygon(0 0, calc(100% - 17px) 0, 100% 17px, 100% 100%, 0 100%); }\n      .mission-tag { min-height: 48px; padding: 12px 14px; display: flex; flex-direction: row; align-items: center; border-right: 0; border-bottom: 1px solid var(--rule); gap: 12px; }\n      .mission-number { margin-left: auto; }\n      .mission-content { padding: 16px 14px; }\n      .primary-action { width: calc(100% - 28px); margin: 0 14px 14px; }\n      .level-rail { grid-template-columns: 1fr auto; gap: 14px; padding: 16px 14px 26px; }\n      .level-track { grid-column: 1 / -1; grid-row: 2; }\n      .level-xp { grid-column: 2; grid-row: 1; text-align: right; }\n      .path-section { padding-top: 28px; }\n      .path-header { display: block; }\n      .path-count { display: block; margin-top: 9px; }\n      .path-note { display: none; }\n      .tier-lane { display: block; min-height: auto; }\n      .tier-label { min-height: 78px; border-right: 0; border-bottom: 1px solid var(--rule); padding-right: 0; grid-template-columns: 25px 1fr auto; align-items: start; }\n      .tier-label::after { right: 14px; top: auto; bottom: -1px; width: 45px; }\n      .tier-status { grid-column: 3; margin-top: 5px; }\n      .lane-content { grid-template-columns: 112px 22px 1fr; padding: 20px 0; }\n      .dial, .dial svg { width: 92px; height: 92px; }\n      .lesson-list { display: grid; grid-template-columns: 1fr; gap: 10px; overflow: visible; }\n      .lesson-file { min-width: 0; min-height: 112px; }\n      .orthogonal { min-height: 80px; }\n      .page-foot { display: block; line-height: 1.6; }\n      .page-foot .page-note { display: block; margin-top: 8px; }\n    }\n    </style>\n    <header aria-label=\"Navigation principale\" class=\"topbar\" data-kid=\"1-1\" data-name=\"navigation header\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity group\">\n            <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark container\">\n                <svg data-kid=\"1-1-1-1-1\" data-name=\"brand icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                    <path d=\"M7 5h10l-2 4 3 10H6L9 9 7 5Z\">\n                    </path>\n                    <path d=\"M5 19h14M9 5l3 3 3-3M8 12h8\">\n                    </path>\n                </svg>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand text group\">\n                <div class=\"brand-title\" data-kid=\"1-1-1-2-1\" data-name=\"brand title\">\n                    CHESS TRAINER\n                </div>\n                <div class=\"brand-subtitle\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle\">\n                    PLAYBOOK / LOCAL SYSTEM\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Destinations\" class=\"main-nav\" data-kid=\"1-1-2\" data-name=\"main navigation list\">\n            <button class=\"nav-tab\" data-kid=\"1-1-2-1\" data-name=\"play navigation button\" type=\"button\">\n                Jouer\n            </button>\n            <button aria-current=\"page\" class=\"nav-tab active\" data-kid=\"1-1-2-2\" data-name=\"learn navigation button\" type=\"button\">\n                Apprendre\n            </button>\n        </nav>\n        <div class=\"header-status\" data-kid=\"1-1-3\" data-name=\"status and profile group\">\n            <span data-kid=\"1-1-3-1\" data-name=\"connection status text\">\n                <i class=\"status-dot\" data-kid=\"1-1-3-1-1\" data-name=\"status online indicator\">\n                </i>\n                SESSION LOCALE\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-1-3-2\" data-name=\"session timer\" data-reason=\"text replaced every second by countdown script\">\n                14:32 / 07\n            </span>\n            <div aria-label=\"Profil AG\" class=\"profile-chip\" data-kid=\"1-1-3-3\" data-name=\"user profile chip\">\n                AG\n            </div>\n        </div>\n    </header>\n    <main class=\"page-frame\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"page-title\" class=\"page-intro\" data-kid=\"1-2-1\" data-name=\"introductory section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"introductory text group\">\n                <p class=\"eyebrow\" data-kid=\"1-2-1-1-1\" data-name=\"introductory eyebrow label\">\n                    TABLEAU D'ENTRAÎNEMENT / 03\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\" data-name=\"page main headline\" id=\"page-title\">\n                    Construis le prochain coup.\n                </h1>\n                <p class=\"intro-copy\" data-kid=\"1-2-1-1-3\" data-name=\"introductory description\">\n                    Une mission active, trois paliers et des leçons courtes pour transformer tes décisions en réflexes de partie.\n                </p>\n            </div>\n            <div aria-label=\"Notation des qualités de coup\" class=\"quality-notation\" data-kid=\"1-2-1-2\" data-name=\"quality notation legend\">\n                <div class=\"quality-item brilliant\" data-kid=\"1-2-1-2-1\" data-name=\"brilliant quality item\">\n                    <span class=\"quality-key\" data-kid=\"1-2-1-2-1-1\" data-name=\"brilliant quality symbol\">\n                        !!\n                    </span>\n                    <span class=\"quality-label\" data-kid=\"1-2-1-2-1-2\" data-name=\"brilliant quality label\">\n                        qualité\n                    </span>\n                    <span class=\"quality-caption\" data-kid=\"1-2-1-2-1-3\" data-name=\"brilliant quality name\">\n                        Brillant\n                    </span>\n                </div>\n                <div class=\"quality-item best\" data-kid=\"1-2-1-2-2\" data-name=\"best quality item\">\n                    <span class=\"quality-key\" data-kid=\"1-2-1-2-2-1\" data-name=\"best quality symbol\">\n                        ★\n                    </span>\n                    <spa