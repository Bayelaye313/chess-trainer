    "var_ddcadd960f50": {
      "type": "variant",
      "label": "Laboratoire — Table Position",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    :root {\n    --lab-obsidian: #0B0C10;\n    --lab-slate: #1F2833;\n    --lab-slate-2: #17202a;\n    --lab-cyan: #66FCF1;\n    --lab-purple: #8A2BE2;\n    --lab-white: #F7FBFF;\n    --lab-muted: #9BA9B7;\n    --lab-line: rgba(102, 252, 241, .22);\n    --lab-line-soft: rgba(235, 247, 255, .1);\n    --quality-brilliant: #1baaa6;\n    --quality-best: #98bc49;\n    --quality-inaccuracy: #f4bf44;\n    --quality-blunder: #c93230;\n    --engine-best: #22c55e;\n    --engine-second: #58b6ff;\n    --engine-alt: #f4bf44;\n    --played-arrow: #f97316;\n    --accent-purple: #8A2BE2;\n    --motion-tab-duration: 260ms;\n    --motion-hover-duration: 300ms;\n    --motion-panel-ease: cubic-bezier(.22, 1, .36, 1);\n    --piece-glow: 0 0 15px rgba(102, 252, 241, .6);\n  }\n\n  .lab-app {\n    min-height: 100vh;\n    box-sizing: border-box;\n    padding: 22px 28px 34px;\n    color: var(--lab-white);\n    background:\n      radial-gradient(circle at 76% 11%, rgba(138, 43, 226, .12), transparent 23rem),\n      radial-gradient(circle at 8% 62%, rgba(102, 252, 241, .06), transparent 28rem),\n      var(--lab-obsidian);\n    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    letter-spacing: .01em;\n    overflow-x: hidden;\n  }\n\n  .lab-app *, .lab-app *::before, .lab-app *::after { box-sizing: border-box; }\n  .lab-mono { font-family: \"SFMono-Regular\", \"Cascadia Code\", \"Roboto Mono\", ui-monospace, monospace; }\n  .lab-muted { color: var(--lab-muted); }\n  .lab-cyan { color: var(--lab-cyan); }\n  .lab-purple { color: #bf8cff; }\n\n  .lab-nav {\n    width: min(100%, 1384px);\n    margin: 0 auto 22px;\n    min-height: 60px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border-bottom: 1px solid var(--lab-line-soft);\n  }\n\n  .brand-lockup { display: flex; align-items: center; gap: 13px; }\n  .brand-mark {\n    width: 30px;\n    height: 30px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--lab-cyan);\n    color: var(--lab-cyan);\n    border-radius: 2px;\n    font-size: 14px;\n    position: relative;\n    box-shadow: 0 0 18px rgba(102,252,241,.18);\n  }\n  .brand-mark::before, .brand-mark::after { content: \"\"; position: absolute; background: var(--lab-cyan); }\n  .brand-mark::before { width: 5px; height: 1px; left: -4px; top: 50%; }\n  .brand-mark::after { height: 5px; width: 1px; top: -4px; left: 50%; }\n  .brand-name { font-size: 14px; font-weight: 760; letter-spacing: .14em; text-transform: uppercase; }\n  .brand-sub { display: block; margin-top: 3px; color: var(--lab-muted); font-size: 10px; letter-spacing: .11em; text-transform: uppercase; }\n\n  .lab-nav-links { height: 60px; display: flex; align-items: stretch; gap: 28px; }\n  .nav-link {\n    position: relative;\n    border: 0;\n    padding: 0 3px;\n    color: #82909c;\n    background: transparent;\n    font: 700 12px/1 ui-sans-serif, system-ui, sans-serif;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: all .3s ease-in-out;\n  }\n  .nav-link:hover, .nav-link:focus-visible { color: var(--lab-white); text-shadow: 0 0 12px rgba(102,252,241,.45); outline: none; }\n  .nav-link.active { color: var(--lab-cyan); }\n  .nav-link.active::after {\n    content: \"\";\n    position: absolute;\n    height: 2px;\n    bottom: -1px;\n    left: 0;\n    right: 0;\n    background: var(--lab-cyan);\n    box-shadow: 0 0 12px rgba(102,252,241,.7);\n  }\n  .nav-status { display: flex; align-items: center; gap: 9px; color: var(--lab-muted); font-size: 11px; }\n  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--lab-cyan); box-shadow: 0 0 11px rgba(102,252,241,.9); }\n\n  .lab-shell { width: min(100%, 1384px); margin: 0 auto; }\n  .eyebrow { color: var(--lab-muted); font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }\n  .lab-title-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 18px; margin: 0 0 14px; }\n  .lab-title { margin: 5px 0 0; font-size: clamp(20px, 2.1vw, 30px); line-height: 1.05; letter-spacing: -.035em; }\n  .title-note { max-width: 370px; color: var(--lab-muted); font-size: 12px; line-height: 1.55; text-align: right; }\n\n  .scorebar {\n    min-height: 45px;\n    display: grid;\n    grid-template-columns: 1.2fr .9fr 1fr;\n    border: 1px solid var(--lab-line);\n    background: rgba(31,40,51,.68);\n    position: relative;\n  }\n  .scorebar::before, .scorebar::after { content: \"\"; position: absolute; width: 7px; height: 7px; border-color: var(--lab-cyan); }\n  .scorebar::before { left: -1px; top: -1px; border-top: 1px solid; border-left: 1px solid; }\n  .scorebar::after { right: -1px; bottom: -1px; border-right: 1px solid; border-bottom: 1px solid; }\n  .score-stat { display: flex; align-items: center; gap: 12px; padding: 9px 16px; border-right: 1px solid var(--lab-line-soft); }\n  .score-stat:last-child { border-right: 0; justify-content: flex-end; }\n  .score-key { color: var(--lab-muted); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n  .score-value { color: var(--lab-white); font-size: 14px; font-weight: 720; }\n  .score-value.cyan { color: var(--lab-cyan); }\n  .score-eval { color: var(--lab-cyan); font-size: 18px; font-weight: 800; letter-spacing: -.04em; }\n  .score-meter { flex: 1; max-width: 92px; height: 4px; margin-left: auto; background: #11171d; border: 1px solid rgba(102,252,241,.22); overflow: hidden; }\n  .score-meter span { display: block; width: 62%; height: 100%; background: var(--lab-cyan); box-shadow: 0 0 8px rgba(102,252,241,.9); }\n\n  .workspace { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 394px); gap: 28px; align-items: start; margin-top: 22px; }\n  .board-column { min-width: 0; }\n  .board-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }\n  .board-heading-left { display: flex; align-items: center; gap: 10px; }\n  .axis-label { color: #6f7e8d; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }\n  .analysis-pulse { width: 8px; height: 8px; background: var(--lab-purple); border-radius: 50%; box-shadow: 0 0 14px rgba(138,43,226,.85); }\n  .board-heading-right { display: flex; align-items: center; gap: 14px; color: var(--lab-muted); font-size: 11px; }\n  .board-heading-right strong { color: var(--lab-white); font-weight: 600; }\n\n  .board-stage { display: grid; grid-template-columns: 31px minmax(0, 1fr); gap: 10px; width: 100%; max-width: 880px; min-width: 660px; aspect-ratio: 1.035 / 1; position: relative; }\n  .evaluation-rail { position: relative; height: 100%; border: 1px solid rgba(102,252,241,.2); background: #10161d; overflow: hidden; }\n  .evaluation-rail::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: 0; height: 62%; background: linear-gradient(to top, rgba(102,252,241,.08), transparent); pointer-events: none; }\n  .rail-zero { position: absolute; left: -1px; right: -1px; top: 38%; height: 1px; background: var(--lab-cyan); box-shadow: 0 0 8px rgba(102,252,241,.8); z-index: 2; }\n  .rail-zero-label { position: absolute; top: calc(38% - 8px); left: 38px; color: var(--lab-cyan); font-size: 9px; white-space: nowrap; }\n  .rail-label { position: absolute; right: 5px; color: #71808d; font: 9px/1 \"SFMono-Regular\", ui-monospace, monospace; transform: translateY(-50%); }\n  .rail-label.r5 { top: 4%; } .rail-label.r2 { top: 20%; } .rail-label.r0 { top: 38%; } .rail-label.b2 { top: 57%; } .rail-label.b5 { top: 76%; } .rail-label.b9 { top: 94%; }\n  .rail-ticks { position: absolute; inset: 0 0 0 auto; width: 8px; display: flex; flex-direction: column; justify-content: space-around; z-index: 1; }\n  .rail-ticks i { display: block; width: 5px; height: 1px; background: rgba(155,169,183,.7); }\n\n  .board-wrap { position: relative; width: 100%; aspect-ratio: 1; border: 2px solid rgba(102,252,241,.38); background: #0c1117; box-shadow: 0 0 0 1px rgba(138,43,226,.13), 0 0 32px rgba(6, 18, 26, .7); }\n  .board-wrap::before, .board-wrap::after { content: \"\"; position: absolute; z-index: 3; width: 24px; height: 24px; pointer-events: none; }\n  .board-wrap::before { top: -5px; left: -5px; border-top: 2px solid var(--lab-cyan); border-left: 2px solid var(--lab-cyan); }\n  .board-wrap::after { right: -5px; bottom: -5px; border-right: 2px solid var(--lab-purple); border-bottom: 2px solid var(--lab-purple); }\n  .crosshair-top-right, .crosshair-bottom-left { position: absolute; z-index: 4; width: 12px; height: 12px; pointer-events: none; }\n  .crosshair-top-right { top: -5px; right: -5px; border-top: 1px solid var(--lab-cyan); border-right: 1px solid var(--lab-cyan); }\n  .crosshair-bottom-left { bottom: -5px; left: -5px; border-bottom: 1px solid var(--lab-purple); border-left: 1px solid var(--lab-purple); }\n  .chessboard { width: 100%; height: 100%; display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr); }\n  .square { position: relative; display: grid; place-items: center; min-width: 0; min-height: 0; border: 0; cursor: pointer; font-family: \"Segoe UI Symbol\", \"Noto Sans Symbols 2\", serif; transition: all .3s ease-in-out; }\n  .square.light { background: #c8d9d7; }\n  .square.dark { background: #37505a; }\n  .square:hover, .square:focus-visible { z-index: 2; outline: none; box-shadow: inset 0 0 0 3px rgba(102,252,241,.9), var(--piece-glow); }\n  .square.last-move { background: rgba(102,252,241,.45); }\n  .square.best-line { background: rgba(34,197,94,.32); }\n  .square.played-line { background: rgba(249,115,22,.42); }\n  .square.selected { box-shadow: inset 0 0 0 3px var(--lab-cyan), 0 0 16px rgba(102,252,241,.62); z-index: 2; }\n  .piece { position: relative; z-index: 1; font-size: clamp(34px, 5.25vw, 70px); line-height: 1; user-select: none; transition: all .3s ease-in-out; filter: drop-shadow(0 3px 2px rgba(0,0,0,.58)); }\n  .piece.white { color: #f5f8f4; text-shadow: 0 1px 0 #82909a, 0 0 12px rgba(255,255,255,.12); }\n  .piece.black { color: #121923; text-shadow: 0 1px 0 rgba(255,255,255,.22), 0 0 11px rgba(0,0,0,.7); }\n  .square:hover .piece, .square:focus-visible .piece { transform: translateY(-1px); filter: drop-shadow(0 0 10px rgba(102,252,241,.75)); }\n  .coord { position: absolute; font: 9px/1 \"SFMono-Regular\", ui-monospace, monospace; opacity: .72; z-index: 2; }\n  .coord.file { bottom: 4px; right: 5px; } .coord.rank { top: 4px; left: 5px; }\n  .square:not(:nth-child(8n + 1)) .coord.rank { display: none; }\n  .light .coord { color: #34525a; } .dark .coord { color: #bdcfcd; }\n  .stipple { position: absolute; z-index: 0; width: 3px; height: 3px; border-radius: 50%; background: var(--lab-cyan); opacity: .85; box-shadow: 0 0 8px rgba(102,252,241,.9); }\n  .stipple.one { top: 12%; left: 19%; } .stipple.two { top: 21%; right: 15%; background: var(--lab-purple); box-shadow: 0 0 8px rgba(138,43,226,.9); } .stipple.three { bottom: 17%; left: 12%; width: 2px; height: 2px; }\n\n  .move-scrubber { margin-top: 14px; border: 1px solid var(--lab-line); background: rgba(31,40,51,.65); }\n  .scrubber-top { display: flex; justify-content: space-between; align-items: center; padding: 9px 12px 8px; border-bottom: 1px solid var(--lab-line-soft); }\n  .scrubber-title { color: var(--lab-muted); font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }\n  .scrubber-actions { display: flex; gap: 7px; }\n  .icon-button, .instrument-button { border: 1px solid rgba(102,252,241,.38); border-radius: 2px; color: var(--lab-cyan); background: #10171e; cursor: pointer; transition: all .3s ease-in-out; }\n  .icon-button { width: 24px; height: 22px; font: 12px/1 \"SFMono-Regular\", ui-monospace, monospace; }\n  .icon-button:hover, .icon-button:focus-visible, .instrument-button:hover, .instrument-button:focus-visible { outline: none; box-shadow: var(--piece-glow); border-color: var(--lab-cyan); color: var(--lab-white); }\n  .move-strip { display: flex; gap: 4px; overflow-x: auto; padding: 10px 12px 12px; scrollbar-color: rgba(102,252,241,.55) #11171d; }\n  .move { flex: 0 0 auto; min-width: 72px; padding: 7px 9px; border: 1px solid transparent; border-radius: 2px; background: transparent; color: #a6b4c0; text-align: left; cursor: pointer; transition: all .3s ease-in-out; }\n  .move:hover, .move:focus-visible { color: var(--lab-white); border-color: rgba(102,252,241,.45); outline: none; box-shadow: 0 0 12px rgba(102,252,241,.22); }\n  .move.active { color: var(--lab-cyan); border-color: var(--lab-cyan); background: rgba(102,252,241,.08); box-shadow: inset 0 -2px 0 var(--lab-cyan); }\n  .move-number { display: block; color: #6f7e8d; font: 9px/1 \"SFMono-Regular\", ui-monospace, monospace; margin-bottom: 5px; }\n  .move.active .move-number { color: rgba(102,252,241,.7); }\n  .move-notation { font: 700 12px/1 \"SFMono-Regular\", ui-monospace, monospace; }\n  .move-quality { float: right; margin-left: 5px; font: 700 11px/1 \"SFMono-Regular\", ui-monospace, monospace; }\n  .quality-best { color: var(--quality-best); } .quality-brilliant { color: var(--quality-brilliant); } .quality-inaccuracy { color: var(--quality-inaccuracy); } .quality-blunder { color: var(--quality-blunder); }\n\n  .lab-panel { min-height: 100%; border: 1px solid var(--lab-line); background: rgba(31,40,51,.76); position: relative; }\n  .lab-panel::before { content: \"\"; position: absolute; inset: 7px; border: 1px solid rgba(235,247,255,.07); pointer-events: none; }\n  .panel-header { position: relative; z-index: 1; padding: 17px 18px 0; display: flex; justify-content: space-between; align-items: flex-start; }\n  .panel-title { margin: 4px 0 0; font-size: 18px; letter-spacing: -.025em; }\n  .focus-ring { width: 19px; height: 19px; border: 1px solid var(--lab-cyan); border-radius: 50%; position: relative; box-shadow: 0 0 10px rgba(102,252,241,.28); }\n  .focus-ring::before, .focus-ring::after { content: \"\"; position: absolute; background: var(--lab-cyan); }\n  .focus-ring::before { left: -5px; right: -5px; top: 8px; height: 1px; opacity: .75; }\n  .focus-ring::after { top: -5px; bottom: -5px; left: 8px; width: 1px; opacity: .75; }\n  .optic-tabs { position: relative; z-index: 1; display: flex; gap: 20px; margin: 17px 18px 0; border-bottom: 1px solid var(--lab-line-soft); }\n  .optic-tab { position: relative; padding: 10px 0 11px; border: 0; color: #81909e; background: transparent; cursor: pointer; font: 700 10px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase; transition: all .3s ease-in-out; }\n  .optic-tab:hover, .optic-tab:focus-visible { color: var(--lab-white); outline: none; }\n  .optic-tab.active { color: var(--lab-cyan); }\n  .optic-tab.active::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--lab-cyan); box-shadow: 0 0 10px rgba(102,252,241,.75); }\n  .panel-body { position: relative; z-index: 1; padding: 18px; }\n  .tab-panel { animation: panel-in var(--motion-tab-duration) var(--motion-panel-ease) both; }\n  @keyframes panel-in { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: translateX(0); } }\n  .panel-section { padding: 0 0 18px; margin: 0 0 18px; border-bottom: 3px double rgba(235,247,255,.11); }\n  .panel-section:last-child { padding-bottom: 0; margin-bottom: 0; border-bottom: 0; }\n  .section-label { color: var(--lab-muted); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }\n  .position-readout { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-top: 10px; }\n  .position-score { color: var(--lab-cyan); font: 800 34px/.9 \"SFMono-Regular\", ui-monospace, monospace; letter-spacing: -.08em; text-shadow: 0 0 15px rgba(102,252,241,.25); }\n  .position-score small { color: var(--lab-muted); font: 11px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: 0; }\n  .position-meta { color: var(--lab-muted); font: 11px/1.6 \"SFMono-Regular\", ui-monospace, monospace; text-align: right; }\n  .readout-line { height: 5px; margin-top: 15px; border: 1px solid rgba(102,252,241,.25); background: #121920; position: relative; }\n  .readout-line::before { content: \"\"; position: absolute; top: -4px; left: 62%; width: 1px; height: 11px; background: var(--lab-cyan); box-shadow: 0 0 9px rgba(102,252,241,.8); }\n  .readout-line span { display: block; width: 62%; height: 100%; background: linear-gradient(90deg, transparent, rgba(102,252,241,.7)); }\n  .candidate-list { display: grid; gap: 7px; margin-top: 11px; }\n  .candidate-line { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 9px; min-height: 39px; padding: 8px 9px; border: 1px solid transparent; background: rgba(12,17,23,.48); transition: all .3s ease-in-out; }\n  .candidate-line:hover { border-color: rgba(102,252,241,.38); box-shadow: 0 0 12px rgba(102,252,241,.14); }\n  .candidate-line.primary { border-color: rgba(34,197,94,.5); background: rgba(34,197,94,.08); }\n  .candidate-index { color: #738290; font: 10px/1 \"SFMono-Regular\", ui-monospace, monospace; }\n  .candidate-moves { color: var(--lab-white); font: 12px/1.35 \"SFMono-Regular\", ui-monospace, monospace; letter-spacing: .02em; }\n  .candidate-moves strong { color: var(--engine-best); font-weight: 800; }\n  .candidate-eval { color: var(--lab-cyan); font: 700 11px/1 \"SFMono-Regular\", ui-monospace, monospace; }\n  .candidate-line:nth-child(2) .candidate-eval { color: var(--engine-second); } .candidate-line:nth-child(3) .candidate-eval { color: var(--engine-alt); }\n  .commentary { color: #d7e1e8; font-size: 14px; line-height: 1.65; }\n  .commentary strong { color: var(--lab-white); }\n  .move-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }\n  .compare-cell { padding: 10px; border-top: 1px solid var(--lab-line-soft); background: rgba(12,17,23,.36); }\n  .compare-label { display: block; color: var(--lab-muted); font-size: 9px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }\n  .compare-move { display: block; margin-top: 6px; font: 700 13px/1 \"SFMono-Regular\", ui-monospace, monospace; }\n  .played { color: var(--played-arrow); } .best { color: var(--engine-best); }\n  .instrument-button { margin-top: 14px; padding: 10px 13px; color: var(--lab-obsidian); background: var(--lab-cyan); border-color: var(--lab-cyan); font: 800 10px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .11em; text-transform: uppercase; }\n  .instrument-button:hover, .instrument-button:focus-visible { color: var(--lab-obsidian); background: #a5fff9; box-shadow: var(--piece-glow); }\n  .ruler-note { display: flex; align-items: center; gap: 8px; margin-top: 18px; color: #738290; font: 10px/1.5 \"SFMono-Regular\", ui-monospace, monospace; }\n  .ruler-note::before { content: \"\"; width: 24px; height: 1px; background: var(--lab-purple); box-shadow: 0 0 8px rgba(138,43,226,.8); }\n  .hidden { display: none; }\n\n  @media (max-width: 1120px) {\n    .lab-app { padding-inline: 18px; }\n    .workspace { grid-template-columns: minmax(0, 1fr) 350px; gap: 18px; }\n    .board-stage { min-width: 0; }\n    .piece { font-size: clamp(30px, 5vw, 58px); }\n  }\n  @media (max-width: 900px) {\n    .lab-title-row { align-items: flex-start; flex-direction: column; }\n    .title-note { max-width: 560px; text-align: left; }\n    .workspace { display: block; }\n    .board-stage { width: min(100%, calc(100vw - 36px)); min-width: 0; max-width: none; margin-inline: auto; }\n    .lab-panel { margin-top: 22px; }\n    .panel-body { padding-bottom: 20px; }\n  }\n  @media (max-width: 580px) {\n    .lab-app { padding: 14px 12px 26px; }\n    .lab-nav { margin-bottom: 16px; }\n    .brand-sub, .nav-status { display: none; }\n    .lab-nav-links { gap: 17px; }\n    .scorebar { grid-template-columns: 1fr 1fr; }\n    .score-stat:nth-child(2) { border-right: 0; }\n    .score-stat:last-child { grid-column: 1 / -1; justify-content: space-between; border-top: 1px solid var(--lab-line-soft); }\n    .workspace { margin-top: 16px; }\n    .board-heading-right { display: none; }\n    .board-stage { width: calc(100vw - 24px); gap: 6px; }\n    .evaluation-rail { width: 23px; }\n    .rail-label { display: none; }\n    .rail-zero-label { left: 28px; }\n    .piece { font-size: clamp(25px, 10vw, 47px); }\n    .coord { font-size: 8px; }\n    .move-scrubber { margin-top: 10px; }\n    .panel-header { padding-inline: 14px; }\n    .optic-tabs { margin-inline: 14px; gap: 15px; overflow-x: auto; }\n    .panel-body { padding: 15px 14px; }\n    .move-compare { grid-template-columns: 1fr; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .tab-panel { animation: none; }\n    .square, .piece, .move, .nav-link, .optic-tab, .instrument-button, .icon-button { transition: none; }\n  }\n</style>\n<div class=\"lab-app\" data-kid=\"1\" data-name=\"lab application wrapper\">\n    <header class=\"lab-nav\" data-kid=\"1-1\" data-name=\"navigation header\">\n        <div class=\"brand-lockup\" data-kid=\"1-1-1\" data-name=\"brand lockup\">\n            <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"chess knight icon\">\n                ♞\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand identification text\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"application title\">\n                    Chess Trainer\n                </div>\n                <span class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"application subtitle\">\n                    Laboratoire de position\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Navigation principale\" class=\"lab-nav-links\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <button class=\"nav-link active\" data-kid=\"1-1-2-1\" data-name=\"play navigation link\" type=\"button\">\n                Jouer\n            </button>\n            <button class=\"nav-link\" data-kid=\"1-1-2-2\" data-name=\"learn navigation link\" type=\"button\">\n                Apprendre\n            </button>\n        </nav>\n        <div class=\"nav-status\" data-kid=\"1-1-3\" data-name=\"engine status container\">\n            <span class=\"status-dot\" data-kid=\"1-1-3-1\" data-name=\"engine ready status indicator\">\n            </span>\n            <span class=\"lab-mono\" data-kid=\"1-1-3-2\" data-name=\"engine ready status text\">\n                MOTEUR PRÊT\n            </span>\n        </div>\n    </header>\n    <main class=\"lab-shell\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"lab-title-row\" data-kid=\"1-2-1\" data-name=\"title row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"title information group\">\n                <div class=\"eyebrow lab-mono\" data-kid=\"1-2-1-1-1\" data-name=\"content eyebrow label\">\n                    Table d'analyse / Partie locale 024\n                </div>\n                <h1 class=\"lab-title\" data-kid=\"1-2-1-1-2\" data-name=\"page main title\">\n                    Position sous mesure\n                </h1>\n            </div>\n            <p class=\"title-note\" data-kid=\"1-2-1-2\" data-name=\"page title note\">\n                Compare le coup joué à la meilleure ligne. Chaque repère reste lié à la position active.\n            </p>\n        </div>\n        <section aria-label=\"État de la position\" class=\"scorebar\" data-kid=\"1-2-2\" data-name=\"score information bar\">\n            <div class=\"score-stat\" data-kid=\"1-2-2-1\" data-name=\"side to move stat group\">\n                <span class=\"score-key\" data-kid=\"1-2-2-1-1\" data-name=\"stat label\">\n                    Trait\n                </span>\n                <span class=\"score-value cyan\" data-kid=\"1-2-2-1-2\"