ected=\"false\" class=\"optic-tab\" data-kid=\"1-2-3-2-2-2\" data-tab=\"lines\" role=\"tab\" type=\"button\">\n                        Lignes\n                    </button>\n                    <button aria-selected=\"false\" class=\"optic-tab\" data-kid=\"1-2-3-2-2-3\" data-tab=\"comment\" role=\"tab\" type=\"button\">\n                        Commentaire\n                    </button>\n                </div>\n                <div class=\"panel-body\" data-kid=\"1-2-3-2-3\" data-name=\"analysis panel body\">\n                    <div class=\"tab-panel\" data-kid=\"1-2-3-2-3-1\" data-name=\"position analysis tab panel\" data-panel=\"position\">\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-1-1\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-1-1-1\">\n                                Évaluation moteur\n                            </div>\n                            <div class=\"position-readout\" data-kid=\"1-2-3-2-3-1-1-2\">\n                                <strong class=\"position-score\" data-kid=\"1-2-3-2-3-1-1-2-1\">\n                                    +0.62\n                                    <small data-kid=\"1-2-3-2-3-1-1-2-1-1\">\n                                        pour les Blancs\n                                    </small>\n                                </strong>\n                                <span class=\"position-meta\" data-kid=\"1-2-3-2-3-1-1-2-2\">\n                                    Profondeur 19\n                                    <br data-kid=\"1-2-3-2-3-1-1-2-2-1\"/>\n                                    confiance 96 %\n                                </span>\n                            </div>\n                            <div class=\"readout-line\" data-kid=\"1-2-3-2-3-1-1-3\">\n                                <span data-kid=\"1-2-3-2-3-1-1-3-1\">\n                                </span>\n                            </div>\n                        </section>\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-1-2\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-1-2-1\">\n                                Lignes candidates\n                            </div>\n                            <div class=\"candidate-list\" data-kid=\"1-2-3-2-3-1-2-2\">\n                                <div class=\"candidate-line primary\" data-kid=\"1-2-3-2-3-1-2-2-1\">\n                                    <span class=\"candidate-index\" data-kid=\"1-2-3-2-3-1-2-2-1-1\">\n                                        01\n                                    </span>\n                                    <span class=\"candidate-moves\" data-kid=\"1-2-3-2-3-1-2-2-1-2\">\n                                        <strong data-kid=\"1-2-3-2-3-1-2-2-1-2-1\">\n                                            18…Nf6\n                                        </strong>\n                                        19. e5\n                                    </span>\n                                    <span class=\"candidate-eval\" data-kid=\"1-2-3-2-3-1-2-2-1-3\">\n                                        +0.62\n                                    </span>\n                                </div>\n                                <div class=\"candidate-line\" data-kid=\"1-2-3-2-3-1-2-2-2\">\n                                    <span class=\"candidate-index\" data-kid=\"1-2-3-2-3-1-2-2-2-1\">\n                                        02\n                                    </span>\n                                    <span class=\"candidate-moves\" data-kid=\"1-2-3-2-3-1-2-2-2-2\">\n                                        18…Qe7 19. e5\n                                    </span>\n                                    <span class=\"candidate-eval\" data-kid=\"1-2-3-2-3-1-2-2-2-3\">\n                                        +0.48\n                                    </span>\n                                </div>\n                                <div class=\"candidate-line\" data-kid=\"1-2-3-2-3-1-2-2-3\">\n                                    <span class=\"candidate-index\" data-kid=\"1-2-3-2-3-1-2-2-3-1\">\n                                        03\n                                    </span>\n                                    <span class=\"candidate-moves\" data-kid=\"1-2-3-2-3-1-2-2-3-2\">\n                                        18…Be6 19. Bxe6\n                                    </span>\n                                    <span class=\"candidate-eval\" data-kid=\"1-2-3-2-3-1-2-2-3-3\">\n                                        +0.31\n                                    </span>\n                                </div>\n                            </div>\n                        </section>\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-1-3\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-1-3-1\">\n                                Coup sélectionné\n                            </div>\n                            <div class=\"move-compare\" data-kid=\"1-2-3-2-3-1-3-2\">\n                                <div class=\"compare-cell\" data-kid=\"1-2-3-2-3-1-3-2-1\">\n                                    <span class=\"compare-label\" data-kid=\"1-2-3-2-3-1-3-2-1-1\">\n                                        Joué\n                                    </span>\n                                    <span class=\"compare-move played lab-mono\" data-kid=\"1-2-3-2-3-1-3-2-1-2\">\n                                        18. h3\n                                    </span>\n                                </div>\n                                <div class=\"compare-cell\" data-kid=\"1-2-3-2-3-1-3-2-2\">\n                                    <span class=\"compare-label\" data-kid=\"1-2-3-2-3-1-3-2-2-1\">\n                                        Meilleure ligne\n                                    </span>\n                                    <span class=\"compare-move best lab-mono\" data-kid=\"1-2-3-2-3-1-3-2-2-2\">\n                                        18. e5\n                                    </span>\n                                </div>\n                            </div>\n                            <button class=\"instrument-button\" data-kid=\"1-2-3-2-3-1-3-3\" type=\"button\">\n                                Analyser la position\n                            </button>\n                        </section>\n                        <div class=\"ruler-note\" data-kid=\"1-2-3-2-3-1-4\">\n                            Repère actif · la ligne verte indique le meilleur coup moteur.\n                        </div>\n                    </div>\n                    <div class=\"tab-panel hidden\" data-kid=\"1-2-3-2-3-2\" data-name=\"lines analysis tab panel\" data-panel=\"lines\">\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-2-1\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-2-1-1\">\n                                Lignes candidates / multiPV 3\n                            </div>\n                            <div class=\"candidate-list\" data-kid=\"1-2-3-2-3-2-1-2\">\n                                <div class=\"candidate-line primary\" data-kid=\"1-2-3-2-3-2-1-2-1\">\n                                    <span class=\"candidate-index\" data-kid=\"1-2-3-2-3-2-1-2-1-1\">\n                                        01\n                                    </span>\n                                    <span class=\"candidate-moves\" data-kid=\"1-2-3-2-3-2-1-2-1-2\">\n                                        <strong data-kid=\"1-2-3-2-3-2-1-2-1-2-1\">\n                                            18…Nf6 19. e5\n                                        </strong>\n                                        <br data-kid=\"1-2-3-2-3-2-1-2-1-2-2\"/>\n                                        19…Nd5 20. Ne4\n                                    </span>\n                                    <span class=\"candidate-eval\" data-kid=\"1-2-3-2-3-2-1-2-1-3\">\n                                        +0.62\n                                    </span>\n                                </div>\n                                <div class=\"candidate-line\" data-kid=\"1-2-3-2-3-2-1-2-2\">\n                                    <span class=\"candidate-index\" data-kid=\"1-2-3-2-3-2-1-2-2-1\">\n                                        02\n                                    </span>\n                                    <span class=\"candidate-moves\" data-kid=\"1-2-3-2-3-2-1-2-2-2\">\n                                        18…Qe7 19. e5\n                                        <br data-kid=\"1-2-3-2-3-2-1-2-2-2-1\"/>\n                                        19…Nd7 20. f4\n                                    </span>\n                                    <span class=\"candidate-eval\" data-kid=\"1-2-3-2-3-2-1-2-2-3\">\n                                        +0.48\n                                    </span>\n                                </div>\n                                <div class=\"candidate-line\" data-kid=\"1-2-3-2-3-2-1-2-3\">\n                                    <span class=\"candidate-index\" data-kid=\"1-2-3-2-3-2-1-2-3-1\">\n                                        03\n                                    </span>\n                                    <span class=\"candidate-moves\" data-kid=\"1-2-3-2-3-2-1-2-3-2\">\n                                        18…Be6 19. Bxe6\n                                        <br data-kid=\"1-2-3-2-3-2-1-2-3-2-1\"/>\n                                        19…fxe6 20. Ne4\n                                    </span>\n                                    <span class=\"candidate-eval\" data-kid=\"1-2-3-2-3-2-1-2-3-3\">\n                                        +0.31\n                                    </span>\n                                </div>\n                            </div>\n                        </section>\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-2-2\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-2-2-1\">\n                                Flèches actives\n                            </div>\n                            <p class=\"commentary\" data-kid=\"1-2-3-2-3-2-2-2\">\n                                Vert : meilleure ligne moteur.\n                                <span class=\"played\" data-kid=\"1-2-3-2-3-2-2-2-1\">\n                                    Orange : coup joué.\n                                </span>\n                                Les deux informations restent séparées pour éviter toute confusion sémantique.\n                            </p>\n                        </section>\n                    </div>\n                    <div class=\"tab-panel hidden\" data-kid=\"1-2-3-2-3-3\" data-name=\"commentary analysis tab panel\" data-panel=\"comment\">\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-3-1\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-3-1-1\">\n                                Coach voice\n                            </div>\n                            <p class=\"commentary\" data-kid=\"1-2-3-2-3-3-1-2\">\n                                <strong data-kid=\"1-2-3-2-3-3-1-2-1\">\n                                    h3 est solide, mais un peu passif.\n                                </strong>\n                                Tu pouvais profiter de l'avance de développement avec e5 et gagner de l'espace au centre avant que les Noirs ne stabilisent leur cavalier.\n                            </p>\n                        </section>\n                        <section class=\"panel-section\" data-kid=\"1-2-3-2-3-3-2\">\n                            <div class=\"section-label\" data-kid=\"1-2-3-2-3-3-2-1\">\n                                Diagnostic\n                            </div>\n                            <div class=\"move-compare\" data-kid=\"1-2-3-2-3-3-2-2\">\n                                <div class=\"compare-cell\" data-kid=\"1-2-3-2-3-3-2-2-1\">\n                                    <span class=\"compare-label\" data-kid=\"1-2-3-2-3-3-2-2-1-1\">\n                                        Qualité\n                                    </span>\n                                    <span class=\"compare-move quality-inaccuracy lab-mono\" data-kid=\"1-2-3-2-3-3-2-2-1-2\">\n                                        ?! Imprécision\n                                    </span>\n                                </div>\n                                <div class=\"compare-cell\" data-kid=\"1-2-3-2-3-3-2-2-2\">\n                                    <span class=\"compare-label\" data-kid=\"1-2-3-2-3-3-2-2-2-1\">\n                                        Phase\n                                    </span>\n                                    <span class=\"compare-move lab-mono\" data-kid=\"1-2-3-2-3-3-2-2-2-2\">\n                                        Milieu de partie\n                                    </span>\n                                </div>\n                            </div>\n                            <button class=\"instrument-button\" data-kid=\"1-2-3-2-3-3-2-3\" type=\"button\">\n                                Rejouer la ligne\n                            </button>\n                        </section>\n                        <div class=\"ruler-note\" data-kid=\"1-2-3-2-3-3-3\">\n                            Le commentaire suit le coup sélectionné dans la bande de lecture.\n                        </div>\n                    </div>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n    const tabs = Array.from(document.querySelectorAll('.optic-tab'));\n    const panels = Array.from(document.querySelectorAll('.tab-panel'));\n    tabs.forEach((tab) => tab.addEventListener('click', () => {\n      const target = tab.dataset.tab;\n      tabs.forEach((item) => { item.classList.toggle('active', item === tab); item.setAttribute('aria-selected', item === tab ? 'true' : 'false'); });\n      panels.forEach((panel) => { panel.classList.toggle('hidden', panel.dataset.panel !== target); });\n    }));\n    const moves = Array.from(document.querySelectorAll('.move'));\n    moves.forEach((move) => move.addEventListener('click', () => { moves.forEach((item) => item.classList.toggle('active', item === move)); }));\n  })();\n</script>\n",
