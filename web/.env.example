# Chemin du fichier SQLite, relatif à web/. Optionnel.
DATABASE_PATH=data/chess-trainer.db

# Coach LLM (étape 9). Laisser vide désactive complètement la fonctionnalité :
# l'application reste utilisable sans, avec des explications par règles.
ANTHROPIC_API_KEY=
COACH_ENABLED=false

# --- Authentification (Auth.js) ---------------------------------------------
# Secret de chiffrement des cookies : `npx auth secret` ou `openssl rand -base64 33`.
AUTH_SECRET=
# Identifiants OAuth Google (Google Cloud Console > API et services > Identifiants).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails administrateurs, séparés par des virgules (rôle relu à chaque connexion).
ADMIN_EMAILS=
# Mode d'inscription : open (défaut) ou allowlist.
SIGNUP_MODE=open
# En mode allowlist : emails autorisés à créer un compte (ADMIN_EMAILS l'est toujours).
ALLOWED_EMAILS=
# Connexion de test sans Google : 1 pour l'activer, SEULEMENT avec `next dev`.
DEV_LOGIN=
# Email qui hérite, à sa première connexion, des données de l'époque mono-utilisateur.
LEGACY_CLAIM_EMAIL=
