1... e5 { [%txt "La réponse symétrique."] [%eval 0.27] }
2. Nf3 { [%txt "Le cavalier attaque e5."] [%eval 0.34] [%cal Gf3e5] }
2... Nc6 { [%txt "Le cavalier défend e5."] [%eval 0.31] }
