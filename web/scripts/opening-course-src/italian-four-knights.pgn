10. Qxd4 { [%txt "La dame reprend le pion au centre."] [%eval -0.17] [%csl Gd4] }
10... O-O { [%txt "Le roi noir à l'abri."] [%eval -0.16] }
11. Be3 { [%txt "Le fou se développe et prépare le grand roque."] [%eval -0.18] [%cal Ge1c1] }
